# Redirections depuis les anciennes URL du site Wix.
#
# Google a indexé ces adresses depuis des années, et elles circulent dans des
# mails, des publications et des documents. Sans ces règles, chacune devient
# une 404 le jour où le domaine bascule sur ce site.
#
# Établies à partir de pages-sitemap.xml du site Wix, le 21 août 2026.

# ---- Fiches formation : elles vivent désormais sous /formations/ ----
/psc                    /formations/psc            301
/pse-1                  /formations/pse-1          301
/pse-2                  /formations/pse-2          301
/bnssa                  /formations/ssa            301
# Le diplôme a été renommé le 1er octobre 2026. L'ancienne adresse est notre
# meilleure page dans Google : cette redirection porte son référencement vers
# la nouvelle. Ne pas la supprimer.
/formations/bnssa       /formations/ssa            301
/fc-bnssa               /formations/fc-bnssa       301
/bsb-et-fc-bsb          /formations/bsb            301
/fc-pse1-ou-pse2        /formations/fc-pse-1       301
/sst-ou-mac-sst         /formations/sst            301
/pae-f-psc              /formations/pae-f-psc      301
/pae-f-ps               /formations/pae-f-ps       301
/pae-f-ps-ou-fo-ps      /formations/pae-f-ps       301

# ---- Anciennes adresses encore visitées depuis Google ----
# Relevées dans la Search Console le 21 septembre 2026 (3 derniers mois) :
# elles tombaient sur la page 404. « /psc-1 » à elle seule y amenait près de
# 200 visiteurs par trimestre.
/psc-1                                               /formations/psc              301
/bnssa/*                                             /formations/ssa              301
/formations-secourisme-nice/formation-psc-nice       /formations/psc              301
/formations-secourisme-nice/formation-pse1-nice      /formations/pse-1            301
/formations-secourisme-nice/formation-pse2-nice      /formations/pse-2            301
/formations-secourisme-nice/formation-bnssa-nice     /formations/ssa              301
/formations-secourisme-nice/fc-pse1-pse2-nice        /formations/fc-pse-1         301
/formations-secourisme-nice/postes-de-secours-nice   /postes-de-secours/nice      301
/perte-de-connaissance                               /gestes-qui-sauvent/perte-de-connaissance  301
/validite-reactualisation                            /validite-recyclage          301
/sport-adapte                                        /sauvetage-sportif           301

# ---- Pages renommées ----
/formateur                  /devenir-formateur   301
/copie-de-sauvetage-sportif /sauvetage-sportif   301

# ---- Billetterie : elle reste chez Wix, sur son sous-domaine ----
# ⚠️ Ne prend effet qu'une fois « reservation » défini comme domaine principal
# du site Wix. Dans l'autre ordre, Wix renvoie vers www et la boucle se ferme.
/event-details/*  https://reservation.secourismepourtous.org/event-details/:splat  301

# ---- Adresses que les robots demandent par convention ----
# Google signalait un 404 dans son rapport de couverture. « /sitemap.xml » est
# le nom que cherchent la plupart des explorateurs ; le nôtre s'appelle
# « sitemap-index.xml », engendré par Astro. Le favicon ICO est réclamé par
# quelques robots anciens, même quand la page déclare ses icônes en PNG.
/sitemap.xml   /sitemap-index.xml   301
/favicon.ico   /favicon-32.png      301
