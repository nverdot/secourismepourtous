# En-têtes de cache pour Cloudflare Pages — équivalent des règles de netlify.toml.
# Les dates de formation sont figées au build : sans cache court, un visiteur
# pourrait voir un planning périmé après une régénération.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Fichiers versionnés par Astro : leur nom change à chaque modification.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

/video/*
  Cache-Control: public, max-age=604800

/documents/*
  Cache-Control: public, max-age=86400
