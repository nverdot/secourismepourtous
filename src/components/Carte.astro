---
import { asso } from '../data/association';

/**
 * Plan d'accès.
 *
 * La carte vient d'OpenStreetMap et non de Google : elle s'affiche
 * immédiatement, sans clic préalable ni bandeau de consentement, parce qu'elle
 * ne dépose aucun traceur. Une carte Google intégrée aurait obligé à demander
 * l'accord du visiteur avant de l'afficher — une friction sur la page même où
 * l'on cherche à être trouvé.
 *
 * Les liens Google restent là, en sortie : l'itinéraire et la fiche d'avis
 * sont meilleurs chez eux, et un lien ne trace personne tant qu'on ne clique
 * pas dessus.
 */

const { adresse, codePostal, ville, latitude, longitude } = asso.contact;
const ADRESSE = `${adresse}, ${codePostal} ${ville}`;

// Cadrage : environ 600 m de côté autour du point.
const d = 0.004;
const OSM = `https://www.openstreetmap.org/export/embed.html?bbox=${longitude - d}%2C${latitude - d / 1.6}%2C${longitude + d}%2C${latitude + d / 1.6}&layer=mapnik&marker=${latitude}%2C${longitude}`;
const OSM_GRAND = `https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=17/${latitude}/${longitude}`;

const ITINERAIRE = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(ADRESSE)}`;
const FICHE = 'https://maps.app.goo.gl/yjoC7qbZCdGSKyXeA';
---

<section class="plan" aria-labelledby="t-plan">
  <h2 class="plan__h" id="t-plan">Nous trouver</h2>

  <div class="plan__cadre">
    <iframe
      src={OSM}
      title={`Plan d’accès à ${asso.nom}, ${ADRESSE}`}
      loading="lazy"
      referrerpolicy="no-referrer"
    ></iframe>
  </div>

  <p class="plan__source">
    <span>{ADRESSE}</span>
    <a href={OSM_GRAND} target="_blank" rel="noopener">Agrandir le plan</a>
  </p>

  <div class="plan__liens">
    <a class="btn btn--primaire" href={ITINERAIRE} target="_blank" rel="noopener">
      Calculer mon itinéraire
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
    <a class="btn btn--sobre" href={FICHE} target="_blank" rel="noopener">
      Voir la fiche Google
    </a>
  </div>
</section>

<style>
  .plan__h { font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; }

  .plan__cadre {
    position: relative; overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--sunk); border: 1px solid var(--line); border-radius: var(--r-lg);
  }
  @media (max-width: 620px) { .plan__cadre { aspect-ratio: 4 / 3; } }
  .plan__cadre iframe {
    position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
  }

  .plan__source {
    display: flex; flex-wrap: wrap; gap: .25rem .6rem;
    margin-top: .6rem; font-size: .84rem; color: var(--ink-mute);
  }
  .plan__source span { font-weight: 600; color: var(--ink-soft); }
  .plan__source a { color: var(--azur); }

  .plan__liens { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1rem; }
  .plan__liens .btn { font-size: .92rem; padding: .7rem 1.15rem; }
</style>
