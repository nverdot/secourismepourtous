---
/**
 * Documents de référence de l'organisme.
 *
 * Le livret d'accueil et le catalogue sont des pièces attendues au titre de
 * Qualiopi (information du public). Les afficher en évidence sert autant le
 * stagiaire que l'auditeur.
 */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const docs = [
  {
    nom: "Livret d'accueil du stagiaire",
    texte: "Déroulement, règlement intérieur, accessibilité et vos droits pendant la formation.",
    fichier: '/documents/livret-accueil-stagiaire.pdf',
  },
  {
    nom: 'Catalogue des formations',
    texte: "L'ensemble de nos formations, leurs objectifs, prérequis et modalités.",
    fichier: '/documents/catalogue-formations.pdf',
  },
  {
    nom: 'Certificat Qualiopi',
    texte: 'Certificat QUA009665, valide jusqu’au 29 novembre 2027 — actions de formation.',
    fichier: '/documents/certificat-qualiopi.pdf',
  },
  {
    nom: 'Conditions générales de vente',
    texte: "Inscription, tarifs, règlement, annulation et données personnelles.",
    lien: '/cgv',
  },
];
---

<section class:list={['docs', { 'docs--compact': compact }]} aria-labelledby="t-docs">
  {!compact && (
    <>
      <p class="eyebrow">À télécharger</p>
      <h2 class="h-section" id="t-docs">Nos documents de référence</h2>
    </>
  )}
  {compact && <h2 class="docs__h" id="t-docs">Documents utiles</h2>}

  <ul class="docs__l">
    {docs.map((d) => (
      <li>
        <a href={d.fichier ?? d.lien} download={d.fichier ? '' : undefined}
           target={d.fichier ? '_blank' : undefined} rel={d.fichier ? 'noopener' : undefined}>
          <span class="docs__ic" aria-hidden="true">
            {d.fichier ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="M7 10l5 5 5-5M12 15V3" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M16 13H8M16 17H8" />
              </svg>
            )}
          </span>
          <span class="docs__txt">
            <strong>{d.nom}</strong>
            <span>{d.texte}</span>
          </span>
          <span class="docs__fmt">{d.fichier ? 'PDF' : 'Web'}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .docs__h { font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; }
  .docs__l {
    list-style: none; margin: 1.75rem 0 0; padding: 0;
    display: grid; gap: .7rem;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }
  .docs--compact .docs__l { margin-top: 0; grid-template-columns: 1fr; }

  .docs__l a {
    display: flex; align-items: center; gap: .95rem;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: 1rem 1.15rem;
    text-decoration: none; color: inherit; height: 100%;
    transition: border-color .16s ease, transform .16s ease;
  }
  .docs__l a:hover { border-color: var(--accent); transform: translateY(-2px); }

  .docs__ic {
    flex: none; width: 40px; height: 40px; border-radius: 11px;
    background: var(--accent-wash); color: var(--accent);
    display: grid; place-items: center;
  }
  .docs__ic svg { width: 19px; height: 19px; }

  .docs__txt { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .docs__txt strong { font-family: 'Archivo', sans-serif; font-size: .96rem; }
  .docs__txt span { font-size: .84rem; color: var(--ink-mute); }

  .docs__fmt {
    flex: none; font-family: 'Archivo', sans-serif;
    font-size: .66rem; font-weight: 700; letter-spacing: .08em;
    color: var(--ink-mute); background: var(--sunk);
    border-radius: var(--r-sm); padding: .25rem .5rem;
  }
</style>
