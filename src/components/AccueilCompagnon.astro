---
/**
 * L'accueil du Compagnon, posé dans la page d'accueil du téléphone.
 *
 * Il ouvrait autrefois le Compagnon en plein écran à l'arrivée. Google
 * pénalise les fenêtres qui masquent le contenu juste après l'arrivée
 * (« interstitiels intrusifs ») : le même premier écran — la bulle, le
 * personnage, les choix — est donc désormais un bloc de la page, que tout le
 * monde voit, visiteurs venus de Google compris, et qui ne cache rien.
 *
 * Version compacte, en « message » : le personnage debout, une bulle claire — le
 * titre de la page reste le seul bloc sombre, la hiérarchie se lit d'un coup
 * d'œil — et les trois premiers choix du Compagnon (src/data/compagnon.ts),
 * plus « Autre chose… » qui ouvre le Compagnon complet. Un choix qui pose une
 * nouvelle question ouvre le Compagnon sur cet écran : c'est alors le
 * visiteur qui l'a demandé.
 *
 * Absent sur ordinateur, où le Compagnon reste le lanceur du coin de l'écran.
 */
import { ICONES, PLEINES, ECRANS } from '../data/compagnon';

const accueil = ECRANS[0];
const principaux = accueil.actions.slice(0, 3);
---

<section class="acp" aria-labelledby="acp-titre">
  <div class="acp__dialogue">
    {/* Le personnage debout, en entier : l'homme ou la femme tiré au sort pour
        la visite (voir Base.astro). */}
    <img class="acp__perso" src="/compagnon/debout.webp" width="324" height="360" alt="" decoding="async" />
    <script is:inline>
      if (document.documentElement.dataset.compagnon === 'femme') {
        var i = document.currentScript.previousElementSibling;
        i.src = '/compagnon/femme/debout.webp';
        i.width = 360;
      }
    </script>
    <div class="acp__bulle">
      <h2 class="acp__titre" id="acp-titre">{accueil.titre}</h2>
      {/* Le texte est dans le HTML : Google le lit, et il s'affiche sans script.
          Le script ne fait que le rejouer lettre à lettre. */}
      <p class="acp__message" data-frappe>{accueil.message}</p>
    </div>
  </div>

  <div class="acp__choix">
    {principaux.map((a, i) => {
      const contenu = (
        <>
          <span class="acp__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18"
                 fill={PLEINES.has(a.icone) ? 'currentColor' : 'none'}
                 stroke={PLEINES.has(a.icone) ? 'none' : 'currentColor'}
                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d={ICONES[a.icone]} />
            </svg>
          </span>
          <span class="acp__t">{a.texte}</span>
          <svg class="acp__chev" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
               fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </>
      );
      const classes = ['acp__c', { 'acp__c--premier': i === 0 }];
      return a.vers
        ? <a class:list={classes} href={a.vers}>{contenu}</a>
        : <button type="button" class:list={classes} data-ecran={a.ecran}>{contenu}</button>;
    })}
    <button type="button" class="acp__autre" data-ecran="accueil">
      Autre chose… bénévolat, sauvetage sportif, don, urgence
    </button>
  </div>
</section>

<script>
  const bloc = document.querySelector<HTMLElement>('.acp');
  if (bloc) {
    /* Un choix qui pose une nouvelle question : le Compagnon s'ouvre sur cet
       écran-là, la conversation continue. */
    bloc.querySelectorAll<HTMLButtonElement>('[data-ecran]').forEach((b) =>
      b.addEventListener('click', () => {
        const c = (window as any).Compagnon;
        if (!c) return;
        c.ouvrir();
        c.afficher(b.dataset.ecran, true);
      })
    );

    /* La réplique s'écrit lettre à lettre, comme dans le Compagnon. Le texte
       entier reste lu par les lecteurs d'écran ; rien ne bouge pour qui a
       demandé à limiter les animations ; et sur ordinateur, où le bloc est
       masqué, on ne fait rien. */
    const message = bloc.querySelector<HTMLElement>('[data-frappe]');
    const etroit = matchMedia('(max-width: 720px)').matches;
    const sobre = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (message && etroit && !sobre) {
      const texte = message.textContent || '';
      const lu = document.createElement('span');
      lu.className = 'vh';
      lu.textContent = texte;
      const vu = document.createElement('span');
      vu.setAttribute('aria-hidden', 'true');
      const ecrit = document.createElement('span');
      ecrit.className = 'acp__frappe';
      const reste = document.createElement('span');
      reste.className = 'acp__reste';
      reste.textContent = texte;
      vu.append(ecrit, reste);
      message.replaceChildren(lu, vu);

      let i = 0;
      let minuterie = 0;
      const finir = () => {
        clearTimeout(minuterie);
        ecrit.textContent = texte;
        reste.textContent = '';
        ecrit.classList.add('est-fini');
      };
      const pas = () => {
        i += 1;
        ecrit.textContent = texte.slice(0, i);
        reste.textContent = texte.slice(i);
        if (i >= texte.length) return finir();
        const c = texte[i - 1];
        minuterie = window.setTimeout(pas, '.?!…'.includes(c) ? 260 : ',:;'.includes(c) ? 130 : 28);
      };
      message.addEventListener('click', finir);
      minuterie = window.setTimeout(pas, 400);
    }
  }
</script>

<style>
  .acp { display: none; }

  @media (max-width: 720px) {
    .acp { display: block; padding: 1.2rem var(--pad) 0.4rem; }

    /* Le Compagnon « écrit » au visiteur : avatar à gauche, bulle claire à
       droite. Claire exprès — sombre, elle se confondait avec le bandeau du
       titre juste au-dessus, et les deux blocs se lisaient au même niveau. */
    /* Le personnage se tient en bas, derrière le premier choix ; la bulle
       reste en haut, à hauteur de sa tête. Centré, il laissait un vide entre
       ses pieds et le premier bouton. */
    .acp__dialogue {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: 0.4rem;
    }
    /* Seul le personnage déborde sous le premier choix (marge basse
       négative) : la bulle, elle, garde son espace au-dessus des boutons. */
    .acp__perso {
      align-self: end;
      margin-bottom: -1.1rem;
      width: auto;
      height: 185px;
      max-width: 38vw;
      object-fit: contain;
      object-position: bottom;
      filter: drop-shadow(0 10px 14px rgba(7, 23, 38, 0.14));
    }
    .acp__bulle {
      position: relative;
      padding: 0.75rem 0.9rem 0.8rem;
      border: 1px solid var(--line);
      border-radius: 18px 18px 18px 18px;
      background: var(--surface);
      box-shadow: 0 6px 18px rgba(7, 23, 38, 0.07);
    }
    .acp__bulle::before {
      position: absolute;
      top: 1.4rem;
      right: 100%;
      width: 12px;
      height: 12px;
      border: 1px solid var(--line);
      border-width: 0 0 1px 1px;
      background: var(--surface);
      content: '';
      translate: 7px 0;
      rotate: 45deg;
    }
    .acp__titre {
      margin: 0 0 0.15rem;
      color: var(--navy-deep);
      font-size: 1.1rem;
      font-weight: 800;
      line-height: 1.2;
    }
    .acp__message { margin: 0; color: var(--ink-soft); font-size: 0.92rem; line-height: 1.45; }
    :global(.acp__reste) { color: transparent; }
    :global(.acp__frappe:not(.est-fini))::after {
      position: absolute;
      margin-left: 1px;
      content: '▍';
      animation: acp-curseur 0.8s steps(1) infinite;
    }
    @keyframes acp-curseur { 50% { opacity: 0; } }

    /* Les choix, alignés sous la bulle, comme des réponses proposées. */
    .acp__choix {
      display: grid;
      gap: 0.45rem;
      position: relative;
      z-index: 1;
      margin-top: 0.55rem;
    }
    .acp__c {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.6rem;
      width: 100%;
      min-height: 50px;
      padding: 0.45rem 0.65rem;
      border: 1px solid #d8e3ea;
      border-radius: 14px;
      background: var(--surface);
      color: var(--ink);
      font: 700 0.9rem/1.25 'Archivo', sans-serif;
      text-align: left;
      text-decoration: none;
      cursor: pointer;
    }
    .acp__ic {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: var(--secours-wash);
      color: var(--secours);
    }
    .acp__chev { color: var(--ink-mute); }
    .acp__c--premier { border-color: transparent; background: var(--secours); color: #fff; }
    .acp__c--premier .acp__ic { background: rgba(255, 255, 255, 0.16); color: #fff; }
    .acp__c--premier .acp__chev { color: #fff; }

    .acp__autre {
      justify-self: start;
      min-height: 40px;
      padding: 0.3rem 0.1rem;
      border: 0;
      background: none;
      color: var(--azur);
      font: 700 0.85rem 'Archivo', sans-serif;
      text-align: left;
      cursor: pointer;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.acp__frappe)::after { display: none; }
  }
</style>
