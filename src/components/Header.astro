---
import { asso } from '../data/association';
import { filieres, formations } from '../data/formations';

/**
 * Raccourcis du menu mobile : une entrée par filière, avec le sigle des
 * formations qu'elle contient. Le visiteur qui cherche « PSE1 » n'a plus à
 * ouvrir la page catalogue puis à chercher dedans.
 */
const raccourcis = Object.entries(filieres).map(([cle, f]) => ({
  cle,
  nom: f.titre,
  couleur: f.couleur,
  icone: f.icone,
  sigles: formations
    .filter((x) => x.filiere === cle && !x.estRecyclage)
    .map((x) => x.sigle),
}));

const liens = [
  { href: '/formations', texte: 'Formations' },
  { href: '/gestes-qui-sauvent', texte: 'Gestes qui sauvent' },
  { href: '/postes-de-secours', texte: 'Postes de secours' },
  { href: '/sauvetage-sportif', texte: 'Sauvetage sportif' },
  { href: '/qui-sommes-nous', texte: 'Qui sommes-nous' },
  { href: '/contact', texte: 'Contact' },
];

const actuel = Astro.url.pathname;
---

<header class="entete">
  <!--
    Bandeau de contact. Le téléphone y est accessible en un geste, y compris
    depuis un mobile en situation d'urgence ou de demande de devis.

    L'adresse y figure en toutes lettres, dès la première page : c'est ce que
    cherche un visiteur qui vient se former, et c'est aussi le signal que Google
    recoupe avec la fiche d'établissement pour rattacher l'organisme à Nice.
    Elle doit rester identique, au caractère près, à celle de la fiche Google.
  -->
  <div class="entete__bandeau">
    <div class="wrap entete__bandeau-in">
      <span class="entete__labels">Affiliée FFSS · Agréée sécurité civile · Certifiée Qualiopi</span>
      <span class="entete__lieu">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" />
        </svg>
        {asso.contact.adresse}, {asso.contact.codePostal} {asso.contact.ville}
      </span>
      <a href={`tel:${asso.contact.telephoneLien}`} class="entete__tel">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        {asso.contact.telephone}
      </a>
    </div>
  </div>

  <div class="wrap entete__barre">
    <a href="/" class="marque" aria-label={`${asso.nom} — accueil`}>
      <img class="marque__logo" src="/img/logo-spt.png" alt="" width="44" height="52" />
      <span class="marque__mots">
        <strong>Secourisme</strong>
        <em>Pour Tous</em>
      </span>
    </a>

    <img class="entete__ffss" src="/img/logo-ffss.png"
         alt="Association affiliée à la Fédération Française de Sauvetage et de Secourisme"
         width="52" height="52" />

    <nav class="nav" aria-label="Navigation principale">
      {liens.map((l) => (
        <a
          href={l.href}
          class:list={['nav__lien', { 'est-actif': actuel === l.href || actuel.startsWith(l.href + '/') }]}
          aria-current={actuel === l.href ? 'page' : undefined}
        >
          {l.texte}
        </a>
      ))}
    </nav>

    <a href="/secouriste-actif" class="btn btn--primaire entete__cta">S'engager</a>

    <!-- Ouverture du menu en mobile, sans JavaScript : une case à cocher
         masquée pilote l'affichage. Le site reste fonctionnel si le script
         d'un tiers échoue. -->
    <input type="checkbox" id="menu-mobile" class="vh entete__bascule" />
    <label for="menu-mobile" class="entete__burger" aria-label="Ouvrir le menu">
      <span></span><span></span><span></span>
    </label>
    <nav class="nav-mobile" aria-label="Navigation mobile">
      <!-- « Formations » se déplie sur les cinq filières : c'est l'entrée la
           plus demandée, et la seule qui cache un catalogue derrière elle. -->
      <details class="sm">
        <summary>
          Formations
          <svg class="sm__fleche" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="sm__liste">
          {raccourcis.map((r) => (
            <a class={`sm__lien sm__lien--${r.couleur}`} href={`/formations#${r.cle}`}>
              <span class="sm__ic" aria-hidden="true">
                {r.icone === 'coeur' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-6 4 12 2-6h6" /></svg>}
                {r.icone === 'ambulance' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7.5A1.5 1.5 0 0 1 3.5 6h9A1.5 1.5 0 0 1 14 7.5V17H2z" /><path d="M14 10h3.6a2 2 0 0 1 1.6.8l2.2 2.9a2 2 0 0 1 .4 1.2V17h-8z" /><path d="M6 9.5v4M4 11.5h4" /><circle cx="7.5" cy="18.5" r="1.8" /><circle cx="17.5" cy="18.5" r="1.8" /><path d="M9.3 18.5h6.4" /></svg>}
                {r.icone === 'nage' && <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="8.2" cy="7.4" r="2.3" /><path d="M12.1 10.4a1.35 1.35 0 0 1-.15-1.9l3.05-3.4a1.35 1.35 0 1 1 2.01 1.8l-3.05 3.4a1.35 1.35 0 0 1-1.86.1z" /><path d="M3.1 13.5a1.3 1.3 0 0 1 .5-1.77l2.62-1.5a4.2 4.2 0 0 1 4.32.06l4.3 2.7a1.3 1.3 0 0 1-1.38 2.2l-4.3-2.7a1.6 1.6 0 0 0-1.65-.02l-2.62 1.5a1.3 1.3 0 0 1-1.79-.47z" /><path d="M2 17.5c1.5 0 2.05-1.05 3.55-1.05S7.6 17.5 9.1 17.5s2.05-1.05 3.55-1.05 2.05 1.05 3.55 1.05 2.05-1.05 3.3-1.05v2.3c-1.25 0-1.8 1.05-3.3 1.05s-2.05-1.05-3.55-1.05-2.05 1.05-3.55 1.05-2.05-1.05-3.55-1.05S3.5 19.8 2 19.8z" /></svg>}
                {r.icone === 'pedagogie' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>}
                {r.icone === 'mallette' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>}
              </span>
              <span class="sm__txt">
                <strong>{r.nom}</strong>
                <em>{r.sigles.join(' · ')}</em>
              </span>
            </a>
          ))}
          <a class="sm__tout" href="/formations">Voir tout le catalogue</a>
        </div>
      </details>
      {liens.filter((l) => l.href !== '/formations').map((l) => <a href={l.href}>{l.texte}</a>)}
      <a href={`tel:${asso.contact.telephoneLien}`} class="nav-mobile__tel">{asso.contact.telephone}</a>
    </nav>
  </div>
</header>

<script>
  /**
   * Un lien vers une ancre de la page courante ne recharge rien : sans ce
   * script, le panneau mobile restait ouvert par-dessus la section vers
   * laquelle on venait de naviguer.
   */
  const bascule = document.getElementById('menu-mobile');
  const refermeMenu = () => { if (bascule) bascule.checked = false; };

  document.querySelectorAll('.nav-mobile a').forEach((a) =>
    a.addEventListener('click', refermeMenu)
  );
  addEventListener('hashchange', refermeMenu);
  // Échap referme aussi, comme n'importe quelle surcouche.
  addEventListener('keydown', (e) => { if (e.key === 'Escape') refermeMenu(); });
</script>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .entete__bandeau {
    background: var(--navy-deep);
    color: var(--on-navy-soft);
    font-size: 0.78rem;
  }
  .entete__bandeau-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
  }
  .entete__bandeau-in > span { min-width: 0; }
  .entete__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .entete__tel:hover { color: var(--secours-hi); }

  .entete__barre {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .marque {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .marque__logo { width: auto; height: 46px; object-fit: contain; flex: none; }
  .marque__mots {
    display: flex;
    flex-direction: column;
    font-family: 'Archivo', sans-serif;
    line-height: 1.05;
  }
  .marque__mots strong { font-size: 1.02rem; font-weight: 800; letter-spacing: -0.02em; }
  .marque__mots em {
    font-style: normal;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--secours);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Séparé de la marque par un filet : c'est un agrément, pas un co-logo. */
  .entete__ffss {
    height: 52px; width: auto; flex: none;
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }
  /* L'agrément fait partie de l'identité : il reste visible sur mobile,
     simplement réduit et sans le filet qui mangerait la largeur. */
  @media (max-width: 480px) {
    .entete__ffss { height: 40px; padding-left: .7rem; }
  }
  @media (max-width: 360px) {
    .entete__ffss { height: 34px; padding-left: .55rem; }
  }

  .nav { display: flex; gap: 0.35rem; margin-left: auto; }
  .nav__lien {
    font-family: 'Archivo', sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.5rem 0.8rem;
    border-radius: var(--r-sm);
    white-space: nowrap;
  }
  .nav__lien:hover { background: var(--sunk); color: var(--ink); }
  .nav__lien.est-actif { color: var(--secours); }

  .entete__cta { padding: 0.65rem 1.3rem; font-size: 0.92rem; flex: none; }

  /* --- mobile --- */
  .entete__burger { display: none; }
  .nav-mobile { display: none; }

  @media (max-width: 1000px) {
    .nav, .entete__cta { display: none; }

    .entete__burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      margin-left: auto;
      width: 42px; height: 42px;
      padding: 0 9px;
      border-radius: var(--r-sm);
      cursor: pointer;
      background: var(--sunk);
    }
    .entete__burger span {
      display: block;
      height: 2px;
      background: var(--ink);
      border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .entete__bascule:focus-visible + .entete__burger { outline: 3px solid var(--azur); outline-offset: 2px; }

    .nav-mobile {
      display: none;
      flex-direction: column;
      width: 100%;
      order: 10;
      padding-top: 0.75rem;
      border-top: 1px solid var(--line);
      margin-top: 0.75rem;
    }
    .entete__bascule:checked ~ .nav-mobile { display: flex; }
    .entete__bascule:checked + .entete__burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .entete__bascule:checked + .entete__burger span:nth-child(2) { opacity: 0; }
    .entete__bascule:checked + .entete__burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .nav-mobile a {
      font-family: 'Archivo', sans-serif;
      font-weight: 600;
      color: var(--ink);
      text-decoration: none;
      padding: 0.85rem 0.25rem;
      border-bottom: 1px solid var(--line);
    }
    .nav-mobile a:last-child { border-bottom: 0; }
    .nav-mobile__tel { color: var(--secours) !important; }

    /* --- sous-menu des filières --- */
    .sm { border-bottom: 1px solid var(--line); }
    .sm summary {
      display: flex; align-items: center; justify-content: space-between;
      list-style: none; cursor: pointer;
      font-family: 'Archivo', sans-serif; font-weight: 600; color: var(--ink);
      padding: 0.85rem 0.25rem;
    }
    .sm summary::-webkit-details-marker { display: none; }
    .sm__fleche { width: 18px; height: 18px; transition: transform .18s; color: var(--ink-mute); }
    .sm[open] .sm__fleche { transform: rotate(180deg); }

    .sm__liste { display: flex; flex-direction: column; gap: .4rem; padding: 0 0 .85rem; }
    .sm__lien {
      display: flex; align-items: center; gap: .7rem;
      padding: .6rem .7rem !important; border-bottom: 0 !important;
      background: var(--sunk); border-radius: var(--r-sm);
    }
    .sm__ic {
      flex: none; width: 34px; height: 34px; border-radius: 10px;
      display: grid; place-items: center; color: #fff;
    }
    .sm__ic svg { width: 18px; height: 18px; }
    .sm__lien--azur .sm__ic { background: var(--azur); }
    .sm__lien--secours .sm__ic { background: var(--secours); }
    .sm__lien--ocean .sm__ic { background: var(--ocean, #0e7490); }
    .sm__lien--ocre .sm__ic { background: var(--gold); }
    .sm__lien--navy .sm__ic { background: var(--navy); }
    .sm__txt { display: flex; flex-direction: column; gap: .05rem; min-width: 0; }
    .sm__txt strong { font-size: .92rem; font-weight: 700; }
    .sm__txt em {
      font-style: normal; font-size: .78rem; font-weight: 400; color: var(--ink-mute);
    }
    .sm__tout {
      padding: .6rem .7rem !important; border-bottom: 0 !important;
      font-size: .88rem; color: var(--azur) !important;
    }

    .entete__barre { flex-wrap: wrap; }
  }

  .entete__lieu {
    display: inline-flex; align-items: center; gap: .35rem;
    margin-left: auto; margin-right: 1.1rem;
  }
  .entete__lieu svg { flex: none; opacity: .7; }

  /* En s'étrécissant, le bandeau abandonne d'abord les labels, puis l'adresse :
     le téléphone est ce qui doit survivre jusqu'au bout. */
  @media (max-width: 1080px) { .entete__labels { display: none; } }
  @media (max-width: 720px) {
    .entete__lieu { display: none; }
    .entete__bandeau-in { justify-content: flex-end; }
  }
</style>
