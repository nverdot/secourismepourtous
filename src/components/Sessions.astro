---
import type { Session } from '../lib/wix';
import { formatJour, formatNumero, formatMois, formatAnnee, formatHeure } from '../lib/wix';
import { asso } from '../data/association';
import { formations } from '../data/formations';
import { cursusPour } from '../lib/cursus';

interface Props {
  sessions: Session[];
  sigle: string;
}
const { sessions, sigle } = Astro.props;

// Certaines formations vendent un forfait qu'on ne montre pas ici (voir formations.ts).
const fiche = formations.find((f) => f.sigle === sigle);
const masques = fiche?.billetsMasques ?? [];
// Le cursus d'une autre formation qui commence par celle-ci (SSA sur le PSE1).
const cursus = await cursusPour(fiche?.slug);
const entreprise = Boolean(fiche?.entreprise);

// Au-delà de 12 dates la liste devient illisible ; le lien vers l'agenda prend le relais.
const visibles = sessions.slice(0, 12);
const reste = sessions.length - visibles.length;
---

<section class="sessions" id="sessions" aria-labelledby="t-sessions">
  <div class="wrap">
    <div class="sessions__tete">
      <div>
        <p class="eyebrow">{visibles.length > 0 ? 'Inscriptions ouvertes' : 'Dates sur demande'}</p>
        <h2 class="h-section" id="t-sessions">Prochaines sessions {sigle}</h2>
      </div>
      <p class="sessions__lieu">
        {fiche?.lieuSessions ?? `${asso.contact.adresse}, ${asso.contact.ville}`}
      </p>
    </div>

    {visibles.length > 0 && fiche?.noteSessions && (
      <p class="sessions__note">{fiche.noteSessions}</p>
    )}

    {visibles.length > 0 ? (
      <>
        <ul class="sessions__grille">
          {cursus && (
            <li class="sessions__cursus">
              <button type="button" class="cursus" data-inscription
                  data-event-id={cursus.session.id}
                  data-slug={cursus.session.slug}
                  data-champs={JSON.stringify(cursus.session.champs ?? [])}
                  data-masquer={JSON.stringify(cursus.billetsMasques)}
                  data-url={cursus.session.urlInscription ?? ''}
                  data-libelle={cursus.libelle}>
                <span class="cursus__txt">
                  <span class="cursus__eyebrow">Vous visez le SSA ?</span>
                  <strong class="cursus__titre">{cursus.libelle} — {cursus.tarif}</strong>
                  <span class="cursus__detail">{cursus.detail}</span>
                </span>
                <span class="cursus__cta">S’inscrire au cursus <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
              </button>
            </li>
          )}
          {visibles.map((s) => (
            <li>
              <button type="button" class="sess" data-inscription
                      data-event-id={s.id}
                  data-slug={s.slug}
                  data-champs={JSON.stringify(s.champs ?? [])}
                  data-masquer={JSON.stringify(masques)}
                      data-url={s.urlInscription ?? ''}
                      data-libelle={`${sigle} — ${formatJour(s.debut)} ${formatNumero(s.debut)} ${formatMois(s.debut)} ${formatAnnee(s.debut)}`}>
                <span class="sess__date">
                  <span class="sess__num">{formatNumero(s.debut)}</span>
                  <span class="sess__mois">{formatMois(s.debut)}</span>
                </span>
                <span class="sess__info">
                  <strong>{formatJour(s.debut)}</strong>
                  <span>{formatHeure(s.debut)} · {formatAnnee(s.debut)}</span>
                  {s.lieu && <span class="sess__lieu">{s.lieu}</span>}
                </span>
                <span class="sess__cta" aria-hidden="true">S'inscrire</span>
              </button>
            </li>
          ))}
        </ul>
        {reste > 0 && (
          <p class="sessions__reste">
            {reste} autre{reste > 1 ? 's' : ''} session{reste > 1 ? 's' : ''} programmée{reste > 1 ? 's' : ''} —
            <a href="/contact">nous consulter</a>
          </p>
        )}
      </>
    ) : (
      <div class="sessions__vide">
        <p>
          Aucune date n'est publiée pour le moment. Contactez-nous : nous
          programmons régulièrement de nouvelles sessions et pouvons organiser
          une formation sur mesure pour votre groupe ou votre entreprise.
        </p>
        <a class="btn btn--primaire" href={entreprise ? `/contact?motif=entreprise&formation=${encodeURIComponent(sigle)}` : '/contact'}>
          {entreprise ? 'Demander un devis' : 'Nous contacter'}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  /* Fond blanc : la section précédente (témoignages) est déjà en gris clair.
   Deux gris qui se suivent effacent la séparation et gonflent l'espace perçu. */
  .sessions { background: var(--surface); padding-block: var(--section-haut) var(--section); }

  .sessions__tete {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }
  .sessions__lieu { font-size: 0.9rem; color: var(--ink-mute); }
  .sessions__note {
    max-width: 68ch;
    margin: -0.5rem 0 1.5rem;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--accent);
    background: var(--sunk);
    border-radius: var(--r-sm);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* Le cursus SSA, sur le PSE1 et le PSE2 : une ligne entière, au-dessus des
     dates, pour qu'on ne la prenne pas pour une session de plus. */
  .sessions__cursus { grid-column: 1 / -1; }
  .cursus {
    width: 100%; font: inherit; color: inherit; text-align: left; cursor: pointer;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.9rem 1.5rem;
    background: var(--surface); border: 1px solid var(--line); border-left: 5px solid var(--secours);
    border-radius: var(--r-md); padding: 1.1rem 1.25rem;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .cursus:hover { border-color: var(--secours); box-shadow: var(--sh-sm); }
  .cursus__txt { display: flex; flex-direction: column; gap: 0.3rem; flex: 1 1 22rem; min-width: 0; }
  .cursus__eyebrow { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--secours); }
  .cursus__titre { font-family: 'Archivo', sans-serif; font-size: 1.15rem; font-weight: 800; line-height: 1.25; }
  .cursus__detail { font-size: 1rem; color: var(--ink-soft); line-height: 1.5; }
  .cursus__cta {
    flex: none; display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--secours); color: #fff; font-weight: 700;
    padding: 0.7rem 1.1rem; border-radius: 999px;
  }
  .cursus__cta svg { width: 16px; height: 16px; }

  .sessions__grille {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
  }

  .sess {
    width: 100%;
    border: 1px solid var(--line);
    font: inherit;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--surface);
    border-radius: var(--r-md);
    padding: 1rem 1.15rem;
    color: inherit;
    height: 100%;
    transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
  }
  .sess:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--sh-sm);
  }

  .sess__date {
    flex: none;
    width: 56px;
    text-align: center;
    border-right: 1px solid var(--line);
    padding-right: 0.9rem;
  }
  .sess__num {
    display: block;
    font-family: 'Archivo', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .sess__mois {
    display: block;
    font-family: 'Archivo', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .sess__info { min-width: 0; display: flex; flex-direction: column; }
  .sess__info strong { font-size: 0.95rem; font-weight: 600; text-transform: capitalize; }
  .sess__info span { font-size: 0.82rem; color: var(--ink-mute); }
  .sess__lieu {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sess__cta {
    margin-left: auto;
    flex: none;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent);
  }
  .sess:hover .sess__cta { text-decoration: underline; text-underline-offset: 3px; }

  .sessions__reste { margin-top: 1rem; font-size: 0.9rem; color: var(--ink-soft); }

  .sessions__vide {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    justify-content: space-between;
  }
  .sessions__vide p { max-width: 52ch; color: var(--ink-soft); }
</style>
