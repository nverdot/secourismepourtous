---
import { asso } from '../data/association';
import { formations } from '../data/formations';

// Les recyclages sont nombreux et ne concernent que d'anciens stagiaires :
// ils passent derrière un dépliant pour alléger le pied de page.
const principales = formations.filter((f) => !f.estRecyclage);
const recyclages = formations.filter((f) => f.estRecyclage);

const annee = 2026;
---

<footer class="pied">
  <div class="wrap pied__grille">
    <div class="pied__col pied__col--marque">
      <span class="pied__marque">
        <strong>Secourisme</strong> <em>Pour Tous</em>
      </span>
      <p class="pied__texte">
        Association affiliée à la FFSS, agréée sécurité civile et certifiée Qualiopi, implantée sur la Côte d'Azur
        depuis {asso.fondation}. Formation, postes de secours et sauvetage sportif.
      </p>
      <div class="pied__agrements">
        <img src="/img/logo-ffss.png" alt="Association affiliée à la Fédération Française de Sauvetage et de Secourisme" width="72" height="72" loading="lazy" />
        <a href="/documents/certificat-qualiopi.pdf" target="_blank" rel="noopener"
           title="Consulter notre certificat Qualiopi">
          <img src="/img/qualiopi.png" alt="Certifié Qualiopi — actions de formation" width="130" height="80" loading="lazy" />
        </a>
      </div>
      <p class="pied__qualiopi">
        La certification qualité a été délivrée au titre de la catégorie
        <strong>actions de formation</strong>.
      </p>
    </div>

    <div class="pied__col">
      <h2 class="pied__titre">Formations</h2>
      <!--
        Seize formations d'affilée rendaient le pied de page interminable.
        On montre les formations initiales, les recyclages tiennent derrière
        un dépliant natif : sans JavaScript, et tous les liens restent dans le
        HTML livré, donc toujours lisibles par les moteurs de recherche.
      -->
      <ul>
        {principales.map((f) => (
          <li><a href={`/formations/${f.slug}`}>{f.sigle} — {f.intitule}</a></li>
        ))}
      </ul>
      {recyclages.length > 0 && (
        <details class="pied__plus">
          <summary>Recyclages et formations continues ({recyclages.length})</summary>
          <ul>
            {recyclages.map((f) => (
              <li><a href={`/formations/${f.slug}`}>{f.sigle} — {f.intitule}</a></li>
            ))}
          </ul>
        </details>
      )}
      <ul class="pied__tout">
        <li><a href="/formations">Tout le catalogue</a></li>
        <li><a href="/ou-se-former">Où se former dans le 06</a></li>
        <li><a href="/gestes-qui-sauvent">Les gestes qui sauvent</a></li>
        <li><a href="/gestes-qui-sauvent/quiz">Tester mes réflexes</a></li>
        <li><a href="/premiers-secours-bebe-enfant">Premiers secours bébé et enfant</a></li>
      </ul>
    </div>

    <div class="pied__col">
      <h2 class="pied__titre">L'association</h2>
      <ul>
        <li><a href="/qui-sommes-nous">Qui sommes-nous</a></li>
        <li><a href="/secouriste-actif">Devenir secouriste actif</a></li>
        <li><a href="/devenir-formateur">Devenir formateur</a></li>
        <li><a href="/ecole-de-natation">École de natation et de sauvetage</a></li>
        <li><a href="/postes-de-secours">Postes de secours</a></li>
        <li><a href="/sauvetage-sportif">Sauvetage sportif</a></li>
        <li><a href="/financement">Financer ma formation</a></li>
        <li><a href="/contact">Nous contacter</a></li>
      </ul>
    </div>

    <div class="pied__col">
      <h2 class="pied__titre">Contact</h2>
      <address class="pied__adresse">
        {asso.contact.adresse}<br />
        {asso.contact.codePostal} {asso.contact.ville}
      </address>
      <ul>
        <li><a href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a></li>
        <li><a href={`mailto:${asso.contact.email}`}>{asso.contact.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap pied__bas">
    <span>© {annee} {asso.nom} — Tous droits réservés · RNA {asso.identifiants.rna}</span>
    <span class="pied__legal">
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/politique-de-confidentialite">Politique de confidentialité</a>
      <a href="/cgv">CGV</a>
      <a href="/documents/livret-accueil-stagiaire.pdf" target="_blank" rel="noopener">Livret d'accueil</a>
      <a href="/documents/catalogue-formations.pdf" target="_blank" rel="noopener">Catalogue</a>
    </span>
  </div>
</footer>

<style>
  .pied {
    background: var(--navy-deep);
    color: var(--on-navy-soft);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    font-size: 0.92rem;
  }

  .pied__grille {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    padding-bottom: 2.5rem;
  }
  @media (max-width: 900px) { .pied__grille { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .pied__grille { grid-template-columns: 1fr; } }

  .pied__marque {
    font-family: 'Archivo', sans-serif;
    font-size: 1.15rem;
    color: #fff;
    display: block;
    margin-bottom: 0.75rem;
  }
  .pied__marque strong { font-weight: 800; letter-spacing: -0.02em; }
  .pied__marque em {
    font-style: normal;
    color: var(--secours-hi);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
  }

  .pied__texte { max-width: 42ch; margin-bottom: 1.1rem; }

  /* Fond blanc obligatoire : les deux logos officiels sont conçus pour
     s'afficher sur blanc et deviennent illisibles sur le bleu nuit. */
  .pied__agrements {
    display: flex; flex-wrap: wrap; gap: 1.1rem; align-items: center;
    background: #fff; border-radius: var(--r-md);
    padding: 0.9rem 1.1rem; margin-bottom: 0.7rem;
    width: fit-content;
  }
  .pied__agrements img { height: 54px; width: auto; object-fit: contain; }
  .pied__qualiopi { font-size: 0.76rem; color: var(--on-navy-soft); max-width: 38ch; }
  .pied__qualiopi strong { color: #fff; }

  .pied__titre {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.9rem;
  }

  .pied__col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .pied__col a { color: var(--on-navy-soft); text-decoration: none; }
  .pied__col a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  .pied__adresse { font-style: normal; margin-bottom: 0.75rem; }

  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.82rem;
  }
  .pied__legal { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .pied__legal a { color: var(--on-navy-soft); text-decoration: none; }
  .pied__legal a:hover { color: #fff; }

  .pied__plus { margin-top: .55rem; }
  .pied__plus summary {
    cursor: pointer; list-style: none;
    font-size: .85rem; font-weight: 600; color: var(--on-navy-soft);
    padding: .3rem 0; display: flex; align-items: center; gap: .4rem;
  }
  .pied__plus summary::-webkit-details-marker { display: none; }
  .pied__plus summary::before {
    content: '+'; font-weight: 700; width: 1em; display: inline-block;
  }
  .pied__plus[open] summary::before { content: '−'; }
  .pied__plus summary:hover { color: #fff; }
  .pied__plus ul { margin-top: .4rem; }
  .pied__tout { margin-top: .55rem; }
</style>
