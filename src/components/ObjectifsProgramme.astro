---
import type { Formation } from '../data/formations';

interface Props { formation: Formation }
const { formation: f } = Astro.props;

import { asso } from '../data/association';
import { formations } from '../data/formations';
import { chapitresDe, volume, referentielPse } from '../data/programme-pse';

/**
 * Pour le PSE1 et le PSE2, le programme n'est pas rédigé à la main : il vient
 * du référentiel national, qui le fixe à l'identique partout en France. On le
 * présente dans la même section que pour les autres formations — un visiteur
 * ne doit pas avoir deux programmes à lire.
 */
/**
 * Modalités exigées par Qualiopi, limitées à ce que la page n'affiche pas déjà :
 * la durée, le tarif, les prérequis et la validation sont dans l'en-tête.
 */
const m = { ...asso.modalites, ...(f.modalites ?? {}) };
const modalites = [
  { cle: 'Effectif', valeur: m.effectif, icone: 'groupe' },
  { cle: 'Lieu', valeur: m.lieu, icone: 'lieu' },
  { cle: 'Délai d’accès', valeur: m.delaiAcces, icone: 'agenda' },
  { cle: 'Méthodes mobilisées', valeur: m.pedagogie, icone: 'pratique' },
  { cle: 'Modalités d’évaluation', valeur: m.evaluation, note: f.certificationNote, icone: 'valide' },
];

/* Tracés des pictogrammes, à côté de leur clé pour rester lisibles. */
const PICTOS: Record<string, string> = {
  groupe: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  lieu: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0zM12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  agenda: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
  pratique: 'M14.5 2.5a2.12 2.12 0 0 1 3 3L7 16l-4 1 1-4zM12 20h9',
  valide: 'M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9',
};

/**
 * Rend cliquable la formation citée dans une suite de parcours.
 *
 * « Poursuivre vers le PSE1 » doit mener au PSE1 : sans lien, on demande au
 * visiteur de retourner au catalogue chercher lui-même. On repère le sigle le
 * plus long d'abord, sinon « PSE1 » capterait « FC PSE1 ».
 */
const sigles = formations
  .filter((x) => x.slug !== f.slug)
  .sort((a, b) => b.sigle.length - a.sigle.length);

/** Destinations qui ne sont pas des formations. */
const AILLEURS: { motif: RegExp; href: string; mot: RegExp }[] = [
  {
    motif: /poste[s]? de secours|nos équipes/i,
    href: '/secouriste-actif',
    mot: /nos équipes de postes de secours|postes de secours|nos équipes/i,
  },
];

function lienSuite(texte: string) {
  const hors = AILLEURS.find((a) => a.motif.test(texte));
  if (hors) {
    const m = texte.match(hors.mot)!;
    const i = m.index!;
    return {
      avant: texte.slice(0, i),
      sigle: m[0],
      apres: texte.slice(i + m[0].length),
      href: hors.href,
      suspendue: false,
    };
  }
  const cible = sigles.find((x) =>
    new RegExp(`\\b${x.sigle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'i').test(texte)
  );
  if (!cible) return null;
  const i = texte.toLowerCase().indexOf(cible.sigle.toLowerCase());
  return {
    avant: texte.slice(0, i),
    sigle: texte.slice(i, i + cible.sigle.length),
    apres: texte.slice(i + cible.sigle.length),
    href: `/formations/${cible.slug}`,
    suspendue: Boolean(cible.suspendue),
  };
}

const niveauPse = f.slug === 'pse-1' ? 'pse1' : f.slug === 'pse-2' ? 'pse2' : null;
const chapitres = niveauPse ? chapitresDe(niveauPse) : [];
const v = niveauPse ? volume(niveauPse) : null;
---

<section class="section" aria-label="Contenu de la formation">
  <div class="wrap op">
    <!-- Objectifs -->
    <div class="buts-col">
      <div class="op__tete">
        <span class="op__ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" />
          </svg>
        </span>
        <h2 class="op__h">Objectifs visés</h2>
      </div>

      <div class="buts">
        {f.objectifs.map((o) => (
          <article class="but">
            <span class="but__ic">
              {o.icone === 'bouclier' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /></svg>}
              {o.icone === 'urgence' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m11 3-8 8 10 10 8-8z" /><path d="M8 8h.01M12 12h.01M16 16h.01" /></svg>}
              {o.icone === 'coeur' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-6 4 12 2-6h6" /></svg>}
              {o.icone === 'equipe' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>}
              {o.icone === 'eau' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.7s5.5 5.4 5.5 9.3a5.5 5.5 0 1 1-11 0c0-3.9 5.5-9.3 5.5-9.3z" /></svg>}
              {o.icone === 'pedagogie' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>}
            </span>
            <div>
              <h3>{o.titre}</h3>
              <p>{o.texte}</p>
            </div>
          </article>
        ))}
      </div>

    </div>

    <!-- Modalités : ce que l'en-tête de page ne dit pas déjà. Qualiopi impose
         de les publier ; les répéter ailleurs ferait doublon. -->
    <div class="mods">
      <div class="op__tete">
        <span class="op__ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 11l3 3 8-8" /><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" />
          </svg>
        </span>
        <h2 class="op__h">Comment ça se passe</h2>
      </div>

      <dl class="mods__l">
        {modalites.map((l) => (
          <div class="mods__i">
            <dt>
              <span class="mods__ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={PICTOS[l.icone]} />
                </svg>
              </span>
              {l.cle}
            </dt>
            <dd>
              {l.valeur}
              {l.note && <span class="mods__n">{l.note}</span>}
            </dd>
          </div>
        ))}
      </dl>

    </div>

    <!-- Programme -->
    <div id="programme">
      <div class="op__tete">
        <span class="op__ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
          </svg>
        </span>
        <h2 class="op__h">Programme détaillé</h2>
      </div>

      {v && (
        <p class="op__cadre">
          Contenu fixé par le référentiel national&nbsp;: {v.chapitres} chapitres,
          {' '}{v.sujets} sujets et {v.techniques} techniques travaillées en
          mise en situation.
        </p>
      )}

      <div class="prog">
        {niveauPse
          ? chapitres.map((c, i) => (
              <details class="mod" name={`prog-${f.slug}`} open={i === 0}>
                <summary>
                  <span class="mod__n">{i + 1}</span>
                  <span class="mod__t">{c.nom}</span>
                  <svg class="mod__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <div class="mod__corps">
                  <p>{c.enjeu}</p>
                  {c[niveauPse].length > 0 && (
                    <ul class="mod__l">
                      {c[niveauPse].map((x) => <li>{x}</li>)}
                    </ul>
                  )}
                  {niveauPse === 'pse2' && c.pse1.length > 0 && (
                    <p class="mod__rappel">
                      <strong>Déjà vu en PSE1&nbsp;:</strong> {c.pse1.join(', ').toLowerCase()}.
                    </p>
                  )}
                  {c.techniques[niveauPse] > 0 && (
                    <p class="mod__tech">
                      {c.techniques[niveauPse]} technique{c.techniques[niveauPse] > 1 ? 's' : ''} pratiquée{c.techniques[niveauPse] > 1 ? 's' : ''}
                    </p>
                  )}
                </div>
              </details>
            ))
          : f.modules.map((m, i) => (
              <details class="mod" name={`prog-${f.slug}`} open={i === 0}>
                <summary>
                  <span class="mod__n">{i + 1}</span>
                  <span class="mod__t">{m.titre}</span>
                  <svg class="mod__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <div class="mod__corps"><p>{m.texte}</p></div>
              </details>
            ))}
      </div>

      {v && (
        <p class="op__source">
          Source&nbsp;: {referentielPse.nom}, {referentielPse.edition},
          {' '}{referentielPse.auteur}.
        </p>
      )}
    </div>
  </div>

  {f.suites.length > 0 && (
    <div class="wrap">
      <div class="apres">
        <h3>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
          Et après&nbsp;?
        </h3>
        <ul>
          {f.suites.map((s) => {
            const l = lienSuite(s);
            return (
              <li>
                <span class="apres__puce" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </span>
                <span>
                  {l && !l.suspendue
                    ? <>{l.avant}<a class="apres__lien" href={l.href}>{l.sigle}</a>{l.apres}</>
                    : s}
                </span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  )}
</section>

<style>
  /* Colonne gauche : objectifs puis modalités, l'un sous l'autre.
     Colonne droite : le programme, qui court sur les deux rangées. */
  .op {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: auto auto;
    align-items: start;
  }
  /* Placement explicite : le placement automatique aurait mis les modalités
     dans la colonne du programme. */
  .op > .buts-col { grid-column: 1; grid-row: 1; }
  .op > .mods { grid-column: 1; grid-row: 2; }
  .op > #programme { grid-column: 2; grid-row: 1 / span 2; }
  @media (max-width: 880px) {
    .op { grid-template-columns: 1fr; grid-template-rows: none; }
    .op > .buts-col,
    .op > .mods,
    .op > #programme { grid-column: 1; grid-row: auto; }
  }

  .op__tete { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1.5rem; }
  .op__ic {
    width: 42px; height: 42px;
    border-radius: 12px;
    display: grid; place-items: center;
    flex: none;
    background: var(--accent-wash);
    color: var(--accent);
  }
  .op__ic svg { width: 21px; height: 21px; }
  .op__h { font-size: clamp(1.5rem, 3.4vw, 1.95rem); font-weight: 700; }

  .buts { display: flex; flex-direction: column; gap: 0.7rem; }
  .but {
    display: flex; gap: 0.95rem; align-items: flex-start;
    background: var(--sunk);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 1.05rem 1.2rem;
  }
  .but__ic { flex: none; width: 26px; height: 26px; color: var(--accent); margin-top: 0.15rem; }
  .but__ic svg { width: 100%; height: 100%; }
  .but h3 { font-size: 1.02rem; font-weight: 700; margin-bottom: 0.15rem; }
  .but p { font-size: 0.93rem; color: var(--ink-soft); }

  .apres {
    margin-top: 1.1rem;
    background: var(--navy);
    color: var(--on-navy);
    border-radius: var(--r-lg);
    padding: clamp(1.3rem, 3vw, 1.7rem);
  }
  .apres h3 { display: flex; align-items: center; gap: 0.6rem; font-size: 1.12rem; font-weight: 700; margin-bottom: 1rem; }
  .apres h3 svg { width: 20px; height: 20px; color: var(--secours-hi); flex: none; }
  .apres ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .apres li { display: flex; gap: 0.8rem; align-items: center; font-size: 0.94rem; color: var(--on-navy-text); }
  .apres__puce {
    flex: none; width: 30px; height: 30px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.1);
    display: grid; place-items: center;
  }
  .apres__puce svg { width: 15px; height: 15px; color: #fff; }

  .prog { display: flex; flex-direction: column; gap: 0.6rem; }
  .mod {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .mod[open] { box-shadow: var(--sh-sm); border-color: color-mix(in srgb, var(--accent) 32%, var(--line)); }
  .mod summary {
    list-style: none;
    cursor: pointer;
    display: flex; align-items: center; gap: 0.95rem;
    padding: 1rem 1.2rem;
    font-family: 'Archivo', sans-serif;
    font-weight: 700; font-size: 1.02rem;
  }
  .mod summary::-webkit-details-marker { display: none; }
  .mod__n {
    flex: none; width: 30px; height: 30px;
    border-radius: 50%;
    display: grid; place-items: center;
    background: var(--accent); color: #fff;
    font-size: 0.85rem; font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .mod__t { flex: 1; }
  .mod__chev { flex: none; width: 18px; height: 18px; color: var(--ink-mute); transition: transform 0.2s ease; }
  .mod[open] .mod__chev { transform: rotate(180deg); }
  .mod__corps { padding: 0 1.2rem 1.15rem calc(1.2rem + 30px + 0.95rem); }
  .mod__corps p { color: var(--ink-soft); font-size: 0.94rem; max-width: var(--measure); }
  @media (max-width: 520px) { .mod__corps { padding-left: 1.2rem; } }

  .op__cadre {
    margin-bottom: 1rem; font-size: .89rem; color: var(--ink-soft);
    background: var(--azur-wash); border-left: 3px solid var(--azur);
    border-radius: 0 var(--r-sm) var(--r-sm) 0; padding: .7rem .95rem;
  }
  .op__source {
    margin-top: 1rem; font-size: .8rem; color: var(--ink-mute);
  }
  .mod__l {
    list-style: none; margin: .7rem 0 0; padding: 0;
    display: grid; gap: .35rem;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
  }
  .mod__l li {
    position: relative; padding-left: 1rem;
    font-size: .89rem; color: var(--ink);
  }
  .mod__l li::before {
    content: ''; position: absolute; left: 0; top: .58em;
    width: 5px; height: 5px; border-radius: 50%; background: var(--azur);
  }
  .mod__rappel {
    margin-top: .8rem; font-size: .84rem; color: var(--ink-mute);
    padding: .55rem .8rem; background: var(--sunk); border-radius: var(--r-sm);
  }
  .mod__tech {
    margin-top: .7rem;
    font-family: 'Archivo', sans-serif; font-size: .72rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase; color: var(--accent);
  }

  .mods__l {
    margin: 1.25rem 0 0;
    border: 1px solid var(--line); border-radius: var(--r-lg);
    overflow: hidden; background: var(--surface);
  }
  .mods__i {
    display: grid; gap: .2rem;
    padding: .85rem 1.1rem; border-bottom: 1px solid var(--line);
  }
  .mods__i:last-child { border-bottom: 0; }
  .mods__i dt {
    display: flex; align-items: center; gap: .45rem;
    font-family: 'Archivo', sans-serif; font-size: .68rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--ink-mute);
  }
  .mods__ic {
    flex: none; width: 26px; height: 26px;
    color: var(--accent);
    display: grid; place-items: center;
  }
  .mods__ic svg { width: 26px; height: 26px; }
  .mods__i dd { padding-left: calc(26px + .45rem); }
  .mods__i dd { margin: 0; font-size: .9rem; color: var(--ink); }
  .mods__n { display: block; margin-top: .2rem; font-size: .83rem; color: var(--ink-mute); }


  .apres__lien {
    color: var(--accent); font-weight: 700;
    text-decoration: underline; text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }
  .apres__lien:hover { text-decoration-color: currentColor; }

  /* « Et après » occupe toute la largeur, en deux colonnes : ce sont des
     portes de sortie, elles méritent d'être vues plutôt que tassées dans
     une colonne. */
  .apres ul {
    display: grid; gap: .8rem;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }
</style>
