  .compagnon[data-ecran='urgence'] .compagnon__action small {
    grid-column: 3;
    grid-row: 1;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  /* --- téléphone --- */

  @media (max-width: 640px) {
    .compagnon__lanceur img { width: 48px; height: 48px; }
    .compagnon__bulle { font-size: 0.8rem; }

    /* Le panneau couvre presque l'écran : le voile y travaille plus fort. */
    .compagnon[data-ouvert] .compagnon__voile {
      background: rgba(7, 23, 38, 0.3);
      backdrop-filter: blur(2.5px);
    }

    .compagnon { --perso-h: 122px; --perso-x: 56px; }
    .compagnon__boite { grid-template-columns: 102px minmax(0, 1fr); }
    .compagnon__panneau { padding: 1.2rem 0.85rem 1.1rem 1.6rem; }

    .compagnon__action { padding: 0.5rem 0.6rem; font-size: 0.84rem; }
    .compagnon__actions { max-height: min(46vh, 360px); }
  }

  /*
   * --- dans la barre d'onglets ---
   * Sous 720 px, le lanceur quitte le coin de l'écran pour la case centrale de
   * la barre d'onglets, qu'il déborde vers le haut. Seul l'état fermé bouge :
   * ouvert, le panneau garde sa place habituelle, ancré à droite, par-dessus
   * la barre. 29 px, c'est la moitié du rond (48 px d'image, 0,32 rem de
   * liseré de chaque côté) : le rond tombe pile au milieu.
   */
  @media (max-width: 720px) {
    .compagnon:not([data-ouvert]) {
      right: calc(50% - 29px);
      bottom: calc(1.95rem + env(safe-area-inset-bottom));
    }

    .compagnon__lanceur img { width: 48px; height: 48px; }

    .compagnon[data-bulle] .compagnon__bulle {
      right: auto;
      left: 50%;
      translate: -50% 0;
    }
    .compagnon[data-bulle] .compagnon__bulle::after {
      right: auto;
      left: calc(50% - 5px);
    }

    /*
     * --- ouvert : l'écran d'accueil de l'application ---
     * Le panneau flottant devient une page entière : la marque, les
     * agréments, le personnage en grand au centre, sa question, et les choix
     * en grandes cartes au pouce. Le premier choix est plein, en rouge : c'est
     * la raison de venir la plus fréquente. Mêmes écrans, mêmes choix, même
     * script — seul l'habit change.
     */
    :global(html:has(.compagnon[data-ouvert])) { overflow: hidden; }

    .compagnon[data-ouvert] {
      inset: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      background:
        radial-gradient(circle at 88% 17%, rgba(216, 56, 42, 0.1) 0 10%, transparent 29%),
        radial-gradient(circle at 5% 57%, rgba(27, 111, 168, 0.1) 0 12%, transparent 32%),
        linear-gradient(180deg, #ffffff 0%, #f3f7fa 56%, #eaf1f5 100%);
    }

    .compagnon[data-ouvert] .compagnon__voile { display: none; }

    .compagnon[data-ouvert] { --perso-h: 190px; }
    .compagnon[data-ouvert]:not([data-ecran='accueil']) { --perso-h: 130px; }

    .compagnon__boite {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      min-height: 100%;
      padding: calc(0.9rem + env(safe-area-inset-top)) 1.1rem calc(1.4rem + env(safe-area-inset-bottom));
    }
    .compagnon__boite[hidden] { display: none; }

    .compagnon__entete {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      min-height: 44px;
      padding-right: 3.2rem;
      color: var(--navy-deep);
      font-family: 'Archivo', sans-serif;
      font-size: 0.88rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      text-transform: uppercase;
