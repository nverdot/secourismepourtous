const POSES = [...new Set(ECRANS.map((e) => e.pose))];
const accueil = ECRANS[0];

/*
 * Le script n'a besoin que de l'en-tête de chaque écran : les listes de choix
 * sont déjà dans le HTML. Sans ce tri, les treize écrans voyageaient deux fois
 * dans la page — 2 Ko compressés pour rien.
 */
const ENTETES = ECRANS.map(({ id, pose, oeil, titre, message }) => ({ id, pose, oeil, titre, message }));
---

<div class="compagnon" id="compagnon" data-ecran="accueil" data-poses={POSES.join(' ')}>
  {/*
    Le voile détache le menu de la page et donne une cible pour refermer :
    cliquer dans le vide referme, ce qui est le geste qu'on essaie d'abord.
  */}
  <div class="compagnon__voile" id="compagnon-voile"></div>

  {/* Sur téléphone, le lanceur se réduit à un rond : la bulle dit une fois
      par session ce que ce rond propose. */}
  <span class="compagnon__bulle" aria-hidden="true">Besoin d’aide&nbsp;?</span>

  <button
    class="compagnon__lanceur"
    id="compagnon-lanceur"
    type="button"
    aria-haspopup="dialog"
    aria-controls="compagnon-boite"
    aria-expanded="false"
    aria-label="Besoin d’aide ?"
  >
    <img src="/compagnon/lanceur.webp" width="128" height="128" alt="" decoding="async" />
  </button>

  <section
    class="compagnon__boite"
    id="compagnon-boite"
    role="dialog"
    aria-modal="false"
    aria-labelledby="compagnon-titre"
    hidden
  >
    <div class="compagnon__perso" aria-hidden="true">
      {/* « lazy » sur une image cachée : le navigateur ne la cherche qu'à
          l'ouverture. Le script la devance dès que la souris approche. */}
      <img
        id="compagnon-perso"
        src={`/compagnon/${accueil.pose}.webp`}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="compagnon__panneau">
      <button class="compagnon__fermer" id="compagnon-fermer" type="button" aria-label="Fermer le compagnon">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

      <p class="compagnon__oeil" id="compagnon-oeil">{accueil.oeil}</p>
      <h2 class="compagnon__titre" id="compagnon-titre" tabindex="-1">{accueil.titre}</h2>
      <p class="compagnon__message" id="compagnon-message">{accueil.message}</p>

      {/*
        Les listes d'actions sont rendues au build, une par écran, puis
        montrées à tour de rôle. Les fabriquer en JavaScript les priverait du
        style : Astro porte ses règles par un attribut « data-astro-cid-… »
        qu'un élément créé par script n'a pas.
      */}
      {ECRANS.map((e) => (
        <div class="compagnon__actions" data-actions={e.id} hidden={e.id !== 'accueil'}>
          {e.actions.map((a) => {
            const contenu = (
              <>
                <svg class="compagnon__icone" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"
                     fill={PLEINES.has(a.icone) ? 'currentColor' : 'none'}
                     stroke={PLEINES.has(a.icone) ? 'none' : 'currentColor'}
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d={ICONES[a.icone]} />
                </svg>
                <span class="compagnon__action-texte">{a.texte}</span>
                {a.note && <small>{a.note}</small>}
              </>
            );
            return a.vers ? (
              <a class="compagnon__action" href={a.vers}>{contenu}</a>
            ) : (
              <button class="compagnon__action" type="button" data-ecran={a.ecran}>
                {contenu}
                <svg class="compagnon__chevron" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
                     fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                  <path d="M9 5l7 7-7 7" />
                </svg>
              </button>
            );
          })}
        </div>
      ))}

      <button class="compagnon__retour" id="compagnon-retour" type="button" hidden>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <path d="M15 5l-7 7 7 7" />
        </svg>
        Revenir au début
      </button>
    </div>
  </section>
</div>

<script is:inline define:vars={{ ENTETES }}>
  (() => {
    const racine = document.getElementById('compagnon');
    if (!racine) return;

    const lanceur = document.getElementById('compagnon-lanceur');
    const boite = document.getElementById('compagnon-boite');
    const perso = document.getElementById('compagnon-perso');
    const oeil = document.getElementById('compagnon-oeil');
    const titre = document.getElementById('compagnon-titre');
    const message = document.getElementById('compagnon-message');
    const retour = document.getElementById('compagnon-retour');
    const fermer = document.getElementById('compagnon-fermer');
    const voile = document.getElementById('compagnon-voile');
    const groupes = [...racine.querySelectorAll('[data-actions]')];

    const parId = Object.fromEntries(ENTETES.map((e) => [e.id, e]));
    let precharge = false;

    /* Les poses ne partent qu'à l'approche : survol, focus clavier, ou à
       défaut l'ouverture elle-même. Le premier écran est donc déjà en cache
       au moment où le panneau s'ouvre. */
    function prechargerPoses() {
      if (precharge) return;
      precharge = true;
      racine.dataset.poses.split(' ').forEach((p) => {
        const img = new Image();
        img.decoding = 'async';
        img.src = `/compagnon/${p}.webp`;
      });
    }

    /* « focus » n'est vrai que sur une navigation voulue : l'écran d'accueil
       rendu au build ne doit pas voler le focus au chargement de la page.
       Sans cela, cliquer un choix détruit le bouton qui portait le focus et
       le clavier repart à zéro sur le document. */
    function afficher(id, focus) {
      const e = parId[id] || parId.accueil;
      racine.dataset.ecran = e.id;
      oeil.textContent = e.oeil;
      titre.textContent = e.titre;
      message.textContent = e.message;
      perso.src = `/compagnon/${e.pose}.webp`;
      groupes.forEach((g) => (g.hidden = g.dataset.actions !== e.id));
      retour.hidden = e.id === 'accueil';
      if (focus) titre.focus({ preventScroll: true });
    }

    function ouvrir() {
      prechargerPoses();
      boite.hidden = false;
      lanceur.hidden = true;
      racine.dataset.ouvert = '1';
      lanceur.setAttribute('aria-expanded', 'true');
      afficher('accueil');
      fermer.focus({ preventScroll: true });
      delete racine.dataset.salut;
      delete racine.dataset.bulle;
    }

    function refermer() {
      boite.hidden = true;
      lanceur.hidden = false;
      delete racine.dataset.ouvert;
      lanceur.setAttribute('aria-expanded', 'false');
      lanceur.focus({ preventScroll: true });
    }

    lanceur.addEventListener('click', ouvrir);
    lanceur.addEventListener('pointerenter', prechargerPoses, { once: true });
    lanceur.addEventListener('focus', prechargerPoses, { once: true });
    fermer.addEventListener('click', refermer);
    voile.addEventListener('click', refermer);
    retour.addEventListener('click', () => afficher('accueil', true));

    racine.addEventListener('click', (ev) => {
      const b = ev.target.closest('button[data-ecran]');
      if (b) afficher(b.dataset.ecran, true);
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && !boite.hidden) refermer();
    });

    /*
     * Deux gestes, deux rythmes.
     *
     * Le petit salut de la main rejoue à chaque page : il dure trois secondes,
     * ne déplace rien, et c'est lui qui fait remarquer le lanceur.
     *
     * La bulle « Besoin d'aide ? » ne paraît qu'une fois par session. Elle
     * n'existe que sur téléphone, où le lanceur perd son libellé, et répéter à
     * chaque page un texte qu'on a déjà lu, c'est harceler.
     *
     * Jamais d'ouverture automatique dans les deux cas : la page appartient au
     * visiteur. Rien n'est conservé d'une visite à l'autre.
     */
    racine.dataset.salut = '1';
    setTimeout(() => delete racine.dataset.salut, 6000);

    try {
      if (!sessionStorage.getItem('compagnon-bulle')) {
        sessionStorage.setItem('compagnon-bulle', '1');
        racine.dataset.bulle = '1';
        setTimeout(() => delete racine.dataset.bulle, 8000);
      }
    } catch {
      /* stockage refusé : pas de bulle, pas de gêne */
    }

    window.Compagnon = Object.freeze({ ouvrir, fermer: refermer, afficher });
  })();
</script>

<style>
  .compagnon {
    --compagnon-marge: max(1rem, env(safe-area-inset-bottom));
    --perso-h: 238px;   /* hauteur commune à toutes les poses */
    --perso-x: 110px;   /* où retombe le milieu de la tête */
    position: fixed;
    z-index: 900;
    right: max(1rem, env(safe-area-inset-right));
    bottom: var(--compagnon-marge);
  }

  /* --- le lanceur --- */

  /*
   * Le jaune fédéral, et pas le marine : le lanceur traverse des sections
   * blanches et des sections marine, et un pastille marine disparaissait
   * purement et simplement sur le héros. Le jaune tient sur les deux fonds —
   * c'est d'ailleurs la haute visibilité du polo. Il ne porte que de l'encre
   * sombre : à 1,68:1 sur blanc, il ne peut pas servir de couleur de texte.
   */
  .compagnon__lanceur {
    display: block;
    padding: 0.32rem;
    border: 0;
    border-radius: 50%;
    background: var(--ocre-vif);
    box-shadow: var(--sh-md);
    cursor: pointer;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }

  .compagnon__lanceur[hidden] { display: none; }

  .compagnon__lanceur:hover {
    transform: translateY(-2px);
    box-shadow: var(--sh-lg);
  }

  .compagnon__lanceur:focus-visible {
    outline: 3px solid var(--navy-deep);
    outline-offset: 2px;
  }

  .compagnon__lanceur img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--surface);
    object-fit: cover;
  }

  /* Le rond blanc du téléphone se passe du liseré, qui l'épaissirait. */
  .compagnon__lanceur:focus-visible img { background: var(--surface); }

  /*
   * Le rond n'affiche plus de libellé : c'est la bulle qui dit, une fois par
   * session, ce qu'il propose.
   */
  .compagnon__bulle { display: none; }

  .compagnon[data-bulle] .compagnon__bulle {
    position: absolute;
    right: 6px;
    bottom: calc(100% + 0.6rem);
    display: block;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: var(--sh-md);
    color: var(--navy-deep);
    font-family: 'Archivo', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    animation: compagnon-bulle 0.45s ease-out 0.9s both;
  }

  .compagnon[data-bulle] .compagnon__bulle::after {
    position: absolute;
    right: 24px;
    top: 100%;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border: 1px solid var(--line);
    border-width: 0 1px 1px 0;
    background: var(--surface);
    content: '';
    transform: rotate(45deg);
  }

  /*
   * Le voile détache le menu de la page, et cliquer dedans referme. Le z-index
   * négatif le place derrière le panneau sans le sortir de la pile du
   * compagnon : il reste donc au-dessus de la page.
   */
  .compagnon__voile { display: none; }

  .compagnon[data-ouvert] .compagnon__voile {
    position: fixed;
    z-index: -1;
    inset: 0;
    display: block;
    background: rgba(7, 23, 38, 0.22);
    backdrop-filter: blur(2px);
    animation: compagnon-voile 0.2s ease-out both;
  }

  /* Le salut d'ouverture de session : deux oscillations, puis plus rien. */
  .compagnon[data-salut] .compagnon__lanceur img {
    animation: compagnon-salut 1.5s ease-in-out 1s 2;
    transform-origin: 50% 88%;
  }

  @keyframes compagnon-voile {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes compagnon-bulle {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes compagnon-salut {
    0%, 55%, 100% { transform: rotate(0); }
    65% { transform: rotate(-10deg); }
    75% { transform: rotate(9deg); }
    85% { transform: rotate(-5deg); }
    93% { transform: rotate(3deg); }
  }

  /* --- le panneau --- */

  .compagnon__boite {
    display: grid;
    grid-template-columns: 200px minmax(0, 340px);
    align-items: end;
    width: min(540px, calc(100vw - 2rem));
  }

  .compagnon__boite[hidden] { display: none; }

  /*
   * La marge basse négative annule le retrait du widget : le personnage pose
   * les pieds sur le bord de l'écran, sans bande vide dessous, pendant que le
   * panneau, lui, garde sa respiration.
   */
  /*
   * Chaque pose a sa propre largeur de toile — le « bonjour » a besoin d'une
   * main levée, le « bravo » d'un pouce — mais toutes ont la même hauteur et
   * la tête centrée. C'est donc la hauteur qui fixe l'échelle, et la tête
   * retombe toujours sur --perso-x, quelle que soit la largeur de l'image.
   * La marge basse négative annule le retrait du widget : le personnage pose
   * les pieds sur le bord de l'écran pendant que le panneau garde son air.
   */
  .compagnon__perso {
    position: relative;
    z-index: 2;
    height: var(--perso-h);
    pointer-events: none;
  }

  .compagnon__perso img {
    position: absolute;
    bottom: calc(-1 * var(--compagnon-marge));
    left: var(--perso-x);
    transform: translateX(-50%);
    width: auto;
    /* « max-width: 100% » du style global rabattait l'image sur la largeur de
       la colonne et l'écrasait : 254 px de dessin comprimés en 200. */
    max-width: none;
    height: var(--perso-h);
    filter: drop-shadow(0 8px 18px rgba(11, 37, 64, 0.18));
  }

  /*
   * Le retrait gauche doit dépasser le débord du personnage, sinon le texte
   * passe sous lui : 2.7rem contre 35 px de débord.
   */
  .compagnon__panneau {
    position: relative;
    z-index: 1;
    padding: 1.35rem 1.35rem 1.2rem 2.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg) var(--r-lg) var(--r-sm) var(--r-lg);
    background: var(--surface);
    box-shadow: var(--sh-lg);
  }

  .compagnon__fermer {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--sunk);
    color: var(--ink-soft);
    cursor: pointer;
  }

  .compagnon__fermer:hover { color: var(--ink); border-color: var(--ink-mute); }

  .compagnon__oeil {
    margin: 0 2.2rem 0.25rem 0;
    color: var(--navy-lift);
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .compagnon__titre:focus { outline: none; }

  .compagnon__titre {
    margin: 0 2.2rem 0.35rem 0;
    color: var(--navy-deep);
    font-family: 'Archivo', sans-serif;
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .compagnon__message {
    margin: 0 0 0.9rem;
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  /* --- les choix --- */

  .compagnon__actions {
    display: grid;
    gap: 0.35rem;
    max-height: min(52vh, 420px);
    overflow-y: auto;
  }

  .compagnon__actions[hidden] { display: none; }

  .compagnon__action {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    /*
     * Blanc sur blanc, les choix se confondaient avec le panneau. Le fond
     * creusé du site les détache sans les alourdir ; le survol fait l'inverse,
     * il les soulève en blanc. Le jaune fédéral reste réservé au focus : à
     * 1,68:1 sur blanc il ne peut pas porter de texte.
     */
    background: var(--sunk);
    color: var(--ink);
    font: inherit;
    font-size: 0.88rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.14s ease, background-color 0.14s ease;
  }

  .compagnon__icone {
    grid-column: 1;
    grid-row: 1 / -1;
    color: var(--navy-lift);
  }

  .compagnon__action-texte {
    grid-column: 2;
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    line-height: 1.25;
  }

  .compagnon__action small {
    grid-column: 2;
    color: var(--ink-mute);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .compagnon__chevron {
    grid-column: 3;
    grid-row: 1 / -1;
    color: var(--ink-mute);
  }

  .compagnon__action:hover,
  .compagnon__action:focus-visible {
    border-color: var(--navy-lift);
    background: var(--surface);
    box-shadow: var(--sh-sm);
    outline: none;
  }

  .compagnon__action:focus-visible { box-shadow: 0 0 0 3px var(--ocre-vif); }

  /*
   * Le choix « j'ai besoin des secours » porte le rouge dès l'accueil : c'est
   * le seul de la liste qui ne peut pas attendre qu'on le lise.
   */
  .compagnon__action[data-ecran='urgence'],
  .compagnon[data-ecran='urgence'] .compagnon__action {
    border-color: rgba(216, 56, 42, 0.35);
    background: var(--secours-wash);
  }

  .compagnon__action[data-ecran='urgence'] .compagnon__action-texte,
  .compagnon__action[data-ecran='urgence'] .compagnon__icone,
  .compagnon__action[data-ecran='urgence'] .compagnon__chevron { color: var(--secours); }

  .compagnon__action[data-ecran='urgence']:hover,
  .compagnon[data-ecran='urgence'] .compagnon__action:hover {
    border-color: var(--secours);
    background: var(--surface);
  }

  .compagnon__retour {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.7rem;
    padding: 0.2rem 0;
    border: 0;
    background: none;
    color: var(--navy-lift);
    font-family: 'Archivo', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .compagnon__retour[hidden] { display: none; }
  .compagnon__retour:hover { color: var(--navy-deep); text-decoration: underline; }

  /* --- l'urgence : pas de personnage, les numéros et rien d'autre --- */

  .compagnon[data-ecran='urgence'] .compagnon__panneau {
    border: 2px solid var(--secours);
  }

  .compagnon[data-ecran='urgence'] .compagnon__oeil,
  .compagnon[data-ecran='urgence'] .compagnon__titre,
  .compagnon[data-ecran='urgence'] .compagnon__icone { color: var(--secours); }

  .compagnon[data-ecran='urgence'] .compagnon__action {
    grid-template-columns: auto 2.9rem minmax(0, 1fr);
  }

  .compagnon[data-ecran='urgence'] .compagnon__action-texte {
    grid-column: 2;
    color: var(--secours);
    font-size: 1.45rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .compagnon[data-ecran='urgence'] .compagnon__action small {
    grid-column: 3;
    grid-row: 1;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  /* --- téléphone --- */

  @media (max-width: 640px) {
    .compagnon__lanceur img { width: 48px; height: 48px; }
    .compagnon__bulle { font-size: 0.8rem; }

    /* Le panneau couvre presque l'écran : le voile y travaille plus fort. */
    .compagnon[data-ouvert] .compagnon__voile {
      background: rgba(7, 23, 38, 0.3);
      backdrop-filter: blur(2.5px);
    }

    .compagnon { --perso-h: 122px; --perso-x: 56px; }
    .compagnon__boite { grid-template-columns: 102px minmax(0, 1fr); }
    .compagnon__panneau { padding: 1.2rem 0.85rem 1.1rem 1.6rem; }

    .compagnon__action { padding: 0.5rem 0.6rem; font-size: 0.84rem; }
    .compagnon__actions { max-height: min(46vh, 360px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .compagnon__lanceur { transition: none; }
    .compagnon__lanceur:hover { transform: none; }
    .compagnon[data-salut] .compagnon__lanceur img { animation: none; }
    .compagnon[data-bulle] .compagnon__bulle { animation: none; opacity: 1; }
    .compagnon[data-ouvert] .compagnon__voile { animation: none; }
  }
</style>
