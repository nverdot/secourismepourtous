    box-shadow: var(--sh-sm);
    outline: none;
  }

  .compagnon__action:focus-visible { box-shadow: 0 0 0 3px var(--ocre-vif); }

  /*
   * Le choix « j'ai besoin des secours » porte le rouge dès l'accueil : c'est
   * le seul de la liste qui ne peut pas attendre qu'on le lise.
   */
  .compagnon__action[data-ecran='urgence'],
  .compagnon[data-ecran='urgence'] .compagnon__action {
