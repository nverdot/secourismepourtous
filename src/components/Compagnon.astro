    actions: [
      { texte: 'Devenir secouriste actif', icone: 'trousse', vers: '/secouriste-actif' },
      { texte: 'Devenir formateur', icone: 'diplome', vers: '/devenir-formateur' },
      { texte: 'Je n’ai aucun diplôme, par où commencer ?', icone: 'question', ecran: 'terrain' },
