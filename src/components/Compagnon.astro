    .compagnon__entete img { width: 34px; height: 40px; object-fit: contain; }
    .compagnon__entete em { font-style: normal; color: var(--secours); }

    .compagnon__preuve {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin: 0.45rem 0 0;
      padding: 0.5rem 0.7rem;
      border: 1px solid #d9e5eb;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.88);
      box-shadow: 0 8px 24px rgba(7, 23, 38, 0.06);
      color: var(--ink-soft);
      font-size: 0.78rem;
      font-weight: 600;
      line-height: 1.25;
    }
    .compagnon__preuve svg { flex: none; color: var(--secours); }
    .compagnon__preuve strong { display: block; color: var(--navy-deep); font-size: 0.82rem; font-weight: 800; }
    .compagnon:not([data-ecran='accueil']) .compagnon__preuve { display: none; }

    .compagnon__perso {
      z-index: 1;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      height: var(--perso-h);
      margin-inline: -0.5rem;
    }

    .compagnon__perso::before {
      position: absolute;
      left: 50%;
      bottom: 0;
      width: min(290px, 82%);
      height: 80%;
      border-radius: 48% 52% 44% 56%;
      background: linear-gradient(145deg, #dcecf5, #f7fbfd);
      content: '';
      translate: -50% 0;
    }

    .compagnon__perso img {
      position: relative;
      left: auto;
      bottom: auto;
      transform: none;
      height: var(--perso-h);
      width: auto;
      max-width: 100%;
      object-fit: contain;
      filter: drop-shadow(0 18px 22px rgba(7, 23, 38, 0.16));
    }


    .compagnon__fermer {
      top: calc(0.9rem + env(safe-area-inset-top));
      right: 1rem;
      width: 44px;
      height: 44px;
      border-radius: 14px;
      background: var(--surface);
    }

    /*
     * La bulle : l'œil, le titre et le message forment ensemble ce que le
     * personnage dit, dans un phylactère marine posé au-dessus de lui, la
     * pointe vers sa tête. Le panneau passe en « display: contents » : ses
     * enfants deviennent des éléments de la colonne, et « order » peut placer
     * la bulle avant le personnage sans toucher au HTML — donc sans toucher à
     * l'ordinateur, ni à l'ordre de lecture.
     */
    .compagnon__panneau { display: contents; }
    .compagnon__entete { order: 1; }
    .compagnon__preuve { order: 2; }
    .compagnon__oeil { order: 3; }
    .compagnon__titre { order: 4; }
    .compagnon__message { order: 5; }
    .compagnon__perso { order: 6; }
    .compagnon__actions { order: 7; }
    .compagnon__retour { order: 8; }
    .compagnon__passer { order: 9; }

    .compagnon__oeil,
    .compagnon__titre,
    .compagnon__message {
      margin: 0;
      background: var(--navy-deep);
      text-align: left;
    }
    /* Trois boîtes, une seule bulle : le filet d'un demi-pixel qui les
       séparait à certains zooms est recouvert par l'ombre du dessous. */
    .compagnon__oeil, .compagnon__titre { box-shadow: 0 1px 0 var(--navy-deep); }
    .compagnon[data-ecran='urgence'] :is(.compagnon__oeil, .compagnon__titre) { box-shadow: 0 1px 0 var(--secours); }

    .compagnon__oeil {
      margin-top: 1rem;
      padding: 0.85rem 1rem 0.1rem;
      border-radius: 20px 20px 0 0;
      color: #ff8a80;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
    }

    .compagnon__titre {
      padding: 0.1rem 1rem 0.2rem;
      color: #fff;
      font-size: 1.3rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.02em;
    }

    .compagnon__message {
      position: relative;
      padding: 0.1rem 1rem 0.95rem;
      border-radius: 0 0 20px 20px;
      box-shadow: 0 14px 28px rgba(7, 23, 38, 0.16);
      color: var(--on-navy-text);
      font-size: 0.95rem;
      line-height: 1.45;
    }

    /* La pointe du phylactère, vers la tête du personnage. */
    .compagnon__message::after {
      position: absolute;
      top: 100%;
      left: 50%;
      width: 0;
      height: 0;
      border: 11px solid transparent;
      border-top-color: var(--navy-deep);
      border-bottom: 0;
      content: '';
      translate: -50% 0;
    }

    .compagnon__perso { margin-top: 0.35rem; }

    /* L'urgence parle en rouge. */
    .compagnon[data-ecran='urgence'] :is(.compagnon__oeil, .compagnon__titre, .compagnon__message) {
      background: var(--secours);
      color: #fff;
    }
    .compagnon[data-ecran='urgence'] .compagnon__message::after { border-top-color: var(--secours); }

    /* Les choix remontent sur la ceinture du personnage : il se tient
       derrière le premier bouton, sans vide entre eux. */
    .compagnon__actions {
      position: relative;
      z-index: 2;
      margin-top: -0.7rem;
      gap: 0.5rem;
      max-height: none;
      overflow: visible;
      text-align: left;
    }

    .compagnon__action {
      grid-template-columns: 38px minmax(0, 1fr) auto;
      column-gap: 0.7rem;
      min-height: 58px;
      padding: 0.5rem 0.75rem;
      border-color: #d8e3ea;
      border-radius: 15px;
      background: var(--surface);
      box-shadow: 0 7px 18px rgba(7, 23, 38, 0.06);
      font-size: 0.95rem;
    }
    .compagnon__action-texte { font-weight: 700; }
    .compagnon__action small { font-size: 0.8rem; }

    .compagnon__icone {
      box-sizing: border-box;
      width: 38px;
      height: 38px;
      padding: 9px;
      border-radius: 11px;
      background: var(--secours-wash);
      color: var(--secours);
    }

    .compagnon:not([data-ecran='urgence']) .compagnon__actions > .compagnon__action:first-child {
      border-color: transparent;
      background: var(--secours);
      color: #fff;
    }
    .compagnon:not([data-ecran='urgence']) .compagnon__actions > .compagnon__action:first-child :is(.compagnon__action-texte, .compagnon__chevron, small) { color: #fff; }
    .compagnon:not([data-ecran='urgence']) .compagnon__actions > .compagnon__action:first-child .compagnon__icone {
      background: rgba(255, 255, 255, 0.16);
      color: #fff;
    }

    .compagnon__retour { align-self: center; margin: 1rem auto 0; }

    .compagnon__passer {
      display: block;
      min-height: 44px;
      margin: 0.4rem auto 0;
      padding: 0.5rem 0.8rem;
      border: 0;
      background: none;
      color: var(--ink-mute);
      font-family: 'Archivo', sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .compagnon__lanceur { transition: none; }
    .compagnon__lanceur:hover { transform: none; }
    .compagnon[data-salut] .compagnon__lanceur img { animation: none; }
    .compagnon[data-bulle] .compagnon__bulle { animation: none; opacity: 1; }
    .compagnon[data-ouvert] .compagnon__voile { animation: none; }
  }

  /* --- la réplique qui s'écrit, et l'écran qui change --- */
  :global(.compagnon__frappe:not(.est-fini))::after {
    content: '▍';
    position: absolute;
    margin-left: 1px;
    animation: compagnon-curseur 0.8s steps(1) infinite;
  }
  @keyframes compagnon-curseur {
    50% { opacity: 0; }
  }
  .compagnon__message { cursor: default; }
  :global(.compagnon__reste) { color: transparent; }

  .compagnon[data-change] :is(.compagnon__oeil, .compagnon__titre) {
    animation: compagnon-pop 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;
  }
  /* Le personnage ne fait que fondre : sur ordinateur, sa place est tenue
     par un « transform », qu'une animation d'échelle écraserait. */
  .compagnon[data-change] .compagnon__perso img { animation: compagnon-fondu 0.35s ease-out both; }
  .compagnon[data-change] .compagnon__actions:not([hidden]) > * {
    animation: compagnon-entree 0.3s ease-out both;
  }
  .compagnon[data-change] .compagnon__actions > :nth-child(2) { animation-delay: 0.05s; }
  .compagnon[data-change] .compagnon__actions > :nth-child(3) { animation-delay: 0.1s; }
  .compagnon[data-change] .compagnon__actions > :nth-child(4) { animation-delay: 0.15s; }
  .compagnon[data-change] .compagnon__actions > :nth-child(5) { animation-delay: 0.2s; }
  .compagnon[data-change] .compagnon__actions > :nth-child(6) { animation-delay: 0.25s; }
  .compagnon[data-change] .compagnon__actions > :nth-child(n + 7) { animation-delay: 0.3s; }

  @keyframes compagnon-pop {
    from { opacity: 0; transform: scale(0.94) translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes compagnon-fondu {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes compagnon-entree {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .compagnon[data-change] :is(.compagnon__oeil, .compagnon__titre, .compagnon__perso img),
    .compagnon[data-change] .compagnon__actions > * { animation: none; }
    :global(.compagnon__frappe)::after { display: none; }
  }
