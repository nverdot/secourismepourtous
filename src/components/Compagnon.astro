    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 1.15rem 0.35rem 0.35rem;
    border: 1px solid var(--navy-deep);
    border-radius: var(--r-pill);
    background: var(--navy);
    box-shadow: var(--sh-md);
    color: var(--on-navy);
