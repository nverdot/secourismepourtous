    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.16s ease, background-color 0.16s ease;
  }

  .compagnon__lanceur[hidden] { display: none; }
  .compagnon__lanceur:hover { transform: translateY(-2px); background: var(--navy-lift); }

  .compagnon__lanceur:focus-visible {
    outline: 3px solid var(--ocre-vif);
    outline-offset: 2px;
