    background: var(--surface);
    box-shadow: var(--sh-lg);
  }

  .compagnon__fermer {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--sunk);
    color: var(--ink-soft);
    cursor: pointer;
  }

  .compagnon__fermer:hover { color: var(--ink); border-color: var(--ink-mute); }

  .compagnon__oeil {
    margin: 0 2.2rem 0.25rem 0;
    color: var(--navy-lift);
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .compagnon__titre:focus { outline: none; }

  .compagnon__titre {
