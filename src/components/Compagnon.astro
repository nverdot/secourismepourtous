];

const POSES = [...new Set(ECRANS.map((e) => e.pose))];
const accueil = ECRANS[0];

/*
 * Le script n'a besoin que de l'en-tête de chaque écran : les listes de choix
 * sont déjà dans le HTML. Sans ce tri, les treize écrans voyageaient deux fois
 * dans la page — 2 Ko compressés pour rien.
 */
const ENTETES = ECRANS.map(({ id, pose, oeil, titre, message }) => ({ id, pose, oeil, titre, message }));
---

<div class="compagnon" id="compagnon" data-ecran="accueil" data-poses={POSES.join(' ')}>
  <button
    class="compagnon__lanceur"
    id="compagnon-lanceur"
    type="button"
    aria-haspopup="dialog"
    aria-controls="compagnon-boite"
    aria-expanded="false"
  >
    <img src="/compagnon/lanceur.webp" width="128" height="128" alt="" decoding="async" />
    <span>Besoin d’aide&nbsp;?</span>
  </button>

  <section
    class="compagnon__boite"
    id="compagnon-boite"
    role="dialog"
    aria-modal="false"
    aria-labelledby="compagnon-titre"
    hidden
  >
    <div class="compagnon__perso" aria-hidden="true">
      {/* « lazy » sur une image cachée : le navigateur ne la cherche qu'à
          l'ouverture. Le script la devance dès que la souris approche. */}
      <img
        id="compagnon-perso"
        src={`/compagnon/${accueil.pose}.webp`}
        width="440"
        height="475"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="compagnon__panneau">
      <button class="compagnon__fermer" id="compagnon-fermer" type="button" aria-label="Fermer le compagnon">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

      <p class="compagnon__oeil" id="compagnon-oeil">{accueil.oeil}</p>
      <h2 class="compagnon__titre" id="compagnon-titre" tabindex="-1">{accueil.titre}</h2>
      <p class="compagnon__message" id="compagnon-message">{accueil.message}</p>

      {/*
        Les listes d'actions sont rendues au build, une par écran, puis
        montrées à tour de rôle. Les fabriquer en JavaScript les priverait du
        style : Astro porte ses règles par un attribut « data-astro-cid-… »
        qu'un élément créé par script n'a pas.
      */}
      {ECRANS.map((e) => (
        <div class="compagnon__actions" data-actions={e.id} hidden={e.id !== 'accueil'}>
          {e.actions.map((a) => {
            const contenu = (
              <>
                <svg class="compagnon__icone" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"
                     fill={PLEINES.has(a.icone) ? 'currentColor' : 'none'}
                     stroke={PLEINES.has(a.icone) ? 'none' : 'currentColor'}
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d={ICONES[a.icone]} />
                </svg>
                <span class="compagnon__action-texte">{a.texte}</span>
                {a.note && <small>{a.note}</small>}
              </>
            );
            return a.vers ? (
              <a class="compagnon__action" href={a.vers}>{contenu}</a>
            ) : (
              <button class="compagnon__action" type="button" data-ecran={a.ecran}>
                {contenu}
                <svg class="compagnon__chevron" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
                     fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                  <path d="M9 5l7 7-7 7" />
                </svg>
              </button>
            );
          })}
        </div>
      ))}

      <button class="compagnon__retour" id="compagnon-retour" type="button" hidden>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <path d="M15 5l-7 7 7 7" />
        </svg>
        Revenir au début
      </button>
    </div>
  </section>
</div>

<script is:inline define:vars={{ ENTETES }}>
  (() => {
    const racine = document.getElementById('compagnon');
    if (!racine) return;

    const lanceur = document.getElementById('compagnon-lanceur');
    const boite = document.getElementById('compagnon-boite');
    const perso = document.getElementById('compagnon-perso');
    const oeil = document.getElementById('compagnon-oeil');
    const titre = document.getElementById('compagnon-titre');
    const message = document.getElementById('compagnon-message');
    const retour = document.getElementById('compagnon-retour');
    const fermer = document.getElementById('compagnon-fermer');
    const groupes = [...racine.querySelectorAll('[data-actions]')];

    const parId = Object.fromEntries(ENTETES.map((e) => [e.id, e]));
    let precharge = false;

    /* Les poses ne partent qu'à l'approche : survol, focus clavier, ou à
       défaut l'ouverture elle-même. Le premier écran est donc déjà en cache
       au moment où le panneau s'ouvre. */
    function prechargerPoses() {
      if (precharge) return;
      precharge = true;
      racine.dataset.poses.split(' ').forEach((p) => {
        const img = new Image();
        img.decoding = 'async';
        img.src = `/compagnon/${p}.webp`;
      });
    }

    /* « focus » n'est vrai que sur une navigation voulue : l'écran d'accueil
       rendu au build ne doit pas voler le focus au chargement de la page.
       Sans cela, cliquer un choix détruit le bouton qui portait le focus et
       le clavier repart à zéro sur le document. */
    function afficher(id, focus) {
      const e = parId[id] || parId.accueil;
      racine.dataset.ecran = e.id;
      oeil.textContent = e.oeil;
      titre.textContent = e.titre;
      message.textContent = e.message;
      perso.src = `/compagnon/${e.pose}.webp`;
      groupes.forEach((g) => (g.hidden = g.dataset.actions !== e.id));
      retour.hidden = e.id === 'accueil';
      if (focus) titre.focus({ preventScroll: true });
    }

    function ouvrir() {
      prechargerPoses();
      boite.hidden = false;
      lanceur.hidden = true;
      lanceur.setAttribute('aria-expanded', 'true');
      afficher('accueil');
      fermer.focus({ preventScroll: true });
      try {
        localStorage.setItem('compagnon-vu', '1');
      } catch {
        /* navigation privée, stockage refusé : sans conséquence ici */
      }
    }

    function refermer() {
      boite.hidden = true;
      lanceur.hidden = false;
      lanceur.setAttribute('aria-expanded', 'false');
      lanceur.focus({ preventScroll: true });
    }

    lanceur.addEventListener('click', ouvrir);
    lanceur.addEventListener('pointerenter', prechargerPoses, { once: true });
    lanceur.addEventListener('focus', prechargerPoses, { once: true });
    fermer.addEventListener('click', refermer);
    retour.addEventListener('click', () => afficher('accueil', true));

    racine.addEventListener('click', (ev) => {
      const b = ev.target.closest('button[data-ecran]');
      if (b) afficher(b.dataset.ecran, true);
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && !boite.hidden) refermer();
    });

    /* Première visite : un salut discret sur le lanceur, une seule fois, et
       jamais d'ouverture automatique — la page appartient au visiteur. */
    try {
      if (!localStorage.getItem('compagnon-vu')) racine.dataset.salut = '1';
    } catch {
      /* stockage refusé : pas de salut, pas de gêne */
    }

    window.Compagnon = Object.freeze({ ouvrir, fermer: refermer, afficher });
  })();
</script>

<style>
  .compagnon {
    --compagnon-marge: max(1rem, env(safe-area-inset-bottom));
