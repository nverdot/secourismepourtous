---
/**
 * Compagnon d'orientation, ancré en bas à droite de chaque page.
 *
 * Le personnage et les poses viennent du paquet FFSS « compagnon statique ».
 * Deux écarts assumés par rapport à sa spécification :
 *
 * 1. Les neuf PNG d'origine pèsent 5,4 Mo et la spécification demande de tous
 *    les précharger. L'accueil du site fait 9,5 Ko : on aurait multiplié son
 *    poids par cinq cents. Les poses sont donc converties en WebP au format
 *    d'affichage (212 Ko à sept), et seul l'avatar du lanceur — 6 Ko — part
 *    avec la page. Les poses ne sont cherchées qu'à l'approche du lanceur.
 *
 * 2. Cinq poses sur neuf sont retenues, remises à la même hauteur de tête et
 *    à la même ligne des yeux — faute de quoi « idle » (plan en pied) et
 *    « think » (plan poitrine) faisaient sauter le personnage du simple au
 *    double d'un écran à l'autre.
 *
 *    Les quatre écartées le sont pour une raison de place ou de cadrage :
 *    « point-left » et « point-right » demandent 186 px de large pour une tête
 *    de 38 px, et le bras tendu sortait toujours de l'écran sur un téléphone ;
 *    « alert » et « speaking » sont des gros plans qui s'arrêtent sous le col,
 *    sans buste à montrer, et donnaient un personnage tronqué au ras du sol.
 *    L'écran d'urgence prend donc « idle », la seule pose en pied — et un
 *    secouriste calme, debout, y vaut mieux qu'un visage inquiet.
 *
 * 3. Deux visages, tirés au sort à chaque visite (Base.astro) : l'homme
 *    (public/compagnon/) et la femme (public/compagnon/femme/, paquet
 *    « Compagnon FFSS femme, 9 poses », septembre 2026). Les poses de la femme
 *    reprennent exactement le cadrage de celles de l'homme — même taille de
 *    tête, même ligne du haut, tête centrée —, mesuré sur les originaux : le
 *    personnage garde sa place quel que soit le visage tiré.
 */

import { ICONES, PLEINES, ECRANS } from '../data/compagnon';

const POSES = [...new Set(ECRANS.map((e) => e.pose))];
const accueil = ECRANS[0];

/*
 * Le script n'a besoin que de l'en-tête de chaque écran : les listes de choix
 * sont déjà dans le HTML. Sans ce tri, les treize écrans voyageaient deux fois
 * dans la page — 2 Ko compressés pour rien.
 */
const ENTETES = ECRANS.map(({ id, pose, oeil, titre, message }) => ({ id, pose, oeil, titre, message }));
---

<div class="compagnon" id="compagnon" data-ecran="accueil" data-poses={POSES.join(' ')}>
  {/*
    Le voile détache le menu de la page et donne une cible pour refermer :
    cliquer dans le vide referme, ce qui est le geste qu'on essaie d'abord.
  */}
  <div class="compagnon__voile" id="compagnon-voile"></div>

  {/* Sur téléphone, le lanceur se réduit à un rond : la bulle dit une fois
      par session ce que ce rond propose. */}
  <span class="compagnon__bulle" aria-hidden="true">Besoin d’aide&nbsp;?</span>

  <button
    class="compagnon__lanceur"
    id="compagnon-lanceur"
    type="button"
    aria-haspopup="dialog"
    aria-controls="compagnon-boite"
    aria-expanded="false"
    aria-label="Besoin d’aide ?"
  >
    <img src="/compagnon/lanceur.webp" width="128" height="128" alt="" decoding="async" />
    <script is:inline>
      if (document.documentElement.dataset.compagnon === 'femme')
        document.currentScript.previousElementSibling.src = '/compagnon/femme/lanceur.webp';
    </script>
  </button>

  <section
    class="compagnon__boite"
    id="compagnon-boite"
    role="dialog"
    aria-modal="false"
    aria-labelledby="compagnon-titre"
    hidden
  >
    {/* Sur téléphone, le panneau devient l'écran d'accueil de l'application :
        il porte alors la marque et les agréments, que le panneau flottant de
        l'ordinateur n'a pas à répéter par-dessus la page. */}
    <div class="compagnon__entete" aria-hidden="true">
      <img src="/img/logo-spt.png" width="34" height="40" alt="" decoding="async" />
      <span>Secourisme <em>Pour Tous</em></span>
    </div>
    <p class="compagnon__preuve">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
           stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3.2l7 2.8v5.4c0 4.2-2.9 7.3-7 9.4-4.1-2.1-7-5.2-7-9.4V6z" /><path d="M9 12l2 2 4-4" />
      </svg>
      <span><strong>Association agréée sécurité civile</strong>Certifiée Qualiopi · Affiliée FFSS</span>
    </p>

    <div class="compagnon__perso" aria-hidden="true">
      {/* « lazy » sur une image cachée : le navigateur ne la cherche qu'à
          l'ouverture. Le script la devance dès que la souris approche. */}
      <img
        id="compagnon-perso"
        src={`/compagnon/${accueil.pose}.webp`}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="compagnon__panneau">
      <button class="compagnon__fermer" id="compagnon-fermer" type="button" aria-label="Fermer le compagnon">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

      <p class="compagnon__oeil" id="compagnon-oeil">{accueil.oeil}</p>
      <h2 class="compagnon__titre" id="compagnon-titre" tabindex="-1">{accueil.titre}</h2>
      <p class="compagnon__message" id="compagnon-message">{accueil.message}</p>

      {/*
        Les listes d'actions sont rendues au build, une par écran, puis
        montrées à tour de rôle. Les fabriquer en JavaScript les priverait du
        style : Astro porte ses règles par un attribut « data-astro-cid-… »
        qu'un élément créé par script n'a pas.
      */}
      {ECRANS.map((e) => (
        <div class="compagnon__actions" data-actions={e.id} hidden={e.id !== 'accueil'}>
          {e.actions.map((a) => {
            const contenu = (
              <>
                <svg class="compagnon__icone" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"
                     fill={PLEINES.has(a.icone) ? 'currentColor' : 'none'}
                     stroke={PLEINES.has(a.icone) ? 'none' : 'currentColor'}
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d={ICONES[a.icone]} />
                </svg>
                <span class="compagnon__action-texte">{a.texte}</span>
                {a.note && <small>{a.note}</small>}
              </>
            );
            return a.vers ? (
              <a class="compagnon__action" href={a.vers}>{contenu}</a>
            ) : (
              <button class="compagnon__action" type="button" data-ecran={a.ecran}>
                {contenu}
                <svg class="compagnon__chevron" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
                     fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                  <path d="M9 5l7 7-7 7" />
                </svg>
              </button>
            );
          })}
        </div>
      ))}

      <button class="compagnon__retour" id="compagnon-retour" type="button" hidden>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <path d="M15 5l-7 7 7 7" />
        </svg>
        Revenir au début
      </button>

      {/* Plein écran, la croix ne suffit plus comme sortie : on la cherche en
          haut quand on vient de lire en bas. */}
      <button class="compagnon__passer" id="compagnon-passer" type="button">
        Continuer vers le site
      </button>
    </div>
  </section>
</div>

<script is:inline define:vars={{ ENTETES }}>
  (() => {
    const racine = document.getElementById('compagnon');
    if (!racine) return;

    const lanceur = document.getElementById('compagnon-lanceur');
    const boite = document.getElementById('compagnon-boite');
    const perso = document.getElementById('compagnon-perso');
    const oeil = document.getElementById('compagnon-oeil');
    const titre = document.getElementById('compagnon-titre');
    const message = document.getElementById('compagnon-message');
    const retour = document.getElementById('compagnon-retour');
    const fermer = document.getElementById('compagnon-fermer');
    const voile = document.getElementById('compagnon-voile');
    const groupes = [...racine.querySelectorAll('[data-actions]')];

    const parId = Object.fromEntries(ENTETES.map((e) => [e.id, e]));
    /* Le visage tiré au sort pour la visite (voir Base.astro). */
    const dossier = document.documentElement.dataset.compagnon === 'femme' ? '/compagnon/femme/' : '/compagnon/';
    let precharge = false;

    /* Les poses ne partent qu'à l'approche : survol, focus clavier, ou à
       défaut l'ouverture elle-même. Le premier écran est donc déjà en cache
       au moment où le panneau s'ouvre. */
    function prechargerPoses() {
      if (precharge) return;
      precharge = true;
      racine.dataset.poses.split(' ').forEach((p) => {
        const img = new Image();
        img.decoding = 'async';
        img.src = `${dossier}${p}.webp`;
      });
    }

    /* « focus » n'est vrai que sur une navigation voulue : l'écran d'accueil
       rendu au build ne doit pas voler le focus au chargement de la page.
       Sans cela, cliquer un choix détruit le bouton qui portait le focus et
       le clavier repart à zéro sur le document. */
    /*
     * Le message s'écrit lettre à lettre, comme la réplique d'un personnage
     * de jeu : d'un écran à l'autre la bulle et les boutons se ressemblent,
     * et sans ce mouvement on ne voyait pas que la réponse avait changé.
     *
     * Les lecteurs d'écran n'entendent pas la frappe : le texte entier est
     * posé d'emblée dans une copie masquée (« vh »), la frappe visible leur
     * est cachée. Toucher la bulle termine la phrase d'un coup. Et qui a
     * demandé à limiter les animations lit le texte entier, tout de suite.
     */
    const sobre = matchMedia('(prefers-reduced-motion: reduce)');
    let frappe = 0;
    let finir = () => {};

    function taper(texte) {
      clearTimeout(frappe);
      const lu = document.createElement('span');
      lu.className = 'vh';
      lu.textContent = texte;
      /* Le reste de la phrase est déjà là, transparent : la bulle prend
         d'emblée sa taille finale, et rien ne saute pendant la frappe. */
      const vu = document.createElement('span');
      vu.setAttribute('aria-hidden', 'true');
      const ecrit = document.createElement('span');
      ecrit.className = 'compagnon__frappe';
      const reste = document.createElement('span');
      reste.className = 'compagnon__reste';
      vu.append(ecrit, reste);
      message.replaceChildren(lu, vu);
      finir = () => {
        clearTimeout(frappe);
        ecrit.textContent = texte;
        reste.textContent = '';
        ecrit.classList.add('est-fini');
      };
      if (sobre.matches) return finir();
      /* Une lettre toutes les 28 ms, soit le rythme d'une réplique qu'on lit
         en même temps qu'elle s'écrit ; un temps après la ponctuation, comme
         une voix qui reprend son souffle. */
      let i = 0;
      const pas = () => {
        i += 1;
        ecrit.textContent = texte.slice(0, i);
        reste.textContent = texte.slice(i);
        if (i >= texte.length) return finir();
        const c = texte[i - 1];
        frappe = setTimeout(pas, '.?!…'.includes(c) ? 260 : ',:;'.includes(c) ? 130 : 28);
      };
      pas();
    }
    message.addEventListener('click', () => finir());

    function afficher(id, focus) {
      const e = parId[id] || parId.accueil;
      racine.dataset.ecran = e.id;
      oeil.textContent = e.oeil;
      titre.textContent = e.titre;
      taper(e.message);
      perso.src = `${dossier}${e.pose}.webp`;
      groupes.forEach((g) => (g.hidden = g.dataset.actions !== e.id));
      retour.hidden = e.id === 'accueil';

      /* La bulle « rebondit » à chaque nouvel écran : on retire l'attribut,
         on force le navigateur à en prendre acte, et on le remet — sans quoi
         l'animation ne rejouerait pas. */
      delete racine.dataset.change;
      void racine.offsetWidth;
      racine.dataset.change = '1';

      /* Sur téléphone, le choix se fait en bas de l'écran : l'écran suivant
         repart du haut, sur la bulle, pour qu'on voie la nouvelle réplique. */
      if (focus) {
        racine.scrollTo({ top: 0, behavior: sobre.matches ? 'auto' : 'smooth' });
        groupes.forEach((g) => (g.scrollTop = 0));
        titre.focus({ preventScroll: true });
      }
    }

    function ouvrir() {
      prechargerPoses();
      boite.hidden = false;
      lanceur.hidden = true;
      racine.dataset.ouvert = '1';
      lanceur.setAttribute('aria-expanded', 'true');
      afficher('accueil');
      fermer.focus({ preventScroll: true });
      delete racine.dataset.salut;
      delete racine.dataset.bulle;
      bulles = BULLES;
    }

    function refermer() {
      boite.hidden = true;
      lanceur.hidden = false;
      delete racine.dataset.ouvert;
      lanceur.setAttribute('aria-expanded', 'false');
      lanceur.focus({ preventScroll: true });
    }

    lanceur.addEventListener('click', () => ouvrir());
    lanceur.addEventListener('pointerenter', prechargerPoses, { once: true });
    lanceur.addEventListener('focus', prechargerPoses, { once: true });
    fermer.addEventListener('click', refermer);
    document.getElementById('compagnon-passer')?.addEventListener('click', refermer);
    voile.addEventListener('click', refermer);
    retour.addEventListener('click', () => afficher('accueil', true));

    racine.addEventListener('click', (ev) => {
      const b = ev.target.closest('button[data-ecran]');
      if (b) afficher(b.dataset.ecran, true);
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && !boite.hidden) refermer();
    });

    /*
     * Deux gestes, deux rythmes.
     *
     * Le petit salut de la main rejoue à chaque page : il dure trois secondes,
     * ne déplace rien, et c'est lui qui fait remarquer le lanceur.
     *
     * La bulle « Besoin d'aide ? » revient trois fois par page, cinq secondes
     * à chaque passage, puis se tait. Une seule apparition se rate : on est en
     * train de lire ailleurs. Trois, espacées d'une demi-minute, se
     * remarquent sans occuper l'écran — et la troisième est la dernière, parce
     * qu'au-delà ce n'est plus une proposition, c'est du harcèlement.
     *
     * Jamais d'ouverture automatique : la page appartient au visiteur. Sur
     * téléphone, l'accueil du site reprend le premier écran du Compagnon dans
     * la page même (AccueilCompagnon.astro), au lieu de l'ouvrir par-dessus —
     * une fenêtre qui masque le contenu à l'arrivée, Google la pénalise.
     * Rien n'est stocké, ni d'une page à l'autre ni d'une visite à l'autre.
     */
    racine.dataset.salut = '1';
    setTimeout(() => delete racine.dataset.salut, 6000);

    const BULLES = 3;
    let bulles = 0;

    function proposer() {
      /* Rien pendant que le panneau est ouvert : la question est déjà posée. */
      if (bulles >= BULLES || !boite.hidden) return;
      bulles += 1;
      racine.dataset.bulle = '1';
      setTimeout(() => {
        delete racine.dataset.bulle;
        if (bulles < BULLES) setTimeout(proposer, 26000);
      }, 5200);
    }

    setTimeout(proposer, 1200);

    window.Compagnon = Object.freeze({ ouvrir, fermer: refermer, afficher });
  })();
</script>

<style>
  .compagnon {
    --compagnon-marge: max(1rem, env(safe-area-inset-bottom));
    --perso-h: 238px;   /* hauteur commune à toutes les poses */
    --perso-x: 110px;   /* où retombe le milieu de la tête */
    position: fixed;
    z-index: 900;
    right: max(1rem, env(safe-area-inset-right));
    bottom: var(--compagnon-marge);
  }

  /* --- le lanceur --- */

  /*
   * Le jaune fédéral, et pas le marine : le lanceur traverse des sections
   * blanches et des sections marine, et un pastille marine disparaissait
   * purement et simplement sur le héros. Le jaune tient sur les deux fonds —
   * c'est d'ailleurs la haute visibilité du polo. Il ne porte que de l'encre
   * sombre : à 1,68:1 sur blanc, il ne peut pas servir de couleur de texte.
   */
  .compagnon__lanceur {
    display: block;
    padding: 0.32rem;
    border: 0;
    border-radius: 50%;
    background: var(--ocre-vif);
    box-shadow: var(--sh-md);
    cursor: pointer;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }

  .compagnon__lanceur[hidden] { display: none; }

  .compagnon__lanceur:hover {
    transform: translateY(-2px);
    box-shadow: var(--sh-lg);
  }

  .compagnon__lanceur:focus-visible {
    outline: 3px solid var(--navy-deep);
    outline-offset: 2px;
  }

  .compagnon__lanceur img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--surface);
    object-fit: cover;
  }

  /* Le rond blanc du téléphone se passe du liseré, qui l'épaissirait. */
  .compagnon__lanceur:focus-visible img { background: var(--surface); }

  /*
   * Le rond n'affiche plus de libellé : c'est la bulle qui dit, une fois par
   * session, ce qu'il propose.
   */
  .compagnon__bulle { display: none; }

  .compagnon[data-bulle] .compagnon__bulle {
    position: absolute;
    right: 6px;
    bottom: calc(100% + 0.6rem);
    display: block;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: var(--sh-md);
    color: var(--navy-deep);
    font-family: 'Archivo', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    animation: compagnon-bulle 5.2s ease-out both;
  }

  .compagnon[data-bulle] .compagnon__bulle::after {
    position: absolute;
    right: 24px;
    top: 100%;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border: 1px solid var(--line);
    border-width: 0 1px 1px 0;
    background: var(--surface);
    content: '';
    transform: rotate(45deg);
  }

  /*
   * Le voile détache le menu de la page, et cliquer dedans referme. Le z-index
   * négatif le place derrière le panneau sans le sortir de la pile du
   * compagnon : il reste donc au-dessus de la page.
   */
  .compagnon__voile { display: none; }

  .compagnon[data-ouvert] .compagnon__voile {
    position: fixed;
    z-index: -1;
    inset: 0;
    display: block;
    background: rgba(7, 23, 38, 0.22);
    backdrop-filter: blur(2px);
    animation: compagnon-voile 0.2s ease-out both;
  }

  /* Le salut d'ouverture de session : deux oscillations, puis plus rien. */
  .compagnon[data-salut] .compagnon__lanceur img {
    animation: compagnon-salut 1.5s ease-in-out 1s 2;
    transform-origin: 50% 88%;
  }

  @keyframes compagnon-voile {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes compagnon-bulle {
    0% { opacity: 0; transform: translateY(6px); }
    9%, 86% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(4px); }
  }

  @keyframes compagnon-salut {
    0%, 55%, 100% { transform: rotate(0); }
    65% { transform: rotate(-10deg); }
    75% { transform: rotate(9deg); }
    85% { transform: rotate(-5deg); }
    93% { transform: rotate(3deg); }
  }

  /* --- le panneau --- */

  .compagnon__boite {
    display: grid;
    grid-template-columns: 200px minmax(0, 340px);
    align-items: end;
    width: min(540px, calc(100vw - 2rem));
  }

  .compagnon__boite[hidden] { display: none; }

  /* Propres à l'écran plein du téléphone. */
  .compagnon__entete,
  .compagnon__preuve,
  .compagnon__passer { display: none; }

  /*
   * La marge basse négative annule le retrait du widget : le personnage pose
   * les pieds sur le bord de l'écran, sans bande vide dessous, pendant que le
   * panneau, lui, garde sa respiration.
   */
  /*
   * Chaque pose a sa propre largeur de toile — le « bonjour » a besoin d'une
   * main levée, le « bravo » d'un pouce — mais toutes ont la même hauteur et
   * la tête centrée. C'est donc la hauteur qui fixe l'échelle, et la tête
   * retombe toujours sur --perso-x, quelle que soit la largeur de l'image.
   * La marge basse négative annule le retrait du widget : le personnage pose
   * les pieds sur le bord de l'écran pendant que le panneau garde son air.
   */
  .compagnon__perso {
    position: relative;
    z-index: 2;
    height: var(--perso-h);
    pointer-events: none;
  }

  .compagnon__perso img {
    position: absolute;
    bottom: calc(-1 * var(--compagnon-marge));
    left: var(--perso-x);
    transform: translateX(-50%);
    width: auto;
    /* « max-width: 100% » du style global rabattait l'image sur la largeur de
       la colonne et l'écrasait : 254 px de dessin comprimés en 200. */
    max-width: none;
    height: var(--perso-h);
    filter: drop-shadow(0 8px 18px rgba(11, 37, 64, 0.18));
  }

  /*
   * Le retrait gauche doit dépasser le débord du personnage, sinon le texte
   * passe sous lui : 2.7rem contre 35 px de débord.
   */
  .compagnon__panneau {
    position: relative;
    z-index: 1;
    padding: 1.35rem 1.35rem 1.2rem 2.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg) var(--r-lg) var(--r-sm) var(--r-lg);
    background: var(--surface);
    box-shadow: var(--sh-lg);
  }

  .compagnon__fermer {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--sunk);
    color: var(--ink-soft);
    cursor: pointer;
  }

  .compagnon__fermer:hover { color: var(--ink); border-color: var(--ink-mute); }

  .compagnon__oeil {
    margin: 0 2.2rem 0.25rem 0;
    color: var(--navy-lift);
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .compagnon__titre:focus { outline: none; }

  .compagnon__titre {
    margin: 0 2.2rem 0.35rem 0;
    color: var(--navy-deep);
    font-family: 'Archivo', sans-serif;
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.2;
