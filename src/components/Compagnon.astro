  /* --- les choix --- */

  .compagnon__actions {
    display: grid;
    gap: 0.35rem;
    max-height: min(52vh, 420px);
    overflow-y: auto;
  }

  .compagnon__actions[hidden] { display: none; }

  .compagnon__action {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    /*
     * Blanc sur blanc, les choix se confondaient avec le panneau. Le fond
     * creusé du site les détache sans les alourdir ; le survol fait l'inverse,
     * il les soulève en blanc. Le jaune fédéral reste réservé au focus : à
     * 1,68:1 sur blanc il ne peut pas porter de texte.
     */
    background: var(--sunk);
    color: var(--ink);
    font: inherit;
    font-size: 0.88rem;
    text-align: left;
    text-decoration: none;
