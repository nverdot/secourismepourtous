    height: 46px;
    border-radius: 50%;
    background: var(--surface);
    object-fit: cover;
  }

  /* Le salut de première visite : deux oscillations, puis plus rien. */
  .compagnon[data-salut] .compagnon__lanceur img {
    animation: compagnon-salut 1.6s ease-in-out 1.2s 2;
    transform-origin: 50% 85%;
  }

  @keyframes compagnon-salut {
    0%, 60%, 100% { transform: rotate(0); }
    70% { transform: rotate(-7deg); }
    80% { transform: rotate(6deg); }
    90% { transform: rotate(-4deg); }
  }

  /* --- le panneau --- */

  .compagnon__boite {
    display: grid;
    grid-template-columns: 200px minmax(0, 340px);
    align-items: end;
    width: min(540px, calc(100vw - 2rem));
  }

  .compagnon__boite[hidden] { display: none; }

  /*
   * La marge basse négative annule le retrait du widget : le personnage pose
