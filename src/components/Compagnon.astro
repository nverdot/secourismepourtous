    column-gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    /*
     * Blanc sur blanc, les choix se confondaient avec le panneau. Le fond
