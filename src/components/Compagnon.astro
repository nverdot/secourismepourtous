  .compagnon[data-ecran='urgence'] .compagnon__panneau {
    border: 2px solid var(--secours);
  }

  .compagnon[data-ecran='urgence'] .compagnon__oeil,
  .compagnon[data-ecran='urgence'] .compagnon__titre,
  .compagnon[data-ecran='urgence'] .compagnon__icone { color: var(--secours); }

  .compagnon[data-ecran='urgence'] .compagnon__action {
