   */
  .compagnon__perso {
    position: relative;
    z-index: 2;
    margin-right: -35px;
    margin-bottom: calc(-1 * var(--compagnon-marge));
    margin-left: -15px;
    pointer-events: none;
  }

  /*
   * 250 px pour une toile de 500 : la tête fait donc 75 px à l'écran. La toile
   * a été élargie de 440 à 500 px parce que la main levée du « bonjour » et le
   * pouce du « bravo » sortaient du cadre ; les 15 px de marge gauche négative
   * annulent l'élargissement et laissent le buste exactement où il était.
   */
  .compagnon__perso img {
    display: block;
    width: 250px;
    height: auto;
    filter: drop-shadow(0 8px 18px rgba(11, 37, 64, 0.18));
  }

  /*
   * Le retrait gauche doit dépasser le débord du personnage, sinon le texte
