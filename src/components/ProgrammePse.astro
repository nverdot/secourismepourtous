---
import { chapitresDe, volume, referentielPse } from '../data/programme-pse';

/**
 * Programme détaillé du PSE1 ou du PSE2, tel que le référentiel le fixe.
 *
 * Affiché en entier plutôt qu'en résumé : c'est la pièce qu'un employeur, un
 * financeur ou un auditeur Qualiopi vient chercher, et c'est aussi ce qui
 * départage deux organismes aux yeux de quelqu'un qui hésite. Un programme
 * précis se vérifie ; une liste de six puces ne prouve rien.
 *
 * Sur une page PSE2, les acquis du PSE1 sont rappelés en second plan : le
 * PSE2 ne remplace pas le PSE1, il s'y ajoute, et la page doit le montrer.
 */

interface Props {
  niveau: 'pse1' | 'pse2';
}
const { niveau } = Astro.props;

const sigle = niveau === 'pse1' ? 'PSE1' : 'PSE2';
const liste = chapitresDe(niveau);
const v = volume(niveau);
---

<section class="prog" aria-labelledby="t-prog">
  <p class="eyebrow">Programme officiel</p>
  <h2 class="h-section" id="t-prog">Ce que vous travaillez en {sigle}</h2>
  <p class="lede">
    Le contenu du {sigle} est fixé par le référentiel national : il est le même
    partout en France. Voici, chapitre par chapitre, ce que vous y travaillez.
  </p>

  <dl class="chiffres">
    <div><dt>Chapitres</dt><dd>{v.chapitres}</dd></div>
    <div><dt>Sujets traités</dt><dd>{v.sujets}</dd></div>
    <div><dt>Techniques pratiquées</dt><dd>{v.techniques}</dd></div>
  </dl>

  <ol class="chaps">
    {liste.map((c) => (
      <li class="chap">
        <div class="chap__tete">
          <span class="chap__n">{c.numero}</span>
          <div>
            <h3>{c.nom}</h3>
            <p class="chap__e">{c.enjeu}</p>
          </div>
        </div>

        {c[niveau].length > 0 && (
          <ul class="sujets">
            {c[niveau].map((s) => <li>{s}</li>)}
          </ul>
        )}

        {/* Sur la page PSE2, on rappelle ce que le PSE1 couvrait déjà : le
            visiteur comprend que les deux niveaux s'empilent. */}
        {niveau === 'pse2' && c.pse1.length > 0 && (
          <p class="rappel">
            <strong>Déjà vu en PSE1&nbsp;:</strong> {c.pse1.join(', ').toLowerCase()}.
          </p>
        )}

        {c.techniques[niveau] > 0 && (
          <p class="tech">
            {c.techniques[niveau]} technique{c.techniques[niveau] > 1 ? 's' : ''} pratiquée{c.techniques[niveau] > 1 ? 's' : ''} en mise en situation
          </p>
        )}
      </li>
    ))}
  </ol>

  <p class="source">
    Source&nbsp;: {referentielPse.nom}, {referentielPse.edition},
    {' '}{referentielPse.auteur}.
  </p>
</section>

<style>
  .prog { padding-block: 0; }

  .chiffres {
    margin: 2rem 0 0; display: grid; gap: .8rem;
    grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr));
  }
  .chiffres > div {
    background: var(--sunk); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 1rem 1.2rem;
  }
  .chiffres dt {
    font-family: 'Archivo', sans-serif; font-size: .68rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--ink-mute);
    margin-bottom: .25rem;
  }
  .chiffres dd {
    margin: 0; font-family: 'Archivo', sans-serif; font-size: 1.9rem;
    font-weight: 800; line-height: 1; color: var(--azur);
    font-variant-numeric: tabular-nums;
  }

  .chaps { list-style: none; margin: 2rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .chap {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(1.25rem, 3vw, 1.6rem);
  }

  .chap__tete { display: flex; gap: 1rem; align-items: flex-start; }
  .chap__n {
    flex: none; width: 38px; height: 38px; border-radius: 11px;
    background: var(--secours); color: #fff;
    display: grid; place-items: center;
    font-family: 'Archivo', sans-serif; font-weight: 800; font-size: .92rem;
    font-variant-numeric: tabular-nums;
  }
  .chap h3 { font-size: 1.08rem; font-weight: 700; margin-bottom: .3rem; }
  .chap__e { font-size: .91rem; color: var(--ink-soft); }

  .sujets {
    list-style: none; margin: 1rem 0 0; padding: 0 0 0 calc(38px + 1rem);
    display: grid; gap: .4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
  }
  @media (max-width: 620px) { .sujets { padding-left: 0; } }
  .sujets li {
    position: relative; padding-left: 1.05rem;
    font-size: .91rem; color: var(--ink);
  }
  .sujets li::before {
    content: ''; position: absolute; left: 0; top: .6em;
    width: 5px; height: 5px; border-radius: 50%; background: var(--azur);
  }

  .rappel {
    margin: .9rem 0 0 calc(38px + 1rem);
    font-size: .86rem; color: var(--ink-mute);
    padding: .6rem .85rem; background: var(--sunk); border-radius: var(--r-sm);
  }
  @media (max-width: 620px) { .rappel { margin-left: 0; } }
  .rappel strong { color: var(--ink-soft); }

  .tech {
    margin: .8rem 0 0 calc(38px + 1rem);
    font-family: 'Archivo', sans-serif; font-size: .74rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase; color: var(--secours);
  }
  @media (max-width: 620px) { .tech { margin-left: 0; } }

  .source {
    margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--line);
    font-size: .84rem; color: var(--ink-mute); max-width: 80ch;
  }
</style>
