---
import { annonce } from '../lib/annonce';

/** Bandeau d'annonce, tout en haut de chaque page. Le contenu vient de src/lib/annonce.ts. */
const a = await annonce();
// Sur la fiche elle-même, l'annonce ferait doublon avec les dates.
const surLaFiche = a !== null && Astro.url.pathname.replace(/\.html$|\/$/, '') === `/formations/${a.slug}`;
---

{a && !surLaFiche && (
  <a class="annonce" href={a.url}>
    <span class="wrap annonce__in">
      <span class="annonce__new">Nouveau</span>
      <span class="annonce__txt">
        <span class="annonce__long">Inscriptions ouvertes : </span><strong>{a.nom}</strong><span class="annonce__long">, prochaine session le</span><span class="annonce__court">, le</span>{' '}<strong>{a.date}</strong>
        <span class="annonce__prix"><strong>{a.tarif}</strong>{' '}{a.tarifNote}</span>
      </span>
      <span class="annonce__cta" aria-hidden="true"><span class="annonce__long">S’inscrire </span>→</span>
    </span>
  </a>
)}

<style>
  .annonce {
    display: block;
    background: var(--ocean, #0e7c86);
    color: #fff;
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.35;
  }
  .annonce:hover .annonce__cta,
  .annonce:focus-visible .annonce__cta { text-decoration: underline; }
  .annonce__in {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    padding-block: 0.6rem;
    text-align: center;
  }
  .annonce__new {
    flex: none;
    background: #fff;
    color: var(--ocean, #0e7c86);
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }
  .annonce__cta { flex: none; font-weight: 700; }
  /* Le tarif se détache du reste : c'est lui qui distingue cette session du
     cursus complet à 900 €. */
  .annonce__prix {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    white-space: nowrap;
  }
  .annonce__court { display: none; }

  /* Sur téléphone, le bandeau tient sur une ligne ou deux : l'essentiel
     (quoi, quand) et la flèche, le reste se lit sur la fiche. */
  @media (max-width: 600px) {
    .annonce__in { flex-wrap: nowrap; justify-content: flex-start; text-align: left; gap: 0.6rem; padding-block: 0.5rem; }
    .annonce__long { display: none; }
    .annonce__court { display: inline; }
    .annonce__txt { flex: 1; min-width: 0; }
    .annonce__prix { margin: 0.2rem 0 0; }
  }
</style>
