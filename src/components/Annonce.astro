---
import { annonce } from '../lib/annonce';

/** Bandeau d'annonce, tout en haut de chaque page. Le contenu vient de src/lib/annonce.ts. */
const a = await annonce();
// Sur la fiche elle-même, l'annonce ferait doublon avec les dates.
const surLaFiche = a !== null && Astro.url.pathname.replace(/\.html$|\/$/, '') === `/formations/${a.slug}`;
---

{a && !surLaFiche && (
  <a class="annonce" href={a.url}>
    <span class="wrap annonce__in">
      <span class="annonce__new">Nouveau</span>
      <span class="annonce__txt">
        <span class="annonce__new annonce__new--court">Nouveau</span>{' '}
        <strong>{a.nom}</strong><span>, le</span>{' '}<strong>{a.date}</strong>
        <span class="annonce__prix-groupe">
          {a.tarifs.map((t) => (
            <span class="annonce__prix"><strong>{t.prix}</strong>{' '}<span class="annonce__long">{t.note}</span><span class="annonce__court">{t.court}</span></span>
          ))}
        </span>
      </span>
      <span class="annonce__cta" aria-hidden="true"><span class="annonce__long">S’inscrire </span>→</span>
    </span>
  </a>
)}

<style>
  /* Le rouge du site, celui du bouton « S'engager » : une seule couleur vive
     dans l'en-tête. L'orange essayé le 29/10/2026 jurait avec ce bouton. */
  .annonce {
    display: block;
    background: var(--secours);
    color: #fff;
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.35;
  }
  .annonce:hover .annonce__cta,
  .annonce:focus-visible .annonce__cta { text-decoration: underline; }
  .annonce__in {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    padding-block: 0.6rem;
    text-align: center;
  }
  .annonce__new {
    flex: none;
    background: #fff;
    color: var(--secours);
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }
  .annonce__cta { flex: none; font-weight: 700; }
  .annonce__new--court { display: none; }
  /* Les deux tarifs se détachent du reste : SSA seul à 420 €, ou cursus
     complet avec le PSE1 et le PSE2 à 900 €. */
  .annonce__prix {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    white-space: nowrap;
  }
  .annonce__court { display: none; }
  /* Pas de « Inscriptions ouvertes » : avec deux tarifs en 16 px, la phrase
     ne tenait plus sur une ligne, même sur grand écran (Nicolas, 29/10/2026).
     « Nouveau » et « S'inscrire » le disent déjà. */

  /* Sur téléphone et tablette, le bandeau tient sur une ligne ou deux : l'essentiel
     (quoi, quand) et la flèche, le reste se lit sur la fiche. */
  @media (max-width: 960px) {
    .annonce__in { flex-wrap: nowrap; justify-content: flex-start; text-align: left; gap: 0.6rem; padding-block: 0.5rem; }
    .annonce__long { display: none; }
    .annonce__court { display: inline; }
    .annonce__txt { flex: 1; min-width: 0; }
    /* La pastille « Nouveau » passe dans le texte : la place gagnée tient
       les deux tarifs sur une ligne. */
    .annonce__in > .annonce__new { display: none; }
    .annonce__new--court { display: inline-block; vertical-align: 0.1em; margin-right: 0.2rem; }
    .annonce__prix-groupe { display: flex; flex-wrap: wrap; gap: 0.3rem 0.4rem; margin-top: 0.3rem; }
    .annonce__prix { margin: 0; }
  }
</style>
