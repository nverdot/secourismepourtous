---
import { membres, recueilliLe, ordonner, FICHE_DIPLOME, APPELS, versionnee } from '../data/equipe';
import { parSlug, filieres } from '../data/formations';

/**
 * Couleur d'une étiquette de diplôme, reprise de sa filière.
 *
 * Un PSE1 doit être rouge comme la filière opérationnelle, un BNSSA bleu
 * comme l'aquatique. C'est la même grammaire de couleurs que partout ailleurs
 * sur le site : le visiteur reconnaît la famille avant d'avoir lu le sigle.
 */
const teinte = (diplome: string) => {
  const f = parSlug(FICHE_DIPLOME[diplome] ?? '')?.filiere;
  return f ? filieres[f].couleur : null;
};

/**
 * « Notre équipe » — vignettes cliquables, portrait complet en boîte de dialogue.
 *
 * Pourquoi une boîte plutôt qu'une page par personne : on veut que le visiteur
 * parcoure les visages, en ouvre deux ou trois, et reste sur la page. Une page
 * par membre le ferait sortir à chaque fois, et créerait autant d'URL à
 * maintenir quand quelqu'un s'en va.
 *
 * Sans JavaScript, `<dialog>` ne s'ouvre pas : chaque vignette reste alors un
 * lien vers l'ancre du portrait, qui est bien dans le HTML. Le contenu est
 * lisible dans tous les cas, y compris pour les moteurs de recherche.
 */

interface Props {
  titre?: string;
  intro?: string;
  /**
   * Nombre de portraits à montrer. Omis, on les montre tous.
   *
   * En aperçu, le tirage se fait à la construction du site et non dans le
   * navigateur : pas de scintillement au chargement, pas de saut de mise en
   * page, et le HTML reste le même pour tout le monde — donc indexable. Les
   * visages changent à chaque déploiement, ce qui suffit à faire vivre la page.
   */
  apercu?: number;
  /**
   * N'afficher que les membres tenant ce rôle.
   *
   * Sur une fiche de formation, on veut voir des formateurs — pas un
   * secouriste, si compétent soit-il : le visiteur cherche à savoir qui va
   * l'enseigner. Sur la page d'accueil au contraire, on montre le mélange,
   * parce que c'est lui qui dit ce qu'est l'association.
   */
  role?: string;
  /**
   * Montrer un mur de visages qui défile, au lieu d'une grille de cartes.
   *
   * Sur la page d'accueil, ce qu'on veut faire passer tient en un coup d'œil :
   * l'association est un groupe de gens. Des noms, des métiers et des
   * étiquettes le disent moins bien que des visages. Les vignettes n'y portent
   * donc que la photo, avec un repère « + » pour dire qu'on peut les ouvrir.
   *
   * Deux rangées à contresens, sur toute la largeur de l'écran : le contresens
   * donne le mouvement sans que l'œil ait à suivre quoi que ce soit, et évite
   * le défilé de vitrine d'une rangée unique. Le mouvement s'arrête au survol
   * et au clavier — pour qu'on puisse cliquer — et ne démarre pas du tout si
   * le système demande moins d'animations, où la rangée redevient une simple
   * bande à faire défiler au doigt.
   */
  mur?: boolean;
  /** Où mène « voir toute l'équipe ». */
  lien?: string;
}
const {
  titre = 'Celles et ceux qui font l’association',
  intro = 'Ils tiennent les postes de secours, certains forment, et tous ont une vie à côté — étudiant, surveillant de lycée, responsable en sécurité privée. L’association, c’est eux. Voici leurs mots.',
  apercu,
  role,
  mur = false,
  lien = '/qui-sommes-nous#equipe',
} = Astro.props;

const vivier = role ? membres.filter((m) => m.roles.includes(role)) : membres;
const melange = [...vivier].sort(() => Math.random() - 0.5);

/**
 * Sélection de l'aperçu.
 *
 * Sans filtre de rôle, on force le mélange : au moins un formateur et au moins
 * quelqu'un qui ne l'est pas. Un tirage purement aléatoire finirait par sortir
 * trois formateurs et donnerait de l'association l'image d'un organisme de
 * formation — exactement ce qu'on cherche à corriger.
 */
function choisir(n: number) {
  if (role) return melange.slice(0, n);
  const formateurs = melange.filter((m) => m.roles.includes('Formateur'));
  const terrain = melange.filter((m) => !m.roles.includes('Formateur'));
  const retenus = [...terrain.slice(0, 1), ...formateurs.slice(0, 1)];
  for (const m of melange) {
    if (retenus.length >= n) break;
    if (!retenus.includes(m)) retenus.push(m);
  }
  return retenus.slice(0, n);
}

const montres = mur ? melange : apercu ? choisir(apercu) : vivier;

/**
 * Les deux rangées du mur.
 *
 * Une boucle sans couture veut une piste faite de deux moitiés identiques :
 * l'animation la décale d'exactement la moitié, et l'instant où elle repart de
 * zéro est invisible. Encore faut-il qu'une moitié soit plus large que l'écran,
 * sinon on voit le vide derrière — d'où la répétition, calculée sur l'effectif.
 * Le jour où l'association aura trente portraits, elle vaudra 1 et disparaîtra
 * d'elle-même.
 *
 * La seconde rangée part de la fin, pour qu'on ne lise pas deux fois la même
 * suite de visages à la verticale.
 */
/**
 * Les appels tirés pour cette construction.
 *
 * Il y en a dix en réserve pour six emplacements. Les prendre dans l'ordre de
 * la liste condamnerait les derniers à ne jamais paraître ; on les mélange
 * donc, comme les portraits, et le mur change de discours à chaque
 * déploiement.
 *
 * Un tas par filière, chacun mélangé, puis on sert en tourniquet : les cinq
 * premiers appels portent cinq couleurs différentes, et les cinq suivants
 * aussi. Écarter seulement les doublons voisins ne suffisait pas — une rangée
 * n'affiche que quelques appels, et « océan, ocre, océan » y sortait, ce qui
 * mettait deux tiers d'une rangée dans la même couleur.
 */
const appels = (() => {
  const tas = new Map<string, typeof APPELS>();
  [...APPELS].sort(() => Math.random() - 0.5).forEach((a) => {
    if (!tas.has(a.ton)) tas.set(a.ton, []);
    tas.get(a.ton)!.push(a);
  });
  const piles = [...tas.values()].sort(() => Math.random() - 0.5);
  const suite: typeof APPELS = [];
  for (let tour = 0; suite.length < APPELS.length; tour++) {
    for (const pile of piles) if (pile[tour]) suite.push(pile[tour]);
  }
  return suite;
})();

/**
 * Une moitié de piste : des groupes de visages, chacun suivi d'un appel.
 *
 * La règle a d'abord été « un appel par tour complet de l'équipe ». Elle tenait
 * à six portraits ; à quinze, l'appel ne revenait plus que toutes les deux
 * minutes, et la piste portait cent vingt vignettes. Le rythme doit dépendre de
 * ce qu'on voit passer, pas de l'effectif : un appel tous les six visages.
 *
 * La moitié doit rester plus large que l'écran, sinon la boucle laisse voir le
 * vide derrière. Six visages et un appel font environ 1 300 pixels ; on répète
 * jusqu'à dépasser la largeur d'un très grand écran.
 */
const PAR_GROUPE = 6;
const MIN_VIGNETTES = 15;

type Case = { m?: (typeof montres)[number]; appel?: (typeof appels)[number]; double?: boolean };
const rangee = (source: typeof montres, decalage: number): Case[] => {
  const demi: Case[] = [];
  let appel = decalage;
  // On découpe la liste en tranches plutôt que de boucler dessus : à seize
  // portraits et six par groupe, une boucle repartait au début avant d'avoir
  // épuisé la liste, et deux visages revenaient deux fois dans la même
  // demi-piste — visible d'un coup d'œil sur une rangée.
  for (let i = 0; i < source.length; i += PAR_GROUPE) {
    source.slice(i, i + PAR_GROUPE).forEach((m) => demi.push({ m }));
    demi.push({ appel: appels[appel++ % appels.length] });
  }
  // Si l'effectif ne suffit pas à couvrir la largeur d'un écran, on répète.
  const base = [...demi];
  while (demi.length < MIN_VIGNETTES) demi.push(...base);
  // Deux moitiés : la première porte les vignettes réelles, la seconde n'existe
  // que pour l'œil et reste hors du clavier et des lecteurs d'écran.
  return [...demi, ...demi].map((c, i) => ({ ...c, double: i >= demi.length }));
};

/**
 * Trois rangées, chacune dans un ordre différent.
 *
 * La première prend les portraits tels qu'ils sortent du mélange, la deuxième
 * les prend à l'envers, la troisième les fait tourner d'un tiers. Sans ça, les
 * mêmes visages se retrouveraient alignés verticalement à chaque tour — et le
 * mur ressemblerait à un tableau plutôt qu'à une foule.
 *
 * Le décalage des appels suit la même logique : chaque rangée entre dans la
 * liste des messages à un endroit différent.
 */
const tiers = Math.floor(montres.length / 3);
const rangees = mur
  ? [
      rangee(montres, 0),
      rangee([...montres].reverse(), 3),
      rangee([...montres.slice(tiers), ...montres.slice(0, tiers)], 6),
    ]
  : [];

/** Deux blocs peuvent cohabiter sur une même page : la navigation doit rester
    à l'intérieur de son propre groupe de portraits. */
const groupe = `eq-${Math.random().toString(36).slice(2, 8)}`;
---

{montres.length > 0 && (
<div class:list={['eq', mur && 'eq--mur']}>
  <div class:list={[mur && 'wrap']}>
    <p class="eyebrow">Notre équipe</p>
    <h2 class="h-section">{titre}</h2>
    <p class="lede">{intro}</p>
  </div>

  {mur ? (
    /* Le mur déborde volontairement de la colonne de texte : un visage coupé
       par le bord de l'écran dit qu'il y en a d'autres, ce qu'une rangée bien
       centrée dans sa marge ne dit pas. */
    <div class="mur" data-mur>
      {rangees.map((r, n) => (
        <ul class="mur__p" style={`--n:${r.length / 2}`} data-sens={n % 2 ? 'inverse' : 'direct'}>
          {r.map(({ m, appel, double }) => (
            <li class="mur__i">
              {appel ? (
                <a
                  class="fc fc--vous" data-ton={appel.ton} href="/secouriste-actif"
                  tabindex={double ? -1 : undefined}
                  aria-hidden={double ? 'true' : undefined}
                >
                  <span class="fc__vt">{appel.titre}</span>
                  <span class="fc__vs">{appel.sous}</span>
                  {/* Le picto de silhouette qui tenait cette place ne disait
                      rien qu'on ne sache déjà. Un bouton, lui, dit quoi faire :
                      la vignette annonçait une envie sans jamais nommer le
                      geste qui la suit. */}
                  <span class="fc__vb" aria-hidden="true">
                    Nous rejoindre
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </span>
                </a>
              ) : (
              <button
                class="fc" type="button"
                data-groupe={groupe} data-portrait={m!.slug}
                aria-haspopup="dialog"
                aria-label={`Lire le portrait de ${m!.prenom} ${m!.nom}`}
                tabindex={double ? -1 : undefined}
                aria-hidden={double ? 'true' : undefined}
              >
                {/* Pas de « lazy » ici : le mur répète six photos, et une vignette
                    différée reste blanche jusqu'à entrer dans le champ — même quand
                    le fichier est déjà en cache. On les verrait apparaître en blanc
                    au fil du défilement. Ces six fichiers sont de toute façon déjà
                    demandés par les portraits, plus bas dans la page. */}
                <img src={versionnee(m!.vignette)} alt="" fetchpriority="low" decoding="async" width="360" height="480" />
                {/* Le repère est là en permanence, pas seulement au survol :
                    sur un téléphone, rien ne survole. */}
                <span class="fc__p" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                </span>
                <span class="fc__n" aria-hidden="true">{m!.prenom}</span>
              </button>
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
  ) : (
    <ul class="eq__l">
      {montres.map((m) => (
        <li class="eq__i">
          <button class="mb" type="button" data-groupe={groupe} data-portrait={m.slug} aria-haspopup="dialog">
            <span class="mb__ph">
              <img src={versionnee(m.vignette)} alt={m.alt} loading="lazy" decoding="async" width="360" height="480" />
            </span>
            <span class="mb__txt">
              <strong class="mb__nom">{m.prenom}{' '}{m.nom}</strong>
              <span class="mb__met">{m.metier}</span>
              <span class="mb__tags">
                {m.roles.slice(0, 3).map((r) => <span class="tag tag--role">{r}</span>)}
              </span>
              <span class="mb__lire">
                Lire son portrait
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  )}

  <div class:list={[mur && 'wrap']}>
    {/* « en 24 août 2026 » ne se dit pas : la date est devenue précise au jour
        près — elle change à chaque nouvel envoi —, elle se donne donc comme une
        date de mise à jour et non comme une période.

        Le lien, lui, n'a de sens qu'en aperçu. Le mur vit désormais sur la page
        d'équipe elle-même : l'y laisser aurait pointé vers la page en cours. */}
    {apercu ? (
      <a class="eq__plus" href={lien}>
        Voir toute l’équipe
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    ) : (
      <p class="eq__note">
        Portraits recueillis auprès de nos membres, publiés avec leur accord.
        Mise à jour du {recueilliLe}.
      </p>
    )}
  </div>
</div>
)}

{montres.map((m) => (
  <dialog class="pt" data-groupe={groupe} id={`portrait-${groupe}-${m.slug}`} aria-labelledby={`pt-t-${m.slug}`}>
    <button class="pt__x" type="button" data-ferme aria-label="Fermer le portrait">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>

    <div class="pt__grille">
      {/* La photo occupe toute la colonne, sans texte par-dessus : un visage
          en grand vaut mieux qu'une vignette entourée de mentions. */}
      {/* La vignette d'abord, la grande image à l'ouverture.
          « loading=lazy » ne suffisait pas : une boîte fermée est en
          display:none, sans boîte de rendu, et le navigateur charge alors
          l'image sans attendre — vérifié, les neuf y passaient. Partir de la
          vignette a un second avantage : elle est déjà en cache, donc le
          portrait s'affiche instantanément, puis se précise. */}
      <img class="pt__ph" src={versionnee(m.vignette)} data-grande={versionnee(m.photo)} alt={m.alt} decoding="async" width="900" height="1200" />

      <div class="pt__d">
        <header class="pt__tete">
          <h3 class="pt__nom" id={`pt-t-${m.slug}`}>{m.prenom}{' '}{m.nom}</h3>
          <p class="pt__met">{m.metier}</p>
          <p class="pt__depuis">À Secourisme Pour Tous depuis {m.depuis}</p>

          {/* Deux natures différentes, donc deux lignes et deux couleurs : ce
              qu'on fait dans l'association d'un côté, ce qu'on a passé comme
              diplôme de l'autre. Les mélanger laissait croire que « chef de
              poste » était une formation. */}
          <div class="pt__bloc">
            <span class="pt__lab">Ses rôles dans l’association</span>
            <span class="pt__tags">
              {m.roles.map((r) => <span class="tag tag--role">{r}</span>)}
            </span>
          </div>

          <div class="pt__bloc">
            <span class="pt__lab">Ses diplômes</span>
            <span class="pt__tags">
              {m.diplomes.map((dip) => (
                FICHE_DIPLOME[dip]
                  ? <a class:list={['tag', 'tag--lien', teinte(dip) && `tag--${teinte(dip)}`]}
                       href={`/formations/${FICHE_DIPLOME[dip]}`}>{dip}</a>
                  : <span class="tag tag--sobre">{dip}</span>
              ))}
            </span>
          </div>
        </header>

        {ordonner(m.reponses).map((r) => (
          <section class="pt__q">
            <h4>{r.question}</h4>
            {r.texte.map((t) => <p>{t}</p>)}
          </section>
        ))}

        <div class="pt__pied">
          <a class="btn btn--primaire" href="/secouriste-actif">Rejoindre l’équipe</a>
          <a class="btn btn--sobre" href="/formations">Se former avec nous</a>
        </div>

        {montres.length > 1 && (
          <nav class="pt__nav" aria-label="Autres portraits">
            <button type="button" class="pt__flc" data-va="-1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
              Portrait précédent
            </button>
            <button type="button" class="pt__flc" data-va="1">
              Portrait suivant
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </button>
          </nav>
        )}
      </div>
    </div>
  </dialog>
))}

<script>
  /**
   * Ouverture, navigation et verrouillage du défilement.
   *
   * Deux pièges corrigés ici. D'abord, ouvrir une boîte modale ne fige pas la
   * page derrière : elle continue de défiler, et l'on ne retrouve plus sa
   * place en refermant. On la fige donc, en mémorisant la position exacte.
   *
   * Ensuite, passer d'un portrait à l'autre imposait de refermer, retrouver la
   * grille et cliquer ailleurs. Deux flèches suffisent.
   */
  document.querySelectorAll<HTMLElement>('[data-groupe]').forEach(() => {});

  const groupes = new Set(
    [...document.querySelectorAll<HTMLElement>('dialog.pt')].map((d) => d.dataset.groupe!)
  );

  let positionPage = 0;

  function figer() {
    if (document.body.dataset.fige) return;
    positionPage = window.scrollY;
    document.body.dataset.fige = '1';
    document.body.style.position = 'fixed';
    document.body.style.top = `-${positionPage}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
  }

  function liberer() {
    if (!document.body.dataset.fige) return;
    delete document.body.dataset.fige;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    window.scrollTo(0, positionPage);
  }

  /** Fige ou libère la page selon qu'une boîte est ouverte, où qu'elle soit. */
  function synchronise() {
    if (document.querySelector('dialog.pt[open]')) figer();
    else liberer();
  }

  /**
   * Le mur ne s'anime que sous les yeux de quelqu'un.
   *
   * Le défilement lui-même est une animation CSS — pas un minuteur : le
   * navigateur la compose hors du fil principal et elle ne saccade pas. Il
   * reste à ne pas la faire tourner quand la section est sortie de l'écran.
   */
  document.querySelectorAll<HTMLElement>('[data-mur]').forEach((m) => {
    new IntersectionObserver(
      ([e]) => m.toggleAttribute('data-dort', !e.isIntersecting),
      { threshold: 0 }
    ).observe(m);
  });

  // Échap ferme la boîte sans passer par notre code : on repasse derrière.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setTimeout(synchronise, 0);
  });

  groupes.forEach((g) => {
    const boites = [...document.querySelectorAll<HTMLDialogElement>(`dialog.pt[data-groupe="${g}"]`)];

    const ouvrir = (i: number) => {
      const cible = boites[(i + boites.length) % boites.length];
      boites.forEach((d) => d.open && d.close());
      figer();
      cible.showModal();
      // Une boîte est ouverte : l'état est déjà juste, on court-circuite la
      // resynchronisation différée qu'aurait déclenchée la fermeture.
      cible.querySelector<HTMLElement>('.pt__d')?.scrollTo(0, 0);

      // On passe à la grande image, une fois seulement.
      const ph = cible.querySelector<HTMLImageElement>('.pt__ph[data-grande]');
      if (ph) { ph.src = ph.dataset.grande!; delete ph.dataset.grande; }
    };

    // On relie chaque vignette à son portrait par son identifiant, jamais par
    // son rang : le mur de visages répète les mêmes personnes pour boucler
    // sans couture, et un liage par rang ouvrirait le portrait du voisin.
    document
      .querySelectorAll<HTMLButtonElement>(`[data-portrait][data-groupe="${g}"]`)
      .forEach((b) => {
        const i = boites.findIndex((d) => d.id === `portrait-${g}-${b.dataset.portrait}`);
        if (i >= 0) b.addEventListener('click', () => ouvrir(i));
      });

    boites.forEach((d, i) => {
      // On ne s'appuie pas sur l'événement « close » : certains navigateurs ne
      // l'émettent pas du tout, et la page restait alors figée pour de bon.
      // On resynchronise donc nous-mêmes, à chaque fermeture provoquée.
      const fermer = () => { d.close(); synchronise(); };
      d.querySelector('[data-ferme]')?.addEventListener('click', fermer);
      d.addEventListener('click', (e) => { if (e.target === d) fermer(); });
      d.querySelectorAll<HTMLButtonElement>('[data-va]').forEach((b) =>
        b.addEventListener('click', () => ouvrir(i + Number(b.dataset.va)))
      );
    });
  });
</script>

<style>
  /* ── La grille de vignettes ─────────────────────────────────────────── */
  .eq__l {
    list-style: none; padding: 0; margin-top: 2rem;
    display: grid; gap: clamp(1rem, 2.2vw, 1.4rem);
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
  }

  /* ── Le mur de visages ───────────────────────────────────────────────
     Deux pistes à contresens, qui bouclent sans couture parce que chacune est
     faite de deux moitiés identiques : l'animation décale d'exactement une
     moitié, et le retour à zéro tombe sur une image identique. La durée est
     proportionnelle au nombre de vignettes, pour que la vitesse reste la même
     quel que soit l'effectif : une trentaine de pixels par seconde, soit un
     visage toutes les six secondes. Assez lent pour qu'on lise les traits sans
     suivre du regard, et pour qu'une vignette se clique sans être visée. */
  .mur {
    margin: 2.25rem 0 2rem;
    /* La piste est plus large que l'écran : sans ça, c'est toute la page qui
       défile latéralement. Le masque ne fait qu'estomper, il ne rogne pas. */
    overflow: hidden;
    display: flex; flex-direction: column; gap: clamp(.5rem, 1vw, .75rem);
    /* Les visages s'estompent aux deux bords plutôt que d'être tranchés net. */
