---
import { membres, recueilliLe, ordonner, FICHE_DIPLOME } from '../data/equipe';
import { parSlug, filieres } from '../data/formations';

/**
 * Couleur d'une étiquette de diplôme, reprise de sa filière.
 *
 * Un PSE1 doit être rouge comme la filière opérationnelle, un BNSSA bleu
 * comme l'aquatique. C'est la même grammaire de couleurs que partout ailleurs
 * sur le site : le visiteur reconnaît la famille avant d'avoir lu le sigle.
 */
const teinte = (diplome: string) => {
  const f = parSlug(FICHE_DIPLOME[diplome] ?? '')?.filiere;
  return f ? filieres[f].couleur : null;
};

/**
 * « Notre équipe » — vignettes cliquables, portrait complet en boîte de dialogue.
 *
 * Pourquoi une boîte plutôt qu'une page par personne : on veut que le visiteur
 * parcoure les visages, en ouvre deux ou trois, et reste sur la page. Une page
 * par membre le ferait sortir à chaque fois, et créerait autant d'URL à
 * maintenir quand quelqu'un s'en va.
 *
 * Sans JavaScript, `<dialog>` ne s'ouvre pas : chaque vignette reste alors un
 * lien vers l'ancre du portrait, qui est bien dans le HTML. Le contenu est
 * lisible dans tous les cas, y compris pour les moteurs de recherche.
 */

interface Props {
  titre?: string;
  intro?: string;
  /**
   * Nombre de portraits à montrer. Omis, on les montre tous.
   *
   * En aperçu, le tirage se fait à la construction du site et non dans le
   * navigateur : pas de scintillement au chargement, pas de saut de mise en
   * page, et le HTML reste le même pour tout le monde — donc indexable. Les
   * visages changent à chaque déploiement, ce qui suffit à faire vivre la page.
   */
  apercu?: number;
  /** Où mène « voir toute l'équipe ». */
  lien?: string;
}
const {
  titre = 'Celles et ceux qui font l’association',
  intro = 'Ils tiennent les postes de secours, certains forment, et tous ont une vie à côté — étudiant, surveillant de lycée, responsable en sécurité privée. L’association, c’est eux. Voici leurs mots.',
  apercu,
  lien = '/qui-sommes-nous#equipe',
} = Astro.props;

const montres = apercu
  ? [...membres].sort(() => Math.random() - 0.5).slice(0, apercu)
  : membres;
---

<div class="eq">
  <p class="eyebrow">Notre équipe</p>
  <h2 class="h-section">{titre}</h2>
  <p class="lede">{intro}</p>

  <ul class="eq__l">
    {montres.map((m) => (
      <li class="eq__i">
        <button class="mb" type="button" data-portrait={m.slug} aria-haspopup="dialog">
          <span class="mb__ph">
            <img src={m.photo} alt={m.alt} loading="lazy" decoding="async" width="600" height="800" />
          </span>
          <span class="mb__txt">
            <strong class="mb__nom">{m.prenom} {m.nom}</strong>
            <span class="mb__met">{m.metier}</span>
            <span class="mb__tags">
              {m.roles.slice(0, 3).map((r) => <span class="tag">{r}</span>)}
            </span>
            <span class="mb__lire">
              Lire son portrait
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </span>
        </button>
      </li>
    ))}
  </ul>

  {apercu ? (
    <a class="eq__plus" href={lien}>
      Voir toute l’équipe
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  ) : (
    <p class="eq__note">
      Portraits recueillis auprès de nos membres en {recueilliLe}, publiés avec
      leur accord et relus par eux.
    </p>
  )}
</div>

{montres.map((m) => (
  <dialog class="pt" id={`portrait-${m.slug}`} aria-labelledby={`pt-t-${m.slug}`}>
    <button class="pt__x" type="button" data-ferme aria-label="Fermer le portrait">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>

    <div class="pt__grille">
      {/* Colonne de gauche : le visage, en grand, et l'identité. Elle reste
          visible pendant qu'on fait défiler le récit — on lit les mots de
          quelqu'un qu'on a sous les yeux. */}
      <aside class="pt__g">
        <img class="pt__ph" src={m.photo} alt={m.alt} width="600" height="800" />
        <div class="pt__id">
          <h3 class="pt__nom" id={`pt-t-${m.slug}`}>{m.prenom} {m.nom}</h3>
          <p class="pt__met">{m.metier}</p>
          <p class="pt__depuis">À Secourisme Pour Tous depuis {m.depuis}</p>

          <span class="pt__lab">Rôles</span>
          <span class="pt__tags">{m.roles.map((r) => <span class="tag">{r}</span>)}</span>

          <span class="pt__lab">Diplômes</span>
          <span class="pt__tags">
            {m.diplomes.map((dip) => (
              FICHE_DIPLOME[dip]
                ? <a class:list={['tag', 'tag--lien', teinte(dip) && `tag--${teinte(dip)}`]}
                     href={`/formations/${FICHE_DIPLOME[dip]}`}>{dip}</a>
                : <span class="tag tag--sobre">{dip}</span>
            ))}
          </span>
        </div>
      </aside>

      {/* Colonne de droite : le récit, et lui seul. */}
      <div class="pt__d">
        {ordonner(m.reponses).map((r) => (
          <section class="pt__q">
            <h4>{r.question}</h4>
            {r.texte.map((t) => <p>{t}</p>)}
          </section>
        ))}

        <div class="pt__pied">
          <a class="btn btn--primaire" href="/secouriste-actif">Rejoindre l’équipe</a>
          <a class="btn btn--sobre" href="/formations">Se former avec nous</a>
        </div>
      </div>
    </div>
  </dialog>
))}

<script>
  // Chaque vignette ouvre le portrait correspondant. Sans JavaScript, rien ne
  // s'ouvre — mais les textes restent dans le HTML, donc lisibles et indexables.
  document.querySelectorAll<HTMLButtonElement>('[data-portrait]').forEach((b) =>
    b.addEventListener('click', () => {
      const d = document.getElementById(`portrait-${b.dataset.portrait}`) as HTMLDialogElement | null;
      d?.showModal();
      d?.querySelector<HTMLElement>('.pt__corps')?.scrollTo(0, 0);
    })
  );

  document.querySelectorAll<HTMLDialogElement>('dialog.pt').forEach((d) => {
    d.querySelector('[data-ferme]')?.addEventListener('click', () => d.close());
    // Clic sur le fond, hors de la boîte.
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>

<style>
  /* ── La grille de vignettes ─────────────────────────────────────────── */
  .eq__l {
    list-style: none; padding: 0; margin-top: 2rem;
    display: grid; gap: clamp(1rem, 2.2vw, 1.4rem);
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
  }
  /* Les cases de la grille s'étirent déjà ; encore faut-il que la carte
     occupe toute sa case, et que le bloc de texte absorbe la différence.
     Sans ça, un métier sur deux lignes ou une étiquette de plus décale tout. */
  .eq__i { display: flex; }

  .mb {
    width: 100%; height: 100%; text-align: left; cursor: pointer;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); overflow: hidden; padding: 0;
    display: flex; flex-direction: column;
    font: inherit; color: inherit;
    transition: box-shadow .18s, border-color .18s, transform .18s;
  }
  .mb:hover, .mb:focus-visible {
    box-shadow: var(--sh-lg); border-color: var(--secours); transform: translateY(-2px);
  }
  .mb__ph { display: block; aspect-ratio: 3 / 4; background: var(--sunk); overflow: hidden; }
  .mb__ph img { width: 100%; height: 100%; object-fit: cover; object-position: center 18%; }
  .mb__txt { flex: 1; display: flex; flex-direction: column; gap: .3rem; padding: 1.1rem 1.2rem 1.25rem; }
  .mb__nom { font-family: 'Archivo', sans-serif; font-size: 1.12rem; font-weight: 800; }
  .mb__met { font-size: .88rem; color: var(--ink-mute); }
  .mb__tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .45rem; }
  .mb__lire {
    display: flex; align-items: center; gap: .4rem; margin-top: auto; padding-top: .8rem;
    font-family: 'Archivo', sans-serif; font-size: .84rem; font-weight: 700; color: var(--secours);
  }
  .mb__lire svg { width: 14px; height: 14px; }

  .tag {
    font-family: 'Archivo', sans-serif; font-size: .68rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    background: var(--accent-wash, var(--sunk)); color: var(--secours);
    border-radius: 999px; padding: .22rem .6rem;
  }
  .tag--sobre { background: var(--sunk); color: var(--ink-mute); }

  .eq__plus {
    display: inline-flex; align-items: center; gap: .45rem; margin-top: 1.75rem;
    font-family: 'Archivo', sans-serif; font-weight: 700; font-size: .95rem;
    color: var(--secours); text-decoration: none;
  }
  .eq__plus:hover { text-decoration: underline; }
  .eq__plus svg { width: 15px; height: 15px; }

  .eq__note { margin-top: 1.5rem; font-size: .85rem; color: var(--ink-mute); }

  /* ── Le portrait ────────────────────────────────────────────────────── */
  dialog.pt { display: none; }
  dialog.pt[open] {
    /* Sans cette ligne, le « display: none » ci-dessus n'est jamais contredit
       et la boîte s'ouvre vide, sans hauteur ni largeur. */
    display: block;
    position: relative;
    width: min(100%, 62rem); max-height: min(92vh, 940px);
    padding: 0; border: 0; border-radius: var(--r-lg); overflow: hidden;
    background: var(--surface); color: var(--ink);
    box-shadow: 0 30px 90px rgba(0,0,0,.35);
  }
  dialog.pt::backdrop { background: rgba(10, 20, 35, .68); backdrop-filter: blur(3px); }

  .pt__grille {
    display: grid;
    grid-template-columns: minmax(0, 21rem) minmax(0, 1fr);
    max-height: inherit;
  }

  /* Colonne gauche : elle ne défile pas, le visage reste là. */
  .pt__g {
    background: var(--sunk); border-right: 1px solid var(--line);
    display: flex; flex-direction: column; min-height: 0;
  }
  .pt__ph {
    width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: center 18%;
    flex: none;
  }
  .pt__id { padding: 1.35rem 1.4rem 1.5rem; overflow-y: auto; }
  .pt__nom { font-family: 'Archivo', sans-serif; font-size: 1.35rem; font-weight: 800; line-height: 1.15; }
  .pt__met { color: var(--ink-mute); font-size: .93rem; margin-top: .3rem; }
  .pt__depuis { color: var(--ink-soft); font-size: .82rem; margin-top: .25rem; }
  .pt__lab {
    display: block; font-family: 'Archivo', sans-serif; font-size: .64rem;
    font-weight: 700; letter-spacing: .13em; text-transform: uppercase;
    color: var(--ink-mute); margin: 1.15rem 0 .45rem;
  }
  .pt__tags { display: flex; flex-wrap: wrap; gap: .35rem; }
  /* Chaque diplôme porte la couleur de sa filière, comme partout ailleurs. */
  .tag--lien {
    text-decoration: none; border: 1px solid transparent;
    transition: border-color .15s, filter .15s;
  }
  .tag--lien:hover { border-color: currentColor; text-decoration: underline; }
  .tag--azur    { background: var(--azur-wash);    color: var(--azur); }
  .tag--secours { background: var(--secours-wash); color: var(--secours); }
  .tag--ocean   { background: var(--ocean-wash);   color: var(--ocean); }
  .tag--ocre    { background: var(--ocre-wash);    color: var(--ocre); }
  .tag--navy    { background: var(--sunk);         color: var(--navy); }

  /* Colonne droite : le récit défile seul. */
  .pt__d { padding: 2rem 2.1rem 1.75rem; overflow-y: auto; min-height: 0; }

  /* Question et réponse doivent se distinguer au premier coup d'œil : la
     question porte un filet rouge et le poids du titre, la réponse respire. */
  .pt__q { margin-bottom: 1.9rem; }
  .pt__q h4 {
    font-family: 'Archivo', sans-serif; font-size: 1.02rem; font-weight: 800;
    line-height: 1.25; color: var(--ink);
    padding-left: .85rem; border-left: 3px solid var(--secours);
    margin-bottom: .75rem;
  }
  .pt__q p { color: var(--ink-mute); margin-bottom: .75rem; max-width: 62ch; line-height: 1.65; }
  .pt__q p:last-child { margin-bottom: 0; }

  .pt__pied {
    display: flex; flex-wrap: wrap; gap: .7rem;
    padding-top: 1.5rem; border-top: 1px solid var(--line);
  }

  .pt__x {
    position: absolute; top: .8rem; right: .9rem; z-index: 2;
    border: 0; cursor: pointer; padding: .45rem; line-height: 0;
    border-radius: 50%; background: var(--surface); color: var(--ink-mute);
    box-shadow: var(--sh-sm);
  }
  .pt__x:hover { color: var(--ink); }
  .pt__x svg { width: 20px; height: 20px; }

  @media (max-width: 820px) {
    dialog.pt[open] { max-height: 94vh; }
    .pt__grille { grid-template-columns: 1fr; overflow-y: auto; }
    .pt__g { border-right: 0; border-bottom: 1px solid var(--line); }
    /* En pile, la photo ne doit pas manger tout l'écran avant le texte. */
    .pt__ph { aspect-ratio: 4 / 3; object-position: center 15%; }
    .pt__id { overflow: visible; padding: 1.2rem 1.25rem 1.35rem; }
    .pt__d { padding: 1.4rem 1.3rem 1.5rem; overflow: visible; }
    .pt__nom { font-size: 1.2rem; }
  }
</style>
