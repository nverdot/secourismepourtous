---
import type { Session } from '../lib/wix';
import {
  formatNumero, formatMois, cleMois, libelleMois,
  periode, estWeekEnd, formatHeure,
} from '../lib/wix';
import { asso } from '../data/association';

interface Props {
  sessions: Session[];
  sigle: string;
}
const { sessions, sigle } = Astro.props;

// Les onglets de mois sont calculés au build : pas de tri côté visiteur.
const mois = [...new Map(sessions.map((s) => [cleMois(s.debut), s.debut])).entries()]
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([cle, d]) => ({ cle, libelle: libelleMois(d) }));

const lieux = [...new Set(sessions.map((s) => s.lieu).filter(Boolean))] as string[];
---

<dialog class="pop" id="pop-dates" aria-labelledby="pop-titre">
  <form method="dialog" class="pop__fermer-form">
    <button class="pop__fermer" aria-label="Fermer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </form>

  <header class="pop__tete">
    <span class="pop__ic" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4" />
      </svg>
    </span>
    <h2 id="pop-titre">Dates et inscriptions — {sigle}</h2>
  </header>

  <div class="pop__corps">
    {lieux.length > 0 && (
      <div class="pop__lieux">
        {lieux.map((l) => <span class="pop__lieu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>{l}</span>)}
      </div>
    )}

    {mois.length > 1 && (
      <div class="pop__filtres">
        <span class="pop__filtre-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z" /></svg>
          Filtrer par mois
        </span>
        <div class="pop__onglets" role="group" aria-label="Filtrer par mois">
          <button type="button" class="pop__onglet est-actif" data-mois="tous">Toutes</button>
          {mois.map((m) => (
            <button type="button" class="pop__onglet" data-mois={m.cle}>{m.libelle}</button>
          ))}
        </div>
      </div>
    )}

    <ul class="pop__liste">
      {sessions.map((s) => (
        <li data-mois={cleMois(s.debut)}>
          <button type="button" class="pdate" data-inscription
                  data-event-id={s.id}
                  data-url={s.urlInscription ?? ''}
                  data-libelle={`${sigle} — ${periode(s)}`}>
            <span class="pdate__cal">
              <span class="pdate__m">{formatMois(s.debut)}</span>
              <span class="pdate__j">{formatNumero(s.debut)}</span>
            </span>
            <span class="pdate__corps">
              <span class="pdate__titre">
                {sigle}
                {estWeekEnd(s.debut) && <em class="pdate__we">week-end</em>}
              </span>
              <span class="pdate__periode">{periode(s)} · {formatHeure(s.debut)}</span>
              {s.lieu && <span class="pdate__lieu">{s.lieu}</span>}
              <span class="pdate__cta">Inscription <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <p class="pop__vide" hidden>Aucune session sur ce mois. Choisissez un autre mois ou <a href="/contact">contactez-nous</a>.</p>
  </div>

  <footer class="pop__pied">
    <span>{asso.contact.adresse}, {asso.contact.ville}</span>
    <a href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
  </footer>
</dialog>

<script>
  // Ouverture depuis n'importe quel élément portant data-ouvre-dates.
  const pop = document.getElementById('pop-dates') as HTMLDialogElement | null;
  if (pop) {
    document.querySelectorAll('[data-ouvre-dates]').forEach((b) =>
      b.addEventListener('click', (e) => {
        e.preventDefault();
        pop.showModal();
      })
    );

    // Fermeture au clic sur le fond, hors de la boîte.
    pop.addEventListener('click', (e) => {
      if (e.target === pop) pop.close();
    });

    const onglets = pop.querySelectorAll<HTMLButtonElement>('.pop__onglet');
    const lignes = pop.querySelectorAll<HTMLLIElement>('.pop__liste li');
    const vide = pop.querySelector<HTMLElement>('.pop__vide');

    onglets.forEach((o) =>
      o.addEventListener('click', () => {
        onglets.forEach((x) => x.classList.remove('est-actif'));
        o.classList.add('est-actif');
        const cible = o.dataset.mois;
        let visibles = 0;
        lignes.forEach((li) => {
          const ok = cible === 'tous' || li.dataset.mois === cible;
          li.hidden = !ok;
          if (ok) visibles++;
        });
        if (vide) vide.hidden = visibles > 0;
      })
    );
  }
</script>

<style>
  .pop {
    border: 0;
    padding: 0;
    border-radius: var(--r-lg);
    width: min(720px, calc(100vw - 2rem));
    max-height: min(86vh, 900px);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--sh-lg);
    overflow: hidden;
  }
  /* Garde-fou : une boîte fermée ne doit jamais rester dans le flux. */
  .pop:not([open]) { display: none; }

  .pop::backdrop { background: rgba(7, 23, 38, 0.66); backdrop-filter: blur(2px); }

  .pop__fermer-form { position: absolute; top: 0; right: 0; margin: 0; }
  .pop__fermer {
    border: 0; background: none; cursor: pointer;
    padding: 1.1rem 1.15rem; color: var(--ink-mute); line-height: 0;
  }
  .pop__fermer svg { width: 20px; height: 20px; }
  .pop__fermer:hover { color: var(--ink); }

  .pop__tete {
    display: flex; align-items: center; gap: 0.8rem;
    padding: 1.15rem 3.25rem 1.15rem 1.4rem;
    border-bottom: 1px solid var(--line);
  }
  .pop__ic {
    width: 36px; height: 36px; flex: none;
    border-radius: 10px;
    background: var(--accent-wash); color: var(--accent);
    display: grid; place-items: center;
  }
  .pop__ic svg { width: 19px; height: 19px; }
  .pop__tete h2 { font-size: 1.12rem; font-weight: 700; }

  .pop__corps { padding: 1.25rem 1.4rem; overflow-y: auto; max-height: calc(86vh - 9rem); }

  .pop__lieux { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 1.1rem; }
  .pop__lieu {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--navy); color: #fff;
    font-family: 'Archivo', sans-serif; font-size: 0.82rem; font-weight: 600;
    padding: 0.45rem 1rem; border-radius: var(--r-pill);
  }
  .pop__lieu svg { width: 14px; height: 14px; }

  .pop__filtres { margin-bottom: 1rem; }
  .pop__filtre-label {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.78rem; color: var(--ink-mute); margin-bottom: 0.55rem;
  }
  .pop__filtre-label svg { width: 14px; height: 14px; }
  .pop__onglets { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pop__onglet {
    font-family: 'Archivo', sans-serif; font-size: 0.85rem; font-weight: 600;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink-soft);
    border-radius: var(--r-pill); padding: 0.45rem 0.95rem; cursor: pointer;
    transition: background-color 0.14s ease, color 0.14s ease, border-color 0.14s ease;
  }
  .pop__onglet:hover { border-color: var(--navy); color: var(--ink); }
  .pop__onglet.est-actif { background: var(--navy); border-color: var(--navy); color: #fff; }

  .pop__liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }

  .pdate {
    width: 100%; border: 0; font: inherit; text-align: left; cursor: pointer;
    display: flex; gap: 1rem; align-items: stretch;
    border: 1px solid var(--line); border-radius: var(--r-md);
    background: var(--sunk);
    text-decoration: none; color: inherit;
    overflow: hidden;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .pdate:hover { border-color: var(--accent); background: var(--surface); }

  .pdate__cal {
    flex: none; width: 74px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: var(--surface);
    border-right: 1px solid var(--line);
    padding: 0.85rem 0;
  }
  .pdate__m {
    font-family: 'Archivo', sans-serif; font-size: 0.66rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);
  }
  .pdate__j {
    font-family: 'Archivo', sans-serif; font-size: 1.75rem; font-weight: 800;
    line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums;
  }

  .pdate__corps { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.85rem 1rem 0.85rem 0; min-width: 0; }
  .pdate__titre { font-family: 'Archivo', sans-serif; font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: 0.5rem; }
  .pdate__we {
    font-style: normal; font-size: 0.68rem; font-weight: 700;
    background: var(--sage-wash); color: var(--sage);
    border-radius: var(--r-pill); padding: 0.15rem 0.55rem;
  }
  .pdate__periode { font-size: 0.86rem; color: var(--ink-soft); }
  .pdate__lieu { font-size: 0.8rem; color: var(--ink-mute); }
  .pdate__cta {
    margin-top: 0.35rem;
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-family: 'Archivo', sans-serif; font-weight: 700; font-size: 0.85rem;
    color: var(--accent);
  }
  .pdate__cta svg { width: 15px; height: 15px; }

  .pop__vide { margin-top: 1rem; font-size: 0.9rem; color: var(--ink-soft); text-align: center; }

  .pop__pied {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1rem;
    justify-content: space-between; align-items: center;
    padding: 0.9rem 1.4rem;
    border-top: 1px solid var(--line);
    background: var(--sunk);
    font-size: 0.84rem; color: var(--ink-mute);
  }
  .pop__pied a { color: var(--secours); font-weight: 600; text-decoration: none; }

  @media (max-width: 520px) {
    .pop__corps { padding: 1rem; }
    .pdate__cal { width: 62px; }
  }
</style>
