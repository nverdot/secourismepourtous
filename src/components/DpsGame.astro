---
/**
 * DPS Game, l'application d'entraînement de l'association.
 *
 * Le jeu accompagne avant la formation (« Je découvre ») et après : on le présente là où le visiteur pense à se
 * former (accueil) et là où il vient de choisir sa formation (PSC, PSE 1,
 * PSE 2 et leurs recyclages). Deux portes d'entrée : l'App Store pour
 * l'iPhone, le navigateur pour tous les autres téléphones (Android compris).
 *
 * Les textes reprennent la fiche App Store (appli-quiz/docs/app-store/fiche.md) :
 * rien n'est promis ici que l'application ne fasse déjà.
 */
interface Props {
  /** Sigle de la formation de la page, pour adresser le titre. */
  sigle?: string;
}
const { sigle } = Astro.props;

const appStore = 'https://apps.apple.com/fr/app/dps-game/id6819717274';
const web = 'https://app.secourismepourtous.org';
const presentation = 'https://app.secourismepourtous.org/presentation';

/* Des captures de la fiche App Store, seulement celles du jeu : une question
   d'abord (c'est ce qu'on vient voir), puis sa correction, une garde et le
   parcours. Pas le profil ni les réglages (demande de Nicolas). Elles défilent
   dans le téléphone ; le second, penché derrière, montre déjà la suivante. */
const ecrans = [
  { img: 'question', nom: 'Une question' },
  { img: 'correction', nom: 'La correction' },
  { img: 'garde', nom: 'Une garde sur un poste de secours' },
  { img: 'parcours', nom: 'Le parcours' },
];
---

<section class="section section--navy dg" aria-labelledby="t-dpsgame">
  <div class="wrap dg__in">
    <div class="dg__texte">
      <p class="eyebrow dg__eyebrow">Notre application</p>
      <div class="dg__tete">
        <img class="dg__icone" src="/img/dps-game/icone.png" alt="" width="192" height="192" loading="lazy" decoding="async" />
        <h2 class="h-section dg__h" id="t-dpsgame">
          {sigle ? <>Après votre {sigle}, continuez à cultiver votre savoir</> : <>Découvrir les premiers secours, puis ne plus les oublier</>}
        </h2>
      </div>
      <p class="lede dg__lede">
        {/* Affirmation confirmée par Nicolas le 23/10/2026. */}
        Nous sommes la seule association à proposer une application pour découvrir
        les premiers secours, puis pour continuer à cultiver votre savoir après la
        formation. DPS Game vous accompagne, quelques minutes par jour.
      </p>
      <ul class="dg__l">
        <li><strong>Jamais formé&nbsp;?</strong> Le parcours «&nbsp;Je découvre&nbsp;» présente cinq situations des gestes qui sauvent, puis les prochaines dates de PSC.</li>
        <li><strong>Déjà formé&nbsp;?</strong> Questions courtes, cas concrets et gardes sur un poste de secours, du PSC au PSE&nbsp;2.</li>
        <li>Chaque question s'appuie sur les recommandations officielles.</li>
        <li>Gratuit, sans publicité. Vous pouvez jouer sans créer de compte.</li>
      </ul>
      <div class="dg__actions">
        <a class="dg__store" href={appStore} target="_blank" rel="noopener">
          <svg viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" /></svg>
          <span><small>Télécharger dans</small>l'App Store</span>
        </a>
        <a class="btn dg__web" href={web} target="_blank" rel="noopener">Jouer dans le navigateur</a>
      </div>
      <p class="dg__note">
        Sur Android ou sur ordinateur, le jeu s'ouvre dans le navigateur.
        <a href={presentation} target="_blank" rel="noopener">Découvrir l'application</a>
      </p>
      <p class="dg__avert">
        Un quiz ne remplace pas une formation : les gestes s'apprennent en les faisant, avec un formateur.
      </p>
    </div>

    <figure class="dg__visuel" data-dg-defile>
      <div class="dg__scene">
        {[ 'arriere', 'avant' ].map((plan) => (
          <div class={`dg__tel dg__tel--${plan}`} aria-hidden="true">
            {ecrans.map((e, i) => (
              <img
                src={`/img/dps-game/${e.img}.webp`} alt="" width="506" height="1100"
                loading="lazy" decoding="async"
                data-i={i}
                class={(plan === 'avant' ? i === 0 : i === 1) ? 'est-vu' : undefined}
              />
            ))}
          </div>
        ))}
      </div>
      <figcaption class="dg__legende">
        <span class="dg__nom" aria-live="polite">{ecrans[0].nom}</span>
        <span class="dg__points">
          {ecrans.map((e, i) => (
            <button type="button" class={i === 0 ? 'est-vu' : undefined} data-i={i} aria-label={`Voir : ${e.nom}`}></button>
          ))}
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .dg__in {
    display: grid; gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }
  .dg__eyebrow { color: var(--ocre-vif); }
  .dg__tete { display: flex; align-items: center; gap: 1rem; }
  .dg__icone { flex: none; width: 64px; height: 64px; border-radius: 15px; box-shadow: 0 6px 18px rgba(0, 0, 0, .35); }
  .dg__h { margin: 0; }
  .dg__lede { margin-top: 1.1rem; color: var(--on-navy-text); }
  .dg__l {
    list-style: none; margin: 1.4rem 0 0; padding: 0;
    display: flex; flex-direction: column; gap: .55rem;
    color: var(--on-navy-text);
  }
  .dg__l li { position: relative; padding-left: 1.6rem; }
  .dg__l strong { color: var(--on-navy); }
  .dg__l li::before {
    content: ''; position: absolute; left: 0; top: .5em;
    width: .65rem; height: .65rem; border-radius: 50%;
    background: var(--ocre-vif);
  }
  .dg__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; align-items: center; }
  /* Même allure que le badge officiel d'Apple : fond noir, liseré clair. */
  .dg__store {
    display: inline-flex; align-items: center; gap: .6rem;
    min-height: 52px; padding: .45rem 1.15rem .45rem .95rem;
    background: #000; color: #fff; text-decoration: none;
    border: 1px solid #a6a6a6; border-radius: 12px;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
    font-size: 1.3rem; font-weight: 600; line-height: 1.05; letter-spacing: -.01em;
  }
  .dg__store svg { width: 24px; height: 28px; flex: none; }
  .dg__store small { display: block; font-size: .72rem; font-weight: 400; letter-spacing: 0; }
  .dg__store:hover { background: #1a1a1a; }
  .dg__web {
    min-height: 52px;
    background: transparent; color: var(--on-navy);
    border: 1.5px solid rgba(242, 246, 250, .55);
  }
  .dg__web:hover { background: rgba(242, 246, 250, .1); }
  .dg__note { margin-top: 1.1rem; font-size: 1rem; color: var(--on-navy-text); }
  .dg__note a { color: var(--on-navy); font-weight: 600; }
  .dg__avert { margin-top: .8rem; font-size: .88rem; color: var(--on-navy-soft); }

  /*
   * Deux téléphones, comme sur l'en-tête de la fiche App Store : celui de
   * devant fait défiler les captures, celui de derrière, penché, montre la
   * suivante. Les images se relaient en fondu, sans rien déplacer.
   */
  .dg__visuel { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .dg__scene { position: relative; width: clamp(290px, 30vw, 360px); aspect-ratio: 360 / 520; }
  .dg__tel {
    position: absolute; overflow: hidden;
    aspect-ratio: 506 / 1100;
    border: 7px solid #04101c; border-radius: 30px;
    background: #04101c;
    box-shadow: 0 24px 48px rgba(0, 0, 0, .45);
  }
  .dg__tel--avant { width: 66%; right: 0; bottom: 0; z-index: 1; }
  .dg__tel--arriere {
    width: 58%; left: 0; top: 0;
    transform: rotate(-8deg); transform-origin: bottom right;
    opacity: .55; filter: saturate(.8);
  }
  .dg__tel img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transform: scale(1.03);
    transition: opacity .7s ease, transform 1.4s ease;
  }
  .dg__tel img.est-vu { opacity: 1; transform: none; }

  .dg__legende { display: flex; flex-direction: column; align-items: center; gap: .6rem; }
  .dg__nom { font-weight: 600; font-size: 1rem; color: var(--on-navy); text-align: center; min-height: 1.5em; }
  .dg__points { display: flex; gap: .15rem; }
  /* La cible fait 24 px pour le doigt ; le point visible, 8 px. */
  .dg__points button {
    width: 24px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer;
    display: grid; place-items: center;
  }
  .dg__points button::before {
    content: ''; width: 8px; height: 8px; border-radius: 50%;
    background: rgba(242, 246, 250, .35);
    transition: background-color .3s ease, width .3s ease;
  }
  .dg__points button.est-vu::before { width: 20px; border-radius: 4px; background: var(--ocre-vif); }

  @media (prefers-reduced-motion: reduce) {
    .dg__tel img { transition: none; transform: none; }
  }

  /* Accueil du téléphone : les sections y perdent leur fond. Le jeu garde le
     sien, en carte. */
  :global(main:has(.appli)) > .dg .dg__in {
    background: var(--navy-deep); color: var(--on-navy);
    border-radius: 18px; padding: 1.3rem 1.1rem 1.2rem;
  }

  @media (max-width: 760px) {
    .dg__in { grid-template-columns: 1fr; }
    .dg__visuel { justify-self: center; }
    .dg__visuel { order: -1; }
    .dg__scene { width: 260px; }
    .dg__icone { width: 52px; height: 52px; border-radius: 12px; }
  }
</style>

<script>
  /**
   * Le défilement des captures. Il ne tourne que si le bloc est à l'écran, et
   * s'arrête quand on le survole ou qu'on choisit un écran. Sans animation
   * voulue (réglage du système), rien ne bouge seul : les points restent.
   */
  for (const fig of document.querySelectorAll<HTMLElement>('[data-dg-defile]')) {
    const avant = [...fig.querySelectorAll<HTMLImageElement>('.dg__tel--avant img')];
    const arriere = [...fig.querySelectorAll<HTMLImageElement>('.dg__tel--arriere img')];
    const points = [...fig.querySelectorAll<HTMLButtonElement>('.dg__points button')];
    const nom = fig.querySelector('.dg__nom')!;
    const n = avant.length;
    let i = 0, minuterie = 0, visible = false, arrete = false;
    const sobre = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const montrer = (k: number) => {
      i = (k + n) % n;
      avant.forEach((im, j) => im.classList.toggle('est-vu', j === i));
      arriere.forEach((im, j) => im.classList.toggle('est-vu', j === (i + 1) % n));
      points.forEach((b, j) => b.classList.toggle('est-vu', j === i));
      nom.textContent = points[i].getAttribute('aria-label')!.replace('Voir : ', '');
    };
    const relancer = () => {
      clearInterval(minuterie);
      if (!sobre && visible && !arrete) minuterie = window.setInterval(() => montrer(i + 1), 3200);
    };

    points.forEach((b, j) => b.addEventListener('click', () => { arrete = true; montrer(j); relancer(); }));
    fig.addEventListener('mouseenter', () => { clearInterval(minuterie); });
    fig.addEventListener('mouseleave', relancer);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; relancer(); }, { threshold: 0.3 }).observe(fig);
  }
</script>
