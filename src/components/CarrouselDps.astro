---
import { photosDps } from '../data/dps-photos';

interface Props {
  /** Ne montre que les photos de ce cadrage. */
  orientation: 'paysage' | 'portrait';
}
const { orientation } = Astro.props;

// Mêler paysage et portrait dans un même carrousel obligerait à rogner
// lourdement l'un des deux : on les sépare.
const photos = photosDps.filter((p) =>
  orientation === 'paysage' ? p.largeur >= p.hauteur : p.hauteur > p.largeur
);

/**
 * Carrousel des photos de dispositifs.
 *
 * Construit sur le défilement natif avec accroche (`scroll-snap`) plutôt que
 * sur une bibliothèque : ça fonctionne au doigt sur téléphone, à la molette et
 * au clavier, et ça reste utilisable si le script ne se charge pas. Le script
 * n'ajoute que les flèches et les points — du confort, jamais l'essentiel.
 */
---

{photos.length > 0 && (
  <div class:list={["car", `car--${orientation}`]} data-carrousel>
    <div class="car__piste" data-piste tabindex="0" role="group" aria-label="Photos de dispositifs">
      {photos.map((p, i) => (
        <figure class="car__vue">
          <img
            src={p.fichier}
            alt={p.alt}
            width={p.largeur}
            height={p.hauteur}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <figcaption>{p.legende}</figcaption>
        </figure>
      ))}
    </div>

    {photos.length > 1 && (
      <>
        <button type="button" class="car__fleche car__fleche--prec" data-prec aria-label="Photo précédente">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button type="button" class="car__fleche car__fleche--suiv" data-suiv aria-label="Photo suivante">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
        <div class="car__points" data-points aria-hidden="true">
          {photos.map((_, i) => <span class="car__point" data-point={i}></span>)}
        </div>
      </>
    )}
  </div>
)}

<style>
  .car { position: relative; margin-top: 2.5rem; }

  .car__piste {
    display: grid; grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 0;
    overflow-x: auto; overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--r-lg);
  }
  .car__piste::-webkit-scrollbar { display: none; }
  .car__piste:focus-visible { outline: 3px solid var(--azur); outline-offset: 3px; }

  .car__vue { margin: 0; scroll-snap-align: center; }
  .car__vue img {
    display: block; width: 100%; height: auto;
    object-fit: cover; object-position: center 55%;
    border-radius: var(--r-lg); border: 1px solid var(--line);
  }
  .car--paysage .car__vue img { aspect-ratio: 16 / 9; }
  /* Un portrait affiché plein cadre occuperait tout l'écran : on le borne. */
  .car--portrait .car__vue img { aspect-ratio: 3 / 4; max-height: 620px; }
  .car--portrait .car__piste { max-width: 520px; margin-inline: auto; }
  @media (max-width: 700px) {
    .car--paysage .car__vue img { aspect-ratio: 4 / 3; }
    .car--portrait .car__vue img { aspect-ratio: 3 / 4; }
  }
  .car__vue figcaption {
    margin-top: .7rem; font-size: .87rem; color: var(--ink-mute); text-align: center;
  }

  .car__fleche {
    position: absolute; top: calc(50% - 1.6rem); transform: translateY(-50%);
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--surface); border: 1px solid var(--line);
    color: var(--ink); box-shadow: var(--sh-md);
    display: grid; place-items: center; cursor: pointer;
    transition: background-color .15s, opacity .15s;
  }
  .car__fleche:hover { background: var(--sunk); }
  .car__fleche[disabled] { opacity: .35; cursor: default; }
  .car__fleche svg { width: 20px; height: 20px; }
  .car__fleche--prec { left: .7rem; }
  .car__fleche--suiv { right: .7rem; }

  .car__points { display: flex; justify-content: center; gap: .4rem; margin-top: .8rem; }
  .car__point {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--line); transition: background-color .2s, width .2s;
  }
  .car__point[data-actif] { background: var(--secours); width: 20px; border-radius: 4px; }
</style>

<script>
  for (const car of document.querySelectorAll('[data-carrousel]')) {
    const piste = car.querySelector('[data-piste]');
    const vues = [...piste.children];
    const prec = car.querySelector('[data-prec]');
    const suiv = car.querySelector('[data-suiv]');
    const points = [...car.querySelectorAll('[data-point]')];
    if (vues.length < 2) continue;

    // Au premier passage la largeur peut encore valoir zéro (images non
    // décodées) : une division par zéro donnerait NaN et les repères
    // resteraient éteints.
    const courante = () => {
      const l = piste.clientWidth;
      return l > 0 ? Math.round(piste.scrollLeft / l) : 0;
    };

    const vers = (i) => {
      const n = Math.max(0, Math.min(vues.length - 1, i));
      piste.scrollTo({ left: n * piste.clientWidth, behavior: 'smooth' });
    };

    const majEtat = () => {
      const i = courante();
      points.forEach((p, n) => p.toggleAttribute('data-actif', n === i));
      if (prec) prec.disabled = i === 0;
      if (suiv) suiv.disabled = i === vues.length - 1;
    };

    prec?.addEventListener('click', () => vers(courante() - 1));
    suiv?.addEventListener('click', () => vers(courante() + 1));

    // Le défilement au doigt doit mettre les repères à jour comme les flèches.
    let attente;
    piste.addEventListener('scroll', () => {
      clearTimeout(attente);
      attente = setTimeout(majEtat, 90);
    }, { passive: true });

    piste.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); vers(courante() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); vers(courante() - 1); }
    });

    majEtat();
    // La mise en page se stabilise après le chargement des images et à chaque
    // changement de largeur : on recale les repères à ces deux moments.
    addEventListener('load', majEtat);
    addEventListener('resize', majEtat);
  }
</script>
