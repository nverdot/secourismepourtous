---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { asso } from '../data/association';

interface Props {
  title: string;
  description: string;
  /** Chemin canonique, ex. "/formations/psc" */
  chemin: string;
  /** Filière, pour teinter la page aux couleurs du catalogue. */
  filiere?: string;
  /** Retire la page des moteurs : page d'erreur, page technique. */
  noindex?: boolean;
}

const { title, description, chemin, filiere, noindex = false } = Astro.props;
const canonical = new URL(chemin, Astro.site ?? 'https://www.secourismepourtous.org').href;

/**
 * Données structurées : décrivent l'organisme de formation à Google.
 * Absentes du site Wix actuel — c'est ce qui permet d'apparaître dans le
 * panneau de connaissance et les résultats enrichis en recherche locale.
 */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: asso.nom,
  foundingDate: String(asso.fondation),
  founder: { '@type': 'Person', name: asso.fondateur },
  url: 'https://www.secourismepourtous.org',
  email: asso.contact.email,
  telephone: asso.contact.telephoneLien,
  address: {
    '@type': 'PostalAddress',
    streetAddress: asso.contact.adresse,
    postalCode: asso.contact.codePostal,
    addressLocality: asso.contact.ville,
    addressRegion: asso.contact.departement,
    addressCountry: 'FR',
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'Alpes-Maritimes' },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#0B2540" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={asso.nom} />
    <meta property="og:image" content={new URL('/img/equipe.jpg', Astro.site).href} />
    <meta property="og:image:alt" content="Secouristes de l'association en intervention" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Public+Sans:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body class={filiere ? `filiere-${filiere}` : undefined}>
    <a class="saut-contenu" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
