---
import '../styles/global.css';
import '../styles/appli.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Compagnon from '../components/Compagnon.astro';
import BarreOnglets from '../components/BarreOnglets.astro';
import { asso } from '../data/association';
import { organisation } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Chemin canonique, ex. "/formations/psc" */
  chemin: string;
  /** Filière, pour teinter la page aux couleurs du catalogue. */
  filiere?: string;
  /** Retire la page des moteurs : page d'erreur, page technique. */
  noindex?: boolean;
  /** Balisages propres à la page, ajoutés à la fiche de l'organisation. */
  schemas?: unknown[];
}

const { title, description, chemin, filiere, noindex = false, schemas = [] } = Astro.props;
const canonical = new URL(chemin, Astro.site ?? 'https://www.secourismepourtous.org').href;

/**
 * Données structurées : décrivent l'organisme de formation à Google.
 * Absentes du site Wix actuel — c'est ce qui permet d'apparaître dans le
 * panneau de connaissance et les résultats enrichis en recherche locale.
 */
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#0B2540" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={asso.nom} />
    {/* Image d'aperçu des partages (WhatsApp, Facebook, LinkedIn…) : au format
        1200 × 630 qu'ils attendent, légère (WhatsApp ignore les images de plus
        d'environ 300 Ko), et ses dimensions annoncées — sans elles, les
        premiers partages d'une page s'affichent souvent sans image. */}
    <meta property="og:image" content={new URL('/img/partage.jpg', Astro.site).href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Secouristes de l'association en intervention" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Les deux seules fontes présentes dès le premier écran : le texte
        courant et les grands titres. Précharger les sept graisses ferait
        concurrence au HTML lui-même — le navigateur ira chercher les autres
        quand il en aura besoin. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/public-sans-400-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/archivo-800-latin.woff2" />

    {/*
      Le Compagnon a quatre visages, deux hommes et deux femmes : tiré au sort à la
      première page de la visite, gardé ensuite pour toute la visite (le
      personnage ne change pas en cours de route). Posé sur <html> avant que la
      page s'affiche, pour que chaque image parte directement du bon dossier.
    */}
    <script is:inline>
      (function () {
        var g;
        try { g = sessionStorage.getItem('spt-compagnon'); } catch (e) {}
        var visages = ['homme', 'femme', 'homme2', 'femme2'];
        if (visages.indexOf(g) < 0) {
          g = visages[Math.floor(Math.random() * visages.length)];
          try { sessionStorage.setItem('spt-compagnon', g); } catch (e) {}
        }
        document.documentElement.dataset.compagnon = g;
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(organisation())} />
    {schemas.map((sc) => (
      <script type="application/ld+json" set:html={JSON.stringify(sc)} />
    ))}
  </head>

  <body class={filiere ? `filiere-${filiere}` : undefined} data-appli>
    <a class="saut-contenu" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <BarreOnglets />
    <Compagnon />
  </body>
</html>
