---
import Base from '../layouts/Base.astro';
import { asso } from '../data/association';
import { formations } from '../data/formations';

/**
 * Demande de prise en charge.
 *
 * Parcours distinct de la billetterie : une prise en charge OPCO, un paiement
 * Chorus Pro ou un financement employeur n'aboutit pas à un paiement en ligne
 * mais à une convention de formation. Les informations à recueillir sont donc
 * celles qui figurent sur la convention — d'où les coordonnées du financeur et
 * l'état civil complet du stagiaire.
 *
 * Les dates et lieux de naissance sont exigés par les certificateurs
 * (Ministère de l'Intérieur, INRS) pour l'édition des diplômes. Ils ne sont
 * demandés que dans ce cadre.
 */

const dispositifs = [
  {
    cle: 'opco',
    nom: 'Prise en charge OPCO',
    pour: 'Salarié du privé',
    texte:
      "Votre opérateur de compétences finance tout ou partie de la formation. La demande doit être déposée avant le début de la session, et l'accord de prise en charge nous parvenir avant la date de formation.",
    delai: 'Prévoir 4 à 8 semaines',
  },
  {
    cle: 'entreprise',
    nom: 'Financement par l’employeur',
    pour: 'Plan de développement des compétences',
    texte:
      "Votre entreprise règle directement la formation. Nous établissons une convention de formation et adressons la facture à l'issue de la session.",
    delai: 'Prévoir 2 à 3 semaines',
  },
  {
    cle: 'chorus',
    nom: 'Chorus Pro / bon de commande',
    pour: 'Collectivité, administration, établissement public',
    texte:
      "Nous déposons la facture sur Chorus Pro. Un bon de commande ou un engagement juridique nous est nécessaire avant la formation.",
    delai: 'Prévoir 3 à 4 semaines',
  },
  {
    cle: 'perso',
    nom: 'France Travail ou autre',
    pour: 'Demandeur d’emploi, situation particulière',
    texte:
      "Selon votre situation, d'autres dispositifs peuvent s'appliquer. Décrivez-nous votre cas, nous étudions les possibilités avec vous.",
    delai: 'Nous consulter',
  },
];

const departements = [
  '06 — Alpes-Maritimes', '83 — Var', '13 — Bouches-du-Rhône', '84 — Vaucluse',
  '04 — Alpes-de-Haute-Provence', '05 — Hautes-Alpes', 'Autre département', 'Né(e) à l’étranger',
];
---

<Base
  title="Financer votre formation | OPCO, entreprise, Chorus Pro"
  description="Faites financer votre formation secourisme à Nice : prise en charge OPCO, financement employeur, Chorus Pro. Organisme certifié Qualiopi. Demande en ligne."
  chemin="/financement"
>
  <header class="tete">
    <div class="wrap">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i><b>Financement</b>
      </nav>
      <div class="tete__badges">
        <span class="badge badge--qualiopi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          Certifié Qualiopi
        </span>
      </div>
      <h1 class="tete__h1">Faire financer votre formation</h1>
      <p class="tete__t">
        Notre certification Qualiopi ouvre l'accès aux financements publics et
        mutualisés. Décrivez-nous votre situation : nous montons le dossier avec vous.
      </p>
    </div>
  </header>

  <!-- ========== DISPOSITIFS ========== -->
  <section class="section" aria-labelledby="t-disp">
    <div class="wrap">
      <p class="eyebrow">Les dispositifs</p>
      <h2 class="h-section" id="t-disp">Quel financement vous concerne&nbsp;?</h2>
      <div class="disp">
        {dispositifs.map((d) => (
          <article class="disp__c">
            <span class="disp__pour">{d.pour}</span>
            <h3 class="disp__h">{d.nom}</h3>
            <p class="disp__t">{d.texte}</p>
            <span class="disp__delai">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
              {d.delai}
            </span>
          </article>
        ))}
      </div>
      <p class="disp__note">
        ⚠️ Le <strong>PSC n'est pas éligible au CPF</strong>. Pour les autres formations,
        interrogez-nous : l'éligibilité dépend du certificateur et de votre situation.
      </p>
    </div>
  </section>

  <!-- ========== FORMULAIRE ========== -->
  <section class="section section--sunk" aria-labelledby="t-form">
    <div class="wrap wrap--etroit">
      <p class="eyebrow">Votre demande</p>
      <h2 class="h-section" id="t-form">Demande de prise en charge</h2>
      <p class="lede fm__intro">
        Ces informations nous permettent d'établir la convention de formation et,
        pour les formations diplômantes, de préparer votre dossier auprès du
        certificateur. Réponse sous 48 heures ouvrées.
      </p>

      <form class="fm" name="financement" method="POST" action="/api/contact" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="financement" />
        <p class="miel"><label>Ne pas remplir : <input name="bot-field" /></label></p>

        <!-- ---------- formation ---------- -->
        <fieldset class="bloc bloc--form">
          <legend><span class="bloc__n">1</span>La formation</legend>
          <div class="duo">
            <label>Formation souhaitée *
              <select name="formation" required>
                <option value="">Choisissez…</option>
                {formations.map((f) => <option value={`${f.sigle} — ${f.intitule}`}>{f.sigle} — {f.intitule}</option>)}
              </select>
            </label>
            <label>Nombre de participants *
              <input type="number" name="participants" min="1" max="30" value="1" required />
            </label>
          </div>
          <label>Session ou période souhaitée
            <input type="text" name="session" placeholder="Ex. : session du 6 septembre, ou « courant octobre »" />
          </label>
        </fieldset>

        <!-- ---------- financement ---------- -->
        <fieldset class="bloc bloc--fin">
          <legend><span class="bloc__n">2</span>Le financement</legend>
          <div class="choix">
            {dispositifs.map((d, i) => (
              <label class="choix__o">
                <input type="radio" name="dispositif" value={d.nom} required checked={i === 0} />
                <span>
                  <strong>{d.nom}</strong>
                  <em>{d.pour}</em>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- ---------- financeur ---------- -->
        <fieldset class="bloc bloc--financeur">
          <legend><span class="bloc__n">3</span>Renseignements du financeur</legend>
          <p class="bloc__aide">
            À remplir si l'entreprise, l'OPCO ou l'administration prend en charge la
            formation. Laissez vide si vous financez vous-même.
          </p>
          <div class="duo">
            <label>Nom de l'entreprise / organisme
              <input type="text" name="financeur_nom" placeholder="Raison sociale" />
            </label>
            <label>Représentant
              <input type="text" name="financeur_representant" placeholder="Prénom et nom, pour la convention" />
            </label>
          </div>
          <label>Adresse
            <input type="text" name="financeur_adresse" placeholder="Numéro et nom de rue" />
          </label>
          <div class="duo">
            <label>Code postal<input type="text" name="financeur_cp" inputmode="numeric" maxlength="5" /></label>
            <label>Ville<input type="text" name="financeur_ville" /></label>
          </div>
          <div class="duo">
            <label>E-mail pour la convention
              <input type="email" name="financeur_email" placeholder="convention@entreprise.fr" />
            </label>
            <label>N° SIRET<input type="text" name="financeur_siret" inputmode="numeric" maxlength="14" /></label>
          </div>
        </fieldset>

        <!-- ---------- stagiaire ---------- -->
        <fieldset class="bloc bloc--stagiaire">
          <legend><span class="bloc__n">4</span>Renseignements du stagiaire</legend>
          <div class="duo">
            <label>Nom *<input type="text" name="stagiaire_nom" autocomplete="family-name" required /></label>
            <label>Prénom *<input type="text" name="stagiaire_prenom" autocomplete="given-name" required /></label>
          </div>
          <div class="trio">
            <label>Date de naissance *<input type="date" name="stagiaire_naissance" required /></label>
            <label>Lieu de naissance *<input type="text" name="stagiaire_lieu" placeholder="Ville" required /></label>
            <label>Département
              <select name="stagiaire_departement">
                <option value="">Choisissez…</option>
                {departements.map((d) => <option value={d}>{d}</option>)}
              </select>
            </label>
          </div>
          <label>Adresse postale<input type="text" name="stagiaire_adresse" autocomplete="street-address" /></label>
          <div class="duo">
            <label>Code postal<input type="text" name="stagiaire_cp" inputmode="numeric" maxlength="5" autocomplete="postal-code" /></label>
            <label>Ville<input type="text" name="stagiaire_ville" autocomplete="address-level2" /></label>
          </div>
          <div class="duo">
            <label>Téléphone *<input type="tel" name="stagiaire_tel" autocomplete="tel" required /></label>
            <label>E-mail *<input type="email" name="stagiaire_email" autocomplete="email" required /></label>
          </div>
          <p class="bloc__aide">
            Date et lieu de naissance sont exigés par le certificateur pour l'édition
            du diplôme. Ils ne servent à rien d'autre.
          </p>
        </fieldset>

        <!-- ---------- accessibilité ---------- -->
        <fieldset class="bloc bloc--acc">
          <legend><span class="bloc__n">5</span>Accessibilité</legend>
          <p class="bloc__aide">
            Êtes-vous en situation de handicap&nbsp;? Cela nous permet d'adapter au
            mieux votre accueil. Question facultative : vous pouvez ne pas répondre.
          </p>
          <div class="choix choix--duo">
            <label class="choix__o">
              <input type="radio" name="handicap" value="Non concerné(e)" />
              <span><strong>Non, je ne suis pas concerné(e)</strong></span>
            </label>
            <label class="choix__o">
              <input type="radio" name="handicap" value="Oui, en situation de handicap" />
              <span>
                <strong>Oui, je suis en situation de handicap</strong>
                <em>Notre référente handicap vous contactera</em>
              </span>
            </label>
          </div>
          <label>Précisions ou question
            <textarea name="message" rows="3" placeholder="Toute information utile à l'organisation de votre formation"></textarea>
          </label>
        </fieldset>

        <label class="case case--rgpd">
          <input type="checkbox" name="consentement" required />
          <span>
            J'accepte que ces informations soient utilisées pour traiter ma demande et
            établir les documents de formation.
            <a href="/politique-de-confidentialite">En savoir plus</a>
          </span>
        </label>

        <button type="submit" class="btn btn--primaire fm__envoi">
          Envoyer ma demande
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>

        <p class="fm__contact">
          Une question avant d'envoyer&nbsp;?
          <a href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
          ou <a href={`mailto:${asso.contact.email}`}>{asso.contact.email}</a>
        </p>
      </form>
    </div>
  </section>
</Base>

<style>
  .tete {
    background: linear-gradient(158deg, var(--navy-lift) 0%, var(--navy) 55%, var(--navy-deep) 100%);
    color: var(--on-navy);
    padding-block: clamp(1.5rem,4vw,2.25rem) clamp(2.5rem,6vw,3.75rem);
  }
  .fil {
    display: flex; gap: .5rem; align-items: center;
    font-family: 'Archivo', sans-serif; font-size: .72rem; font-weight: 600;
    letter-spacing: .11em; text-transform: uppercase; color: var(--on-navy-soft);
    margin-bottom: clamp(1.5rem,4vw,2.5rem);
  }
  .fil a { color: inherit; text-decoration: none; }
  .fil a:hover { color: #fff; }
  .fil i { opacity: .45; font-style: normal; }
  .fil b { color: #fff; font-weight: 600; }
  .tete__badges { margin-bottom: 1.1rem; }
  .tete__h1 { font-size: clamp(2rem,5.5vw,3.1rem); font-weight: 800; margin-bottom: .8rem; }
  .tete__t { max-width: 54ch; color: var(--on-navy-text); font-size: clamp(1rem,2.2vw,1.1rem); }

  /* --- dispositifs --- */
  .disp {
    margin-top: 2.5rem; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
  }
  .disp__c {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(1.25rem,3vw,1.6rem);
    display: flex; flex-direction: column;
  }
  .disp__pour {
    font-family: 'Archivo', sans-serif; font-size: .66rem; font-weight: 700;
    letter-spacing: .11em; text-transform: uppercase; color: var(--azur);
    margin-bottom: .5rem;
  }
  .disp__h { font-size: 1.08rem; font-weight: 700; margin-bottom: .5rem; }
  .disp__t { font-size: .91rem; color: var(--ink-soft); margin-bottom: 1rem; }
  .disp__delai {
    margin-top: auto; display: inline-flex; align-items: center; gap: .4rem;
    font-size: .82rem; font-weight: 600; color: var(--ink-mute);
  }
  .disp__delai svg { width: 15px; height: 15px; }
  .disp__note {
    margin-top: 1.5rem; font-size: .9rem; color: var(--ink-soft);
    background: var(--gold-wash); border-radius: var(--r-md);
    padding: .85rem 1.1rem; max-width: 70ch;
  }

  /* --- formulaire --- */
  .fm__intro { margin-bottom: 2rem; }
  .fm { display: flex; flex-direction: column; gap: 1.25rem; }

  .bloc {
    background: var(--surface); border: 1px solid var(--line);
    border-left: 3px solid var(--azur);
    border-radius: var(--r-md);
    padding: 1.3rem 1.35rem 1.5rem; margin: 0;
    display: flex; flex-direction: column; gap: .9rem;
  }
  .bloc--fin { border-left-color: var(--secours); }
  .bloc--financeur { border-left-color: var(--navy); }
  .bloc--stagiaire { border-left-color: var(--sage); }
  .bloc--acc { border-left-color: var(--gold); }

  .bloc legend {
    display: flex; align-items: center; gap: .6rem;
    font-family: 'Archivo', sans-serif; font-size: 1rem; font-weight: 700;
    color: var(--ink); padding: 0;
  }
  .bloc__n {
    width: 24px; height: 24px; flex: none; border-radius: 50%;
    background: var(--azur-wash); color: var(--azur);
    display: grid; place-items: center;
    font-size: .78rem; font-weight: 800; font-variant-numeric: tabular-nums;
  }
  .bloc--fin .bloc__n { background: var(--secours-wash); color: var(--secours); }
  .bloc--financeur .bloc__n { background: var(--azur-wash); color: var(--navy); }
  .bloc--stagiaire .bloc__n { background: var(--sage-wash); color: var(--sage); }
  .bloc--acc .bloc__n { background: var(--gold-wash); color: var(--gold); }

  .bloc__aide { font-size: .84rem; color: var(--ink-mute); max-width: 62ch; }

  .duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px,100%),1fr)); gap: .9rem; }
  .trio { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px,100%),1fr)); gap: .9rem; }

  .fm label {
    display: flex; flex-direction: column; gap: .3rem;
    font-family: 'Archivo', sans-serif; font-size: .72rem; font-weight: 700;
    letter-spacing: .05em; text-transform: uppercase; color: var(--ink-mute);
  }
  .fm input, .fm select, .fm textarea {
    font-family: 'Public Sans', sans-serif;
    font-size: .96rem; font-weight: 400; letter-spacing: 0; text-transform: none;
    color: var(--ink); background: var(--sunk);
    border: 1px solid transparent; border-radius: var(--r-sm);
    padding: .65rem .8rem; width: 100%; min-width: 0;
  }
  .fm input:focus, .fm select:focus, .fm textarea:focus {
    outline: none; background: var(--surface); border-color: var(--azur);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--azur) 16%, transparent);
  }
  .fm textarea { resize: vertical; }

  .choix { display: grid; gap: .55rem; }
  .choix--duo { grid-template-columns: repeat(auto-fit, minmax(min(220px,100%),1fr)); }
  .choix--duo .choix__o input { accent-color: var(--gold); }
  .choix--duo .choix__o:hover { border-color: var(--gold); }
  .choix__o {
    flex-direction: row !important; align-items: flex-start; gap: .7rem;
    background: var(--sunk); border: 1px solid var(--line);
    border-radius: var(--r-sm); padding: .8rem .95rem;
    text-transform: none; letter-spacing: 0; cursor: pointer;
  }
  .choix__o:hover { border-color: var(--secours); }
  .choix__o input { width: 17px; height: 17px; flex: none; margin-top: .15rem; accent-color: var(--secours); }
  .choix__o span { display: flex; flex-direction: column; }
  .choix__o strong { font-family: 'Archivo', sans-serif; font-size: .95rem; color: var(--ink); }
  .choix__o em { font-style: normal; font-size: .82rem; font-weight: 400; color: var(--ink-mute); }

  .case {
    flex-direction: row !important; align-items: flex-start; gap: .65rem;
    font-family: 'Public Sans', sans-serif; font-size: .88rem; font-weight: 400;
    letter-spacing: 0; text-transform: none; color: var(--ink-soft);
  }
  .case input { width: 17px; height: 17px; flex: none; margin-top: .18rem; accent-color: var(--secours); }
  .case em { display: block; font-style: normal; font-size: .8rem; color: var(--ink-mute); margin-top: .2rem; }
  .case--rgpd { padding: 0 .2rem; }
  .case a { color: var(--azur); }

  .miel { position: absolute; left: -9999px; }
  .fm__envoi { align-self: flex-start; }
  .fm__contact { font-size: .88rem; color: var(--ink-mute); }
  .fm__contact a { color: var(--secours); font-weight: 600; }
</style>
