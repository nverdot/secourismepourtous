---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { asso } from '../../data/association';
import { villes, resumeReferences, type Ville } from '../../data/villes';
import { faqDps } from '../../data/faq';
import { filAriane, questionsFrequentes } from '../../lib/schema';

/**
 * Une page par commune où l'association intervient réellement.
 *
 * Ces pages n'existent que parce qu'il y a quelque chose à dire : les
 * dispositifs effectivement tenus sur place. Sans référence concrète, une page
 * de ce type n'est qu'un gabarit où l'on a changé le nom de la ville — Google
 * les repère et les déclasse, et un organisateur qui appelle en citant un
 * événement inventé le découvre en une phrase.
 *
 * La liste des communes vit dans src/data/villes.ts, avec la règle qui la régit.
 */

export function getStaticPaths() {
  return villes.map((v) => ({ params: { ville: v.slug }, props: { v } }));
}

interface Props { v: Ville }
const { v } = Astro.props;

const autres = villes.filter((x) => x.slug !== v.slug);

const titre = `Poste de secours ${v.article} | DPS événements`;
// Google coupe la description vers 160 signes : on cite deux références et on
// s'arrête, plutôt que de finir sur une phrase tronquée.
const description = (
  `Poste de secours ${v.article} : équipes de secouristes diplômés FFSS. ` +
  `${v.references.slice(0, 2).map((r) => r.nom).join(', ')}. Devis gratuit, réponse rapide.`
).slice(0, 158);

const balisages = [
  filAriane([
    { nom: 'Accueil', chemin: '/' },
    { nom: 'Postes de secours', chemin: '/postes-de-secours' },
    { nom: v.nom, chemin: `/postes-de-secours/${v.slug}` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Poste de secours ${v.article}`,
    serviceType: 'Dispositif prévisionnel de secours',
    description: v.contexte,
    provider: { '@id': 'https://www.secourismepourtous.org/#organisation' },
    areaServed: [
      { '@type': 'City', name: v.nom },
      ...v.alentours.map((a) => ({ '@type': 'City', name: a })),
    ],
  },
  questionsFrequentes(faqDps),
];

const ICONES = {
  sportif: 'M6 4v16M18 4v16M6 12h12M4 8h4M4 16h4M16 8h4M16 16h4',
  culturel: 'M9 18V5l12-2v13M9 13l12-2M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
  festif: 'm12 2 2.4 6.3L21 9l-5 4.2L17.6 20 12 16.5 6.4 20 8 13.2 3 9l6.6-.7z',
  populaire: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM22 21v-2a4 4 0 0 0-3-3.87',
};
---

<Base title={titre} description={description} chemin={`/postes-de-secours/${v.slug}`} schemas={balisages}>
  <header class="tete">
    <div class="tete__photo" aria-hidden="true"></div>
    <div class="tete__voile" aria-hidden="true"></div>
    <div class="wrap tete__in">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i>
        <a href="/postes-de-secours">Postes de secours</a><i aria-hidden="true">›</i>
        <b>{v.nom}</b>
      </nav>
      <div class="tete__badges">
        <span class="badge badge--contour">Affiliée FFSS</span>
        <span class="badge badge--contour">Agréée sécurité civile</span>
        {v.distanceMinutes > 0 && (
          <span class="badge badge--contour">{v.distanceMinutes} min de nos locaux</span>
        )}
      </div>
      <h1 class="tete__h1">Poste de secours<br />{v.article}</h1>
      <p class="tete__t">{v.contexte}</p>
      <div class="tete__actions">
        <a class="btn btn--primaire" href="/contact?motif=dps">
          Demander un devis
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn--fantome" href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
      </div>
    </div>
    <svg class="tete__vague" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,90 L0,44 C240,4 480,0 720,18 C960,36 1200,66 1440,44 L1440,90 Z" />
    </svg>
  </header>

  <!-- ========== RÉFÉRENCES ========== -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Nos interventions</p>
      <h2 class="h-section">Ce que nous couvrons {v.article}</h2>
      <p class="lede">
        Des dispositifs que nous avons réellement tenus, et les contraintes
        propres à chacun.
      </p>

      <div class="refs">
        {v.references.map((r) => (
          <article class="ref">
            <span class="ref__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d={ICONES[r.genre]} />
              </svg>
            </span>
            <h3>{r.nom}</h3>
            <p>{r.texte}</p>
          </article>
        ))}
      </div>

      {v.alentours.length > 0 && (
        <p class="autour">
          Depuis {v.nom}, nous couvrons aussi&nbsp;: {v.alentours.join(', ')}.
        </p>
      )}
    </div>
  </section>

  <!-- ========== DÉMARCHE ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Comment ça se passe</p>
      <h2 class="h-section">De votre demande au jour J</h2>
      <ol class="etapes">
        <li class="etape">
          <span class="etape__n">1</span>
          <div>
            <h3>Vous nous décrivez votre événement</h3>
            <p>Nature, lieu {v.article}, dates, horaires et affluence attendue.</p>
          </div>
        </li>
        <li class="etape">
          <span class="etape__n">2</span>
          <div>
            <h3>Nous évaluons le dispositif</h3>
            <p>Le référentiel national fixe le nombre de secouristes et de moyens selon l’affluence et les risques.</p>
          </div>
        </li>
        <li class="etape">
          <span class="etape__n">3</span>
          <div>
            <h3>Vous recevez une proposition</h3>
            <p>Composition de l’équipe, matériel engagé et tarif, pour votre dossier auprès de la mairie ou de la préfecture.</p>
          </div>
        </li>
        <li class="etape">
          <span class="etape__n">4</span>
          <div>
            <h3>Nous sécurisons votre événement</h3>
            <p>Nos secouristes diplômés sont sur place, en liaison avec les services de secours publics.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section">
    <div class="wrap">
      <Faq
        titre={`Vos questions sur les postes de secours ${v.article}`}
        questions={faqDps}
      />
    </div>
  </section>

  <!-- ========== AUTRES VILLES ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Ailleurs dans le 06</p>
      <h2 class="h-section">Nous intervenons aussi</h2>
      <div class="villes">
        {autres.map((a) => (
          <a class="ville" href={`/postes-de-secours/${a.slug}`}>
            <strong>{a.nom}</strong>
            <span>{resumeReferences(a)}</span>
          </a>
        ))}
        <a class="ville ville--tout" href="/postes-de-secours">
          <strong>Tout le département</strong>
          <span>Notre offre complète de dispositifs prévisionnels</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== APPEL ========== -->
  <section class="section section--appel">
    <div class="wrap wrap--etroit appel">
      <div>
        <h2 class="appel__h">Un événement à sécuriser {v.article}&nbsp;?</h2>
        <p class="lede">
          Décrivez-nous votre projet : nature, lieu, dates et affluence attendue.
          Nous revenons vers vous avec un dispositif adapté et un devis.
        </p>
      </div>
      <div class="appel__actions">
        <a class="btn btn--primaire" href="/contact?motif=dps">Demander un devis</a>
        <a class="btn btn--fantome" href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tete { position: relative; background: var(--navy-deep); color: var(--on-navy); overflow: hidden; }
  .tete__photo { position: absolute; inset: 0; background: url('/img/dps-hero.jpg') center 62% / cover; }
  .tete__voile {
    position: absolute; inset: 0;
    background: linear-gradient(97deg, rgba(7,23,38,.92) 0%, rgba(7,23,38,.78) 34%, rgba(9,32,54,.42) 68%, rgba(11,37,64,.26) 100%);
  }
  @media (max-width: 820px) {
    .tete__voile { background: linear-gradient(180deg, rgba(7,23,38,.82) 0%, rgba(7,23,38,.9) 60%, rgba(7,23,38,.95) 100%); }
  }
  .tete__in { position: relative; z-index: 1; padding-block: clamp(1.5rem,4vw,2.25rem) clamp(4.5rem,10vw,7rem); }

  .tete__badges { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.25rem; }
  .tete__h1 { font-size: clamp(2rem,5.5vw,3.4rem); font-weight: 800; line-height: 1.05; margin-bottom: 1.1rem; }
  .tete__t { max-width: 56ch; color: var(--on-navy-text); font-size: clamp(1rem,2.2vw,1.12rem); margin-bottom: 2rem; }
  .tete__actions { display: flex; flex-wrap: wrap; gap: .9rem; }
  .tete__vague { position: absolute; left: 0; right: 0; bottom: -1px; z-index: 1; width: 100%; height: auto; }
  .tete__vague path { fill: var(--ground); }

  .refs {
    margin-top: 2.5rem; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  }
  .ref {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(1.25rem,3vw,1.6rem);
  }
  .ref__ic {
    display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 12px;
    background: var(--azur-wash); color: var(--azur); margin-bottom: .85rem;
  }
  .ref__ic svg { width: 21px; height: 21px; }
  .ref h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: .4rem; }
  .ref p { font-size: .92rem; color: var(--ink-soft); }

  .autour { margin-top: 1.5rem; font-size: .92rem; color: var(--ink-mute); max-width: 70ch; }

  .etapes {
    list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(260px,100%), 1fr));
  }
  .etape {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(1.25rem,3vw,1.5rem);
  }
  .etape__n {
    flex: none; width: 34px; height: 34px; border-radius: 50%;
    background: var(--secours); color: #fff; display: grid; place-items: center;
    font-family: 'Archivo', sans-serif; font-weight: 800; font-size: .95rem;
  }
  .etape h3 { font-size: 1rem; font-weight: 700; margin-bottom: .25rem; }
  .etape p { font-size: .91rem; color: var(--ink-soft); }

  .villes {
    margin-top: 2.5rem; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
  }
  .ville {
    display: flex; flex-direction: column; gap: .3rem;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 1.15rem 1.3rem;
    text-decoration: none; color: inherit;
    transition: border-color .15s;
  }
  .ville:hover { border-color: var(--secours); }
  .ville strong { font-family: 'Archivo', sans-serif; font-size: 1rem; font-weight: 700; }
  .ville span { font-size: .85rem; color: var(--ink-mute); }
  .ville--tout { border-style: dashed; }

  .appel { display: flex; flex-wrap: wrap; gap: 1.75rem; align-items: center; justify-content: space-between; }
  .appel__h { font-size: clamp(1.5rem,3.5vw,2rem); font-weight: 800; margin-bottom: .6rem; }
  .appel__actions { display: flex; flex-wrap: wrap; gap: .8rem; }
</style>
