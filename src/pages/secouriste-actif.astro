---
import Base from '../layouts/Base.astro';
import { asso } from '../data/association';

/**
 * « Devenir secouriste actif » — recrutement de bénévoles pour les postes de
 * secours.
 *
 * Reprise de la page du site historique, avec le même fond : le PSE1 est le
 * prérequis, le reste est un engagement libre. La promesse tient en une idée —
 * on se positionne quand on veut — et c'est elle qui décide quelqu'un, pas la
 * liste des avantages. Elle passe donc avant tout le reste.
 */

const avantages = [
  {
    titre: 'Vous choisissez vos dates',
    texte: "Vous vous positionnez sur les postes qui vous conviennent, quand vous le pouvez. Aucun quota, aucune astreinte imposée.",
    icone: 'agenda',
  },
  {
    titre: 'Des dispositifs très variés',
    texte: 'Festivals, motocross, matchs de basket, feux d’artifice, épreuves sportives : rarement deux fois le même terrain.',
    icone: 'terrain',
  },
  {
    titre: 'Une équipe soudée',
    texte: 'Journées de formation, sorties en soirée, challenges entre secouristes : une équipe dynamique, joyeuse et solidaire.',
    icone: 'equipe',
  },
  {
    titre: 'Vos formations continues assurées',
    texte: 'Vos recyclages annuels sont réalisés au sein de l’association : votre diplôme reste valide sans démarche de votre côté.',
    icone: 'diplome',
  },
  {
    titre: 'La tenue prêtée',
    texte: 'Une tenue FFSS complète vous est prêtée : vous n’avez rien à acheter pour commencer.',
    icone: 'tenue',
  },
  {
    titre: 'Une expérience qui compte',
    texte: 'Gestion du stress, travail en équipe, sens des responsabilités : des compétences qui pèsent sur un CV comme dans la vie.',
    icone: 'cv',
  },
];

const etapes = [
  {
    n: 1,
    titre: 'Vous avez le PSE1',
    texte: "Le PSE1 est le seul prérequis obligatoire. Il est accessible dès 16 ans.",
  },
  {
    n: 2,
    titre: 'Vous ne l’avez pas encore ?',
    texte: "Nous vous formons. Des solutions de financement ou de conventionnement existent, sous conditions : parlons-en.",
  },
  {
    n: 3,
    titre: 'Vous rejoignez l’équipe',
    texte: "Accès à l’agenda des postes via WhatsApp et la plateforme EOS de la FFSS. Vous vous positionnez librement.",
  },
];
---

<Base
  title="Devenir secouriste actif à Nice | Secourisme Pour Tous"
  description="Rejoignez nos équipes de secouristes bénévoles à Nice et dans les Alpes-Maritimes. Postes de secours variés, formations continues assurées, tenue prêtée. Prérequis : PSE1."
  chemin="/secouriste-actif"
>
  <header class="tete">
    <div class="tete__photo" aria-hidden="true"></div>
    <div class="tete__voile" aria-hidden="true"></div>
    <div class="wrap tete__in">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i><b>Devenir secouriste actif</b>
      </nav>
      <div class="tete__badges">
        <span class="badge badge--contour">Bénévolat</span>
        <span class="badge badge--contour">Dès 16 ans, avec le PSE1</span>
      </div>
      <h1 class="tete__h1">Devenir<br />secouriste actif</h1>
      <p class="tete__t">
        Vous aimez l’urgence&nbsp;? Vous aimez aider votre prochain&nbsp;?
        Rejoignez l’équipe des secouristes actifs et participez à nos postes de secours.
      </p>
      <div class="tete__actions">
        <a class="btn btn--primaire" href="#rejoindre">
          Nous rejoindre
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn--fantome" href="/formations/pse-1">Découvrir le PSE1</a>
      </div>
    </div>
    <svg class="tete__vague" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,90 L0,44 C240,4 480,0 720,18 C960,36 1200,66 1440,44 L1440,90 Z" />
    </svg>
  </header>

  <!-- ========== CE QUE C'EST ========== -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">L'engagement</p>
      <h2 class="h-section">Ce que ça veut dire, concrètement</h2>
      <p class="lede">
        Être secouriste actif chez nous, c’est du bénévolat encadré : vous donnez
        du temps quand vous en avez, et l’association vous équipe, vous forme et
        vous accompagne.
      </p>

      <div class="atouts">
        {avantages.map((a) => (
          <article class="atout">
            <span class="atout__ic" aria-hidden="true">
              {a.icone === 'agenda' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4" /></svg>}
              {a.icone === 'terrain' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M5 20V9l7-5 7 5v11" /><path d="M10 20v-5h4v5" /></svg>}
              {a.icone === 'equipe' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>}
              {a.icone === 'diplome' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6" /><path d="m8.5 14-1.5 7 5-3 5 3-1.5-7" /></svg>}
              {a.icone === 'tenue' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3 4 6v5h3v10h10V11h3V6l-5-3" /><path d="M9 3a3 3 0 0 0 6 0" /></svg>}
              {a.icone === 'cv' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M9 13h6M9 17h4" /></svg>}
            </span>
            <h3>{a.titre}</h3>
            <p>{a.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== COMMENT ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Y venir</p>
      <h2 class="h-section">Un seul prérequis&nbsp;: le PSE1</h2>
      <ol class="etapes">
        {etapes.map((e) => (
          <li class="etape">
            <span class="etape__n">{e.n}</span>
            <div>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== FORMULAIRE ========== -->
  <section class="section" id="rejoindre" aria-labelledby="t-rejoindre">
    <div class="wrap wrap--etroit">
      <p class="eyebrow">Nous écrire</p>
      <h2 class="h-section" id="t-rejoindre">S’informer ou nous rejoindre</h2>
      <p class="lede">
        Dites-nous où vous en êtes — diplômé, en cours de formation, ou simplement
        curieux. Nous répondons sous 48 heures ouvrées.
      </p>

      <form class="fm" name="secouriste-actif" method="POST" action="/api/contact"
            data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="secouriste-actif" />
        <input type="hidden" name="motif" value="Devenir secouriste actif" />
        <p class="miel"><label>Ne pas remplir : <input name="bot-field" /></label></p>

        <div class="duo">
          <label>Prénom *<input type="text" name="prenom" autocomplete="given-name" required /></label>
          <label>Nom *<input type="text" name="nom" autocomplete="family-name" required /></label>
        </div>
        <div class="duo">
          <label>E-mail *<input type="email" name="email" autocomplete="email" required /></label>
          <label>Téléphone<input type="tel" name="telephone" autocomplete="tel" /></label>
        </div>

        <label>Où en êtes-vous&nbsp;? *
          <select name="niveau" required>
            <option value="">Choisissez…</option>
            <option value="Titulaire du PSE1">Je suis titulaire du PSE1</option>
            <option value="En cours de formation PSE1">Je suis en cours de formation PSE1</option>
            <option value="Sans PSE1, souhaite se former">Je n’ai pas le PSE1 et je souhaite me former</option>
            <option value="Titulaire d'un autre diplôme">J’ai un autre diplôme de secourisme</option>
          </select>
        </label>

        <label>Votre message
          <textarea name="message" rows="5"
            placeholder="Vos disponibilités, vos motivations, vos questions…"></textarea>
        </label>

        <label class="case">
          <input type="checkbox" name="consentement" required />
          <span>
            J’accepte que mes informations soient utilisées pour traiter ma demande.
            Elles ne sont ni cédées ni revendues.
            <a href="/politique-de-confidentialite">En savoir plus</a>
          </span>
        </label>

        <button type="submit" class="btn btn--primaire fm__envoi">
          Envoyer ma demande
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </form>

      <p class="fm__direct">
        Vous préférez appeler&nbsp;?
        <a href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
        — ou écrire à <a href={`mailto:${asso.contact.email}`}>{asso.contact.email}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .tete { position: relative; background: var(--navy-deep); color: var(--on-navy); overflow: hidden; }
  .tete__photo {
    position: absolute; inset: 0;
    background: url('/img/dps/tour-de-france-massena.jpg') center 62% / cover;
  }
  .tete__voile {
    position: absolute; inset: 0;
    background: linear-gradient(97deg, rgba(7,23,38,.96) 0%, rgba(7,23,38,.9) 34%, rgba(9,32,54,.58) 68%, rgba(11,37,64,.42) 100%);
  }
  @media (max-width: 820px) {
    .tete__voile { background: linear-gradient(180deg, rgba(7,23,38,.86) 0%, rgba(7,23,38,.92) 60%, rgba(7,23,38,.96) 100%); }
  }
  .tete__in { position: relative; z-index: 1; padding-block: clamp(1.5rem,4vw,2.25rem) clamp(4.5rem,10vw,7rem); }

  .fil {
    display: flex; gap: .5rem; align-items: center;
    font-family: 'Archivo', sans-serif; font-size: .72rem; font-weight: 600;
    letter-spacing: .11em; text-transform: uppercase; color: var(--on-navy-soft);
    margin-bottom: clamp(1.5rem,4vw,2.5rem);
  }
  .fil a { color: inherit; text-decoration: none; }
  .fil a:hover { color: #fff; }
  .fil i { opacity: .45; font-style: normal; }
  .fil b { color: #fff; font-weight: 600; }

  .tete__badges { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.25rem; }
  .tete__h1 { font-size: clamp(2.1rem,6vw,3.6rem); font-weight: 800; line-height: 1.03; margin-bottom: 1.1rem; }
  .tete__t { max-width: 50ch; color: var(--on-navy-text); font-size: clamp(1rem,2.2vw,1.12rem); margin-bottom: 2rem; }
  .tete__actions { display: flex; flex-wrap: wrap; gap: .9rem; }
  .tete__vague { position: absolute; left: 0; right: 0; bottom: -1px; z-index: 1; width: 100%; height: auto; }
  .tete__vague path { fill: var(--ground); }

  .atouts {
    margin-top: 2.5rem; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr));
  }
  .atout {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(1.25rem,3vw,1.6rem);
  }
  .atout__ic {
    display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 12px;
    background: var(--azur-wash); color: var(--azur); margin-bottom: .85rem;
  }
  .atout__ic svg { width: 21px; height: 21px; }
  .atout h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: .4rem; }
  .atout p { font-size: .92rem; color: var(--ink-soft); }

  .etapes {
    list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  }
  .etape {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(1.25rem,3vw,1.5rem);
  }
  .etape__n {
    flex: none; width: 34px; height: 34px; border-radius: 50%;
    background: var(--secours); color: #fff; display: grid; place-items: center;
    font-family: 'Archivo', sans-serif; font-weight: 800; font-size: .95rem;
  }
  .etape h3 { font-size: 1rem; font-weight: 700; margin-bottom: .25rem; }
  .etape p { font-size: .91rem; color: var(--ink-soft); }

  .fm { margin-top: 2rem; display: flex; flex-direction: column; gap: 1rem; }
  .duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px,100%),1fr)); gap: 1rem; }
  .fm label { display: flex; flex-direction: column; gap: .35rem; font-size: .85rem; font-weight: 600; color: var(--ink-soft); }
  .fm input[type='text'], .fm input[type='email'], .fm input[type='tel'], .fm select, .fm textarea {
    min-width: 0; font: inherit; font-size: .97rem; font-weight: 400; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-sm); padding: .7rem .85rem; width: 100%;
  }
  .fm input:focus, .fm select:focus, .fm textarea:focus {
    outline: 2px solid var(--azur); outline-offset: 1px; border-color: transparent;
  }
  .fm textarea { resize: vertical; }
  .fm .case { flex-direction: row; align-items: flex-start; gap: .6rem; font-weight: 400; font-size: .86rem; }
  .fm .case input { width: 17px; height: 17px; margin-top: .18rem; flex: none; accent-color: var(--secours); }
  .fm .case a { color: var(--azur); }
  .miel { position: absolute; left: -9999px; }
  .fm__envoi { align-self: flex-start; margin-top: .3rem; }
  .fm__direct { margin-top: 1.5rem; font-size: .9rem; color: var(--ink-mute); }
  .fm__direct a { color: var(--azur); }
</style>
