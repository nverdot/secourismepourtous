---
import Base from '../layouts/Base.astro';
import { asso } from '../data/association';

/**
 * Page « Postes de secours » — dispositifs prévisionnels de secours (DPS).
 *
 * Cible différente du reste du site : ici le visiteur est un organisateur
 * d'événement, pas un stagiaire. Le parcours vise donc la demande de devis,
 * pas l'inscription à une session.
 */

const typesEvenements = [
  { titre: 'Manifestations sportives', texte: 'Courses, compétitions, tournois, épreuves en milieu aquatique.' },
  { titre: 'Concerts et festivals', texte: 'Rassemblements de public, de la salle municipale au grand plein air.' },
  { titre: 'Fêtes locales', texte: 'Fêtes de village, marchés, cérémonies et rassemblements associatifs.' },
  { titre: 'Événements culturels', texte: 'Expositions, spectacles, tournages et manifestations de plein air.' },
];

const etapes = [
  { n: 1, titre: 'Vous nous décrivez votre événement', texte: 'Nature, lieu, dates, horaires et nombre de participants attendus.' },
  { n: 2, titre: 'Nous évaluons le dispositif', texte: "Le référentiel national fixe le nombre de secouristes et de moyens selon l'affluence et les risques." },
  { n: 3, titre: 'Vous recevez une proposition', texte: 'Composition de l’équipe, matériel engagé et tarif, pour votre dossier auprès de la préfecture ou de la mairie.' },
  { n: 4, titre: 'Nous sécurisons votre événement', texte: 'Nos secouristes diplômés sont sur place, en liaison avec les services de secours publics.' },
];
---

<Base
  title="Poste de secours à Nice | DPS événements dans le 06"
  description="Sécurisez votre événement avec un dispositif prévisionnel de secours à Nice. Secouristes diplômés agréés FFSS, du petit rassemblement au grand public."
  chemin="/postes-de-secours"
>
  <header class="tete">
    <div class="tete__photo" aria-hidden="true"></div>
    <div class="tete__voile" aria-hidden="true"></div>
    <div class="wrap tete__in">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i><b>Postes de secours</b>
      </nav>
      <div class="tete__badges">
        <span class="badge badge--qualiopi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          Agréée sécurité civile FFSS
        </span>
        <span class="badge badge--contour">270 dispositifs par an</span>
      </div>
      <h1 class="tete__h1">Dispositifs prévisionnels<br />de secours</h1>
      <p class="tete__t">
        Vous organisez un événement dans les Alpes-Maritimes&nbsp;? Nos équipes de
        secouristes diplômés assurent la sécurité de votre public, du petit
        rassemblement à la manifestation de grande ampleur.
      </p>
      <div class="tete__actions">
        <a class="btn btn--primaire" href="/contact">
          Demander un devis
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn--fantome" href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
      </div>
    </div>
    <svg class="tete__vague" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,90 L0,44 C240,4 480,0 720,18 C960,36 1200,66 1440,44 L1440,90 Z" />
    </svg>
  </header>

  <!-- ========== CHIFFRES ========== -->
  <section class="wrap faits" aria-label="Notre expérience">
    <div class="faits__grille">
      <div class="fait">
        <span class="fait__v">270<i>+</i></span>
        <span class="fait__l">dispositifs par an</span>
        <span class="fait__d">dans les Alpes-Maritimes</span>
      </div>
      <div class="fait">
        <span class="fait__v">70<i>+</i></span>
        <span class="fait__l">secouristes mobilisables</span>
        <span class="fait__d">diplômés et nageurs-sauveteurs</span>
      </div>
      <div class="fait">
        <span class="fait__v">2008</span>
        <span class="fait__l">depuis</span>
        <span class="fait__d">sur toute la Côte d'Azur</span>
      </div>
    </div>
  </section>

  <!-- ========== TYPES ========== -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Nos interventions</p>
      <h2 class="h-section">Tous les types d'événements</h2>
      <p class="lede">
        Chaque dispositif est dimensionné selon la nature de l'événement, l'affluence
        attendue et les risques identifiés.
      </p>
      <div class="types">
        {typesEvenements.map((t) => (
          <article class="type">
            <h3>{t.titre}</h3>
            <p>{t.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== DEMARCHE ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Comment ça se passe</p>
      <h2 class="h-section">De votre demande au jour J</h2>
      <ol class="etapes">
        {etapes.map((e) => (
          <li class="etape">
            <span class="etape__n">{e.n}</span>
            <div>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== APPEL ========== -->
  <section class="section section--navy">
    <div class="wrap wrap--etroit appel">
      <div>
        <h2 class="appel__h">Un événement à sécuriser&nbsp;?</h2>
        <p class="lede">
          Décrivez-nous votre projet : nature, lieu, dates et affluence attendue.
          Nous revenons vers vous avec un dispositif adapté et un devis.
        </p>
      </div>
      <div class="appel__actions">
        <a class="btn btn--primaire" href="/contact">Demander un devis</a>
        <a class="btn btn--fantome" href={`tel:${asso.contact.telephoneLien}`}>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
          {asso.contact.telephone}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tete { position: relative; background: var(--navy-deep); color: var(--on-navy); overflow: hidden; }
  .tete__photo { position: absolute; inset: 0; background: url('/img/poste-de-secours.jpg') center 40%/cover; }
  .tete__voile {
    position: absolute; inset: 0;
    background: linear-gradient(97deg, rgba(7,23,38,.96) 0%, rgba(7,23,38,.9) 34%, rgba(9,32,54,.58) 68%, rgba(11,37,64,.42) 100%);
  }
  @media (max-width: 820px) {
    .tete__voile { background: linear-gradient(180deg, rgba(7,23,38,.88) 0%, rgba(7,23,38,.93) 60%, rgba(7,23,38,.96) 100%); }
  }
  .tete__in { position: relative; z-index: 1; padding-block: clamp(1.5rem,4vw,2.25rem) clamp(4.5rem,10vw,7rem); }

  .fil {
    display: flex; gap: .5rem; align-items: center;
    font-family: 'Archivo', sans-serif; font-size: .72rem; font-weight: 600;
    letter-spacing: .11em; text-transform: uppercase; color: var(--on-navy-soft);
    margin-bottom: clamp(1.5rem,4vw,2.5rem);
  }
  .fil a { color: inherit; text-decoration: none; }
  .fil a:hover { color: #fff; }
  .fil i { opacity: .45; font-style: normal; }
  .fil b { color: #fff; font-weight: 600; }

  .tete__badges { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.25rem; }
  .tete__h1 { font-size: clamp(2.1rem,6vw,3.6rem); font-weight: 800; line-height: 1.03; margin-bottom: 1.1rem; }
  .tete__t { max-width: 50ch; color: var(--on-navy-text); font-size: clamp(1rem,2.2vw,1.12rem); margin-bottom: 2rem; }
  .tete__actions { display: flex; flex-wrap: wrap; gap: .9rem; }

  .tete__vague { position: absolute; left: 0; right: 0; bottom: -1px; z-index: 1; width: 100%; height: auto; }
  .tete__vague path { fill: var(--ground); }

  .faits { position: relative; z-index: 2; margin-top: clamp(-3.5rem,-5vw,-2rem); }
  .faits__grille { display: grid; gap: clamp(.7rem,1.6vw,1rem); grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); }
  .fait {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: clamp(1.25rem,2.8vw,1.6rem); box-shadow: var(--sh-md);
    display: flex; flex-direction: column; gap: .15rem;
  }
  .fait__v {
    font-family: 'Archivo', sans-serif; font-size: clamp(2.1rem,5vw,2.75rem);
    font-weight: 800; line-height: 1; color: var(--azur); font-variant-numeric: tabular-nums;
  }
  .fait__v i { font-style: normal; color: var(--secours); }
  .fait__l { font-weight: 600; margin-top: .35rem; }
  .fait__d { font-size: .85rem; color: var(--ink-mute); }

  .types { margin-top: 2.5rem; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit,minmax(250px,1fr)); }
  .type { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.25rem,3vw,1.6rem); }
  .type h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: .4rem; }
  .type p { font-size: .92rem; color: var(--ink-soft); }

  .etapes { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); }
  .etape { display: flex; gap: 1rem; align-items: flex-start; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.25rem,3vw,1.5rem); }
  .etape__n {
    flex: none; width: 34px; height: 34px; border-radius: 50%;
    background: var(--secours); color: #fff;
    display: grid; place-items: center;
    font-family: 'Archivo', sans-serif; font-weight: 800; font-size: .95rem;
  }
  .etape h3 { font-size: 1rem; font-weight: 700; margin-bottom: .25rem; }
  .etape p { font-size: .91rem; color: var(--ink-soft); }

  .appel { display: flex; flex-wrap: wrap; gap: 1.75rem; align-items: center; justify-content: space-between; }
  .appel__h { font-size: clamp(1.5rem,3.5vw,2rem); font-weight: 800; margin-bottom: .6rem; }
  .appel__actions { display: flex; flex-wrap: wrap; gap: .8rem; }
</style>
