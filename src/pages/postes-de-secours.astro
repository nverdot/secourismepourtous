---
import Base from '../layouts/Base.astro';
import { villes, resumeReferences } from '../data/villes';
import Faq from '../components/Faq.astro';
import { faqDps } from '../data/faq';
import { questionsFrequentes } from '../lib/schema';
import { servicePostesDeSecours, filAriane } from '../lib/schema';
import { asso } from '../data/association';
import CarrouselDps from '../components/CarrouselDps.astro';

/**
 * Page « Postes de secours » — dispositifs prévisionnels de secours (DPS).
 *
 * Cible différente du reste du site : ici le visiteur est un organisateur
 * d'événement, pas un stagiaire. Le parcours vise donc la demande de devis,
 * pas l'inscription à une session.
 */

const typesEvenements = [
  { titre: 'Manifestations sportives', texte: 'Courses, compétitions, tournois, épreuves en milieu aquatique.' },
  { titre: 'Concerts et festivals', texte: 'Rassemblements de public, de la salle municipale au grand plein air.' },
  { titre: 'Fêtes locales', texte: 'Fêtes de village, marchés, cérémonies et rassemblements associatifs.' },
  { titre: 'Événements culturels', texte: 'Expositions, spectacles, tournages et manifestations de plein air.' },
];

/**
 * Images du terrain. Les libellés décrivent le type de dispositif, jamais les
 * personnes : ce sont des bénévoles, la page parle de leur mission.
 */
const terrain = [
  {
    video: '/video/dps-beach-volley.mp4',
    affiche: '/img/dps/beach-volley.jpg',
    titre: 'Tournoi de beach-volley',
    texte: 'Surveillance du terrain et du public jusqu’à la fin des matchs.',
  },
  {
    video: '/video/dps-nice-massena.mp4',
    affiche: '/img/dps/nice-massena.jpg',
    titre: 'Épreuve cycliste, place Masséna',
    texte: 'Équipe en déplacement sur un événement de grande affluence, à Nice.',
  },
  {
    video: '/video/dps-beach-volley-installation.mp4',
    affiche: '/img/dps/beach-volley-installation.jpg',
    titre: 'Mise en place du poste',
    texte: 'Arrivée sur site et installation avant l’ouverture au public.',
  },
];

const etapes = [
  { n: 1, titre: 'Vous nous décrivez votre événement', texte: 'Nature, lieu, dates, horaires et nombre de participants attendus.' },
  { n: 2, titre: 'Nous évaluons le dispositif', texte: "Le référentiel national fixe le nombre de secouristes et de moyens selon l'affluence et les risques." },
  { n: 3, titre: 'Vous recevez une proposition', texte: 'Composition de l’équipe, matériel engagé et tarif, pour votre dossier auprès de la préfecture ou de la mairie.' },
  { n: 4, titre: 'Nous sécurisons votre événement', texte: 'Nos secouristes diplômés sont sur place, en liaison avec les services de secours publics.' },
];
---

<Base
  title="Poste de secours à Nice | DPS événements dans le 06"
  description="Sécurisez votre événement avec un dispositif prévisionnel de secours à Nice. Secouristes diplômés agréés FFSS, du petit rassemblement au grand public."
  chemin="/postes-de-secours"
  schemas={[
    servicePostesDeSecours(),
    questionsFrequentes(faqDps),
    filAriane([
      { nom: 'Accueil', chemin: '/' },
      { nom: 'Postes de secours', chemin: '/postes-de-secours' },
    ]),
  ]}
>
  <header class="tete">
    <div class="tete__photo" aria-hidden="true"></div>
    <div class="tete__voile" aria-hidden="true"></div>
    <div class="wrap tete__in">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i><b>Postes de secours</b>
      </nav>
      <div class="tete__badges">
        <a class="badge badge--qualiopi" href="/documents/certificat-qualiopi.pdf"
            target="_blank" rel="noopener" title="Consulter notre certificat Qualiopi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          Agréée sécurité civile FFSS
        </a>
        <span class="badge badge--contour">270+ dispositifs par an</span>
      </div>
      <h1 class="tete__h1">Dispositifs prévisionnels<br />de secours</h1>
      <p class="tete__t">
        Vous organisez un événement dans les Alpes-Maritimes&nbsp;? Nos équipes de
        secouristes diplômés assurent la sécurité de votre public, du petit
        rassemblement à la manifestation de grande ampleur.
      </p>
      <div class="tete__actions">
        <a class="btn btn--primaire" href="/contact?motif=dps">
          Demander un devis
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn--fantome" href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
      </div>
    </div>
    <svg class="tete__vague" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,90 L0,44 C240,4 480,0 720,18 C960,36 1200,66 1440,44 L1440,90 Z" />
    </svg>
  </header>

  <!-- ========== CHIFFRES ========== -->
  <section class="wrap faits" aria-label="Notre expérience">
    <div class="faits__grille">
      <div class="fait">
        <span class="fait__v">270<i>+</i></span>
        <span class="fait__l">dispositifs par an</span>
        <span class="fait__d">dans les Alpes-Maritimes</span>
      </div>
      <div class="fait">
        <span class="fait__v">70<i>+</i></span>
        <span class="fait__l">secouristes mobilisables</span>
        <span class="fait__d">diplômés et nageurs-sauveteurs</span>
      </div>
      <div class="fait">
        <span class="fait__v">2008</span>
        <span class="fait__l">depuis</span>
        <span class="fait__d">sur toute la Côte d'Azur</span>
      </div>
    </div>
  </section>

  <!-- ========== TYPES ========== -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Nos interventions</p>
      <h2 class="h-section">Tous les types d'événements</h2>
      <p class="lede">
        Chaque dispositif est dimensionné selon la nature de l'événement, l'affluence
        attendue et les risques identifiés.
      </p>
      <div class="types">
        {typesEvenements.map((t) => (
          <article class="type">
            <h3>{t.titre}</h3>
            <p>{t.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== DEMARCHE ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Comment ça se passe</p>
      <h2 class="h-section">De votre demande au jour J</h2>
      <ol class="etapes">
        {etapes.map((e) => (
          <li class="etape">
            <span class="etape__n">{e.n}</span>
            <div>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== TERRAIN ========== -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Sur le terrain</p>
      <h2 class="h-section">Nos équipes en dispositif</h2>
      <p class="lede">
        Quelques images prises lors de dispositifs récents dans les Alpes-Maritimes.
      </p>
      <CarrouselDps orientation="paysage" />

      <div class="terrain">
        {terrain.map((t) => (
          <figure class="clip">
            <video
              src={t.video}
              poster={t.affiche}
              muted
              loop
              playsinline
              preload="none"
              aria-label={t.titre}
            ></video>
            <figcaption>
              <strong>{t.titre}</strong>
              <span>{t.texte}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <CarrouselDps orientation="portrait" />
    </div>
  </section>

  <!-- ========== VILLES ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Sur le terrain</p>
      <h2 class="h-section">Où nous intervenons</h2>
      <p class="lede">
        Nous couvrons tout le département. Voici les communes où nous revenons
        le plus souvent, et ce que nous y sécurisons.
      </p>
      <div class="villes">
        {villes.map((v) => (
          <a class="ville" href={`/postes-de-secours/${v.slug}`}>
            <strong>{v.nom}</strong>
            <span>{resumeReferences(v)}</span>
            <svg class="ville__f" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Deux capacités que peu d'associations peuvent annoncer, et qui changent
      concrètement ce qui se passe quand une victime doit partir. */}
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Nos moyens</p>
      <h2 class="h-section">Ce que nos équipes peuvent faire sur place</h2>
      <p class="lede">
        Un poste de secours ne se limite pas à attendre les pompiers. Deux
        conventions étendent ce que nous prenons en charge nous-mêmes.
      </p>

      <div class="moyens">
        <article class="moyen">
          <span class="moyen__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 19a2 2 0 1 0 4 0 2 2 0 1 0-4 0M18 19a2 2 0 1 0 4 0 2 2 0 1 0-4 0" />
              <path d="M2 6h11v13H2zM13 10h4l4 4v5h-3" />
            </svg>
          </span>
          <h3>Nous évacuons nous-mêmes</h3>
          <p>
            Une convention tripartite nous autorise à transporter une victime
            vers l’hôpital depuis nos dispositifs, sur demande du SAMU. Le
            patient part avec l’équipe qui l’a prise en charge, sans attendre
            un vecteur supplémentaire — et un moyen public reste disponible
            pour ailleurs.
          </p>
        </article>

        <article class="moyen">
          <span class="moyen__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12h4l2-6 4 12 2.5-7 1.5 3h6" />
            </svg>
          </span>
          <h3>Nous réalisons un ECG sur place</h3>
          <p>
            Nos véhicules de premiers secours embarquent un
            électrocardiographe. Devant une douleur thoracique, le tracé est
            réalisé au poste et transmis au SAMU, qui décide au vu de l’examen
            plutôt que d’une description. Sur un infarctus, ces minutes-là
            comptent.
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* Les renforts hors département : ils disent l'échelle du réseau auquel
      appartient l'association, ce qu'une liste de communes ne montre pas. */}
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Au-delà du département</p>
      <h2 class="h-section">Nos équipes en renfort FFSS</h2>
      <p class="lede">
        Nos secouristes partent aussi en renfort sur les grands rassemblements
        nationaux, aux côtés des autres structures de la fédération. Ils en
        reviennent avec une expérience que les dispositifs locaux ne donnent
        pas — et qui nourrit ensuite nos formations.
      </p>
      <ul class="renforts">
        <li><strong>Concerts de Jul</strong><span>Stades et grandes salles, publics de plusieurs dizaines de milliers de personnes.</span></li>
        <li><strong>Bol d’Or</strong><span>Vingt-quatre heures de course moto : dispositif continu, jour et nuit.</span></li>
        <li><strong>Roc d’Azur</strong><span>Le plus grand rassemblement VTT d’Europe, sur des parcours étendus.</span></li>
        <li><strong>Hadra Trance Festival</strong><span>Festival sur plusieurs jours, avec camping et public en continu.</span></li>
        <li><strong>Tomorrowland — Alpe d’Huez</strong><span>Festival en altitude, en hiver : froid, neige et accès contraints.</span></li>
        <li><strong>Trail d’Oyonnax</strong><span>Course nature : postes échelonnés sur le parcours et équipes mobiles.</span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Faq
        titre="Vos questions sur les dispositifs de secours"
        intro="Effectifs, délais, tarifs, obligations : ce que demandent les organisateurs avant de nous confier leur événement."
        questions={faqDps}
      />
    </div>
  </section>

  <!-- ========== APPEL ========== -->
  <section class="section section--appel">
    <div class="wrap wrap--etroit appel">
      <div>
        <h2 class="appel__h">Un événement à sécuriser&nbsp;?</h2>
        <p class="lede">
          Décrivez-nous votre projet : nature, lieu, dates et affluence attendue.
          Nous revenons vers vous avec un dispositif adapté et un devis.
        </p>
      </div>
      <div class="appel__actions">
        <a class="btn btn--primaire" href="/contact?motif=dps">Demander un devis</a>
        <a class="btn btn--fantome" href={`tel:${asso.contact.telephoneLien}`}>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
          {asso.contact.telephone}
        </a>
      </div>
    </div>
  </section>

  <script>
    /**
     * Les clips ne se lancent qu'une fois visibles, et seulement si la personne
     * n'a pas demandé à limiter les animations. Ils restent muets : un son qui
     * démarre seul sur une page est une agression.
     */
    const clips = [...document.querySelectorAll('.clip video')];
    const sobre = matchMedia('(prefers-reduced-motion: reduce)');

    if (sobre.matches) {
      clips.forEach((v) => { v.controls = true; v.preload = 'metadata'; });
    } else if ('IntersectionObserver' in window) {
      const oeil = new IntersectionObserver((entrees) => {
        for (const e of entrees) {
          if (e.isIntersecting) e.target.play().catch(() => { e.target.controls = true; });
          else e.target.pause();
        }
      }, { threshold: 0.35 });
      clips.forEach((v) => oeil.observe(v));
    } else {
      clips.forEach((v) => { v.controls = true; });
    }
  </script>
</Base>

<style>
  .tete { position: relative; background: var(--navy-deep); color: var(--on-navy); overflow: hidden; }
  .tete__photo { position: absolute; inset: 0; background: url('/img/dps-hero.jpg') center 62%/cover; }
  .tete__voile {
    position: absolute; inset: 0;
    background: linear-gradient(97deg, rgba(7,23,38,.92) 0%, rgba(7,23,38,.78) 34%, rgba(9,32,54,.42) 68%, rgba(11,37,64,.26) 100%);
  }
  @media (max-width: 820px) {
    .tete__voile { background: linear-gradient(180deg, rgba(7,23,38,.88) 0%, rgba(7,23,38,.93) 60%, rgba(7,23,38,.96) 100%); }
  }
  .tete__in { position: relative; z-index: 1; padding-block: clamp(1.5rem,4vw,2.25rem) clamp(4.5rem,10vw,7rem); }

  .tete__badges { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.25rem; }
  .tete__h1 { font-size: clamp(2.1rem,6vw,3.6rem); font-weight: 800; line-height: 1.03; margin-bottom: 1.1rem; }
  .tete__t { max-width: 50ch; color: var(--on-navy-text); font-size: clamp(1rem,2.2vw,1.12rem); margin-bottom: 2rem; }
  .tete__actions { display: flex; flex-wrap: wrap; gap: .9rem; }

  .tete__vague { position: absolute; left: 0; right: 0; bottom: -1px; z-index: 1; width: 100%; height: auto; }
  .tete__vague path { fill: var(--ground); }

  .faits { position: relative; z-index: 2; margin-top: clamp(-3.5rem,-5vw,-2rem); }
  .faits__grille { display: grid; gap: clamp(.7rem,1.6vw,1rem); grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); }
  .fait {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: clamp(1.25rem,2.8vw,1.6rem); box-shadow: var(--sh-md);
    display: flex; flex-direction: column; gap: .15rem;
  }
  .fait__v {
    font-family: 'Archivo', sans-serif; font-size: clamp(2.1rem,5vw,2.75rem);
    font-weight: 800; line-height: 1; color: var(--azur); font-variant-numeric: tabular-nums;
  }
  .fait__v i { font-style: normal; color: var(--secours); }
  .fait__l { font-weight: 600; margin-top: .35rem; }
  .fait__d { font-size: .85rem; color: var(--ink-mute); }

  .types { margin-top: 2.5rem; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit,minmax(250px,1fr)); }
  .type { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.25rem,3vw,1.6rem); }
  .type h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: .4rem; }
  .type p { font-size: .92rem; color: var(--ink-soft); }

  .etapes { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); }
  .etape { display: flex; gap: 1rem; align-items: flex-start; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.25rem,3vw,1.5rem); }
  .etape__n {
    flex: none; width: 34px; height: 34px; border-radius: 50%;
    background: var(--secours); color: #fff;
    display: grid; place-items: center;
    font-family: 'Archivo', sans-serif; font-weight: 800; font-size: .95rem;
  }
  .etape h3 { font-size: 1rem; font-weight: 700; margin-bottom: .25rem; }
  .etape p { font-size: .91rem; color: var(--ink-soft); }

  /* Les clips sont filmés au téléphone : format portrait assumé. */
  .terrain {
    margin-top: 2.5rem; display: grid; gap: clamp(.8rem, 2vw, 1.15rem);
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
  }
  .clip { margin: 0; }
  .clip video {
    display: block; width: 100%; aspect-ratio: 9 / 16; object-fit: cover;
    background: var(--sunk);
    border-radius: var(--r-lg); border: 1px solid var(--line);
  }
  .clip figcaption { display: flex; flex-direction: column; gap: .15rem; margin-top: .7rem; }
  .clip figcaption strong { font-size: .96rem; font-weight: 700; }
  .clip figcaption span { font-size: .87rem; color: var(--ink-mute); }

  .villes {
    margin-top: 2.5rem; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
  }
  .ville {
    display: flex; flex-direction: column; gap: .3rem;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 1.15rem 1.3rem;
    text-decoration: none; color: inherit; position: relative;
    transition: border-color .15s, box-shadow .15s;
  }
  .ville:hover { border-color: var(--secours); box-shadow: var(--sh-md); }
  .ville strong { font-family: 'Archivo', sans-serif; font-size: 1.02rem; font-weight: 700; }
  .ville span { font-size: .85rem; color: var(--ink-mute); padding-right: 1.5rem; }
  .ville__f {
    position: absolute; right: 1.2rem; top: 1.3rem;
    width: 17px; height: 17px; color: var(--ink-mute);
  }
  .ville:hover .ville__f { color: var(--secours); }

  .appel { display: flex; flex-wrap: wrap; gap: 1.75rem; align-items: center; justify-content: space-between; }
  .appel__h { font-size: clamp(1.5rem,3.5vw,2rem); font-weight: 800; margin-bottom: .6rem; }
  .appel__actions { display: flex; flex-wrap: wrap; gap: .8rem; }

  .moyens {
    margin-top: 2rem; display: grid; gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }
  .moyen {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 1.5rem;
  }
  .moyen__ic {
    display: grid; place-items: center; width: 46px; height: 46px;
    border-radius: 13px; background: var(--secours); color: #fff; margin-bottom: 1rem;
  }
  .moyen__ic svg { width: 24px; height: 24px; }
  .moyen h3 { font-family: 'Archivo', sans-serif; font-size: 1.12rem; font-weight: 800; margin-bottom: .5rem; }
  .moyen p { color: var(--ink-mute); font-size: .95rem; }

  .renforts {
    margin-top: 2rem; list-style: none; padding: 0; display: grid; gap: .9rem;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  }
  .renforts li {
    display: flex; flex-direction: column; gap: .25rem;
    padding: 1rem 1.15rem; background: var(--sunk);
    border-radius: var(--r-md); border-left: 3px solid var(--azur);
  }
  .renforts strong { font-family: 'Archivo', sans-serif; font-size: 1rem; font-weight: 700; }
  .renforts span { font-size: .87rem; color: var(--ink-mute); }

  /* Sous 700 px, minmax(210px) ne tient plus qu'une colonne : les quatre
     repères s'empilent sur toute la hauteur de l'écran et repoussent le
     contenu. En 2×2 ils restent lisibles et tiennent dans le premier regard,
     comme les chiffres de la page d'accueil. */
  @media (max-width: 700px) {
    .faits__grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fait { padding: 1rem .95rem; gap: .35rem; }
    .fait__ic { width: 34px; height: 34px; border-radius: 10px; margin-bottom: .15rem; }
    .fait__ic svg { width: 18px; height: 18px; }
    .fait__label { font-size: .62rem; letter-spacing: .1em; }
    .fait__valeur { font-size: 1.15rem; }
    .fait__note { font-size: .76rem; }
  }
</style>
