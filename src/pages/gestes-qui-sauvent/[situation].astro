---
import Base from '../../layouts/Base.astro';
import Sessions from '../../components/Sessions.astro';
import ModuleInscription from '../../components/ModuleInscription.astro';
import { asso } from '../../data/association';
import { parSlug } from '../../data/formations';
import { situations, referentiel, type Situation } from '../../data/situations';
import { sessionsAVenir, sessionsDe } from '../../lib/wix';
import { filAriane } from '../../lib/schema';

/**
 * Une page par situation de premiers secours.
 *
 * Ces pages répondent d'abord à la question posée — « mon enfant s'étouffe,
 * que faire » — et seulement ensuite proposent la formation. L'inverse serait
 * malhonnête : quelqu'un qui cherche ça est en train de s'inquiéter, pas de
 * comparer des organismes.
 *
 * Le balisage HowTo décrit les étapes ; Google peut les reprendre telles
 * quelles. Raison de plus pour qu'elles soient exactes : voir l'avertissement
 * en tête de src/data/situations.ts.
 */

export function getStaticPaths() {
  return situations.map((s) => ({ params: { situation: s.slug }, props: { s } }));
}

interface Props { s: Situation }
const { s } = Astro.props;

const psc = parSlug('psc')!;
const toutes = await sessionsAVenir();
const sessions = sessionsDe(toutes, psc.wixEvent);

const autres = situations.filter((x) => x.slug !== s.slug);

const balisages = [
  filAriane([
    { nom: 'Accueil', chemin: '/' },
    { nom: 'Gestes qui sauvent', chemin: '/gestes-qui-sauvent' },
    { nom: s.court, chemin: `/gestes-qui-sauvent/${s.slug}` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: s.titre,
    description: s.accroche,
    totalTime: 'PT5M',
    step: s.faire.map((e, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: e.titre,
      text: e.texte,
    })),
  },
];
---

<Base
  title={s.seo.title}
  description={s.seo.description}
  chemin={`/gestes-qui-sauvent/${s.slug}`}
  schemas={balisages}
>
  <header class="tete">
    <div class="wrap">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i>
        <a href="/gestes-qui-sauvent">Gestes qui sauvent</a><i aria-hidden="true">›</i>
        <b>{s.court}</b>
      </nav>
      <h1 class="tete__h1">{s.titre}</h1>
      <p class="tete__t">{s.accroche}</p>
    </div>
  </header>

  <!-- Le numéro d'urgence avant tout le reste : si la personne est en train de
       vivre la situation, c'est la seule chose qu'elle doit lire. -->
  <div class="wrap">
    <aside class="urgence" role="note">
      <span class="urgence__ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
      </span>
      <div>
        <strong>Vous êtes face à la situation en ce moment&nbsp;?</strong>
        <p>
          Appelez le <a href={`tel:${s.numero}`}>{s.numero}</a> — ou le
          <a href="tel:112">112</a> depuis un portable. Le médecin régulateur
          vous guidera geste par geste, au téléphone, en attendant les secours.
        </p>
      </div>
    </aside>
  </div>

  <section class="section">
    <div class="wrap art">
      <div class="art__corps">
        <section class="bl">
          <h2>Reconnaître la situation</h2>
          <ul class="signes">
            {s.reconnaitre.map((r) => <li>{r}</li>)}
          </ul>
        </section>

        <section class="bl">
          <h2>La conduite à tenir</h2>
          <ol class="etapes">
            {s.faire.map((e, i) => (
              <li class="etape">
                <span class="etape__n">{i + 1}</span>
                <div>
                  <h3>{e.titre}</h3>
                  <p>{e.texte}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="bl">
          <h2>Ce qu’il ne faut pas faire</h2>
          <ul class="pieges">
            {s.pieges.map((p) => <li>{p}</li>)}
          </ul>
        </section>

        <p class="source">
          D’après la fiche <strong>{s.fiche.ref} — {s.fiche.nom}</strong>,
          actualisée en {s.fiche.maj}. Source&nbsp;: {referentiel.nom},
          {' '}{referentiel.edition}, {referentiel.auteur}.
        </p>
      </div>

      <aside class="art__cote">
        <div class="cote">
          <p class="cote__t">Qui est concerné</p>
          <p class="cote__x">{s.pourQui}</p>
        </div>

        <div class="cote cote--fort">
          <p class="cote__t">Lire ne suffit pas</p>
          <p class="cote__x">{s.enFormation}</p>
          <a class="btn btn--primaire cote__cta" href="#dates">
            Voir les dates du PSC
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <p class="cote__n">{psc.duree} · {psc.tarif} · dès {psc.prerequis.replace('Dès ', '')}</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ========== SE FORMER ========== -->
  <section class="section section--navy">
    <div class="wrap wrap--etroit form">
      <p class="eyebrow">Passer du savoir au geste</p>
      <h2 class="form__h">Une journée, et vous saurez le faire</h2>
      <p class="lede">
        Cette page vous dit quoi faire. Elle ne vous apprend pas à le faire —
        aucune page ne le peut. Le PSC dure {psc.duree.toLowerCase()}, coûte
        {' '}{psc.tarif}, et se passe entièrement en mise en situation&nbsp;:
        vous répétez les gestes jusqu’à ce qu’ils viennent seuls.
      </p>
      <div class="form__actions">
        <a class="btn btn--primaire" href="/formations/psc">Découvrir le PSC</a>
        <a class="btn btn--fantome" href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
      </div>
    </div>
  </section>

  <div id="dates">
    <Sessions sessions={sessions} sigle={psc.sigle} />
  </div>
  {sessions.length > 0 && <ModuleInscription />}

  <!-- ========== AUTRES SITUATIONS ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Autres situations</p>
      <h2 class="h-section">Sauriez-vous réagir&nbsp;?</h2>
      <div class="autres">
        {autres.map((a) => (
          <a class="autre" href={`/gestes-qui-sauvent/${a.slug}`}>
            <strong>{a.titre}</strong>
            <span>{a.court}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .tete {
    background: linear-gradient(158deg, var(--navy-lift) 0%, var(--navy) 55%, var(--navy-deep) 100%);
    color: var(--on-navy);
    padding-block: clamp(1.5rem, 4vw, 2.25rem) clamp(2.25rem, 5vw, 3.25rem);
  }
  .fil {
    display: flex; flex-wrap: wrap; gap: .5rem; align-items: center;
    font-family: 'Archivo', sans-serif; font-size: .72rem; font-weight: 600;
    letter-spacing: .11em; text-transform: uppercase; color: var(--on-navy-soft);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .fil a { color: inherit; text-decoration: none; }
  .fil a:hover { color: #fff; }
  .fil i { opacity: .45; font-style: normal; }
  .fil b { color: #fff; font-weight: 600; }
  .tete__h1 { font-size: clamp(1.85rem, 4.6vw, 2.7rem); font-weight: 800; margin-bottom: .8rem; max-width: 24ch; }
  .tete__t { max-width: 62ch; color: var(--on-navy-text); font-size: clamp(1rem, 2.2vw, 1.1rem); }

  /* --- encadré d'urgence --- */
  .urgence {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--secours); color: #fff;
    border-radius: var(--r-lg); padding: 1.15rem 1.35rem;
    margin-top: clamp(-1.5rem, -3vw, -1rem); position: relative; z-index: 2;
    box-shadow: var(--sh-lg);
  }
  .urgence__ic {
    flex: none; width: 40px; height: 40px; border-radius: 12px;
    background: rgba(255,255,255,.18); display: grid; place-items: center;
  }
  .urgence__ic svg { width: 20px; height: 20px; }
  .urgence strong { font-family: 'Archivo', sans-serif; font-size: 1rem; display: block; margin-bottom: .2rem; }
  .urgence p { font-size: .92rem; color: rgba(255,255,255,.92); }
  .urgence a { color: #fff; font-weight: 700; text-underline-offset: 3px; }

  /* --- corps --- */
  .art {
    display: grid; gap: clamp(1.5rem, 4vw, 2.75rem);
    grid-template-columns: minmax(0, 1fr) minmax(min(300px, 100%), 22rem);
    align-items: start;
  }
  @media (max-width: 960px) { .art { grid-template-columns: 1fr; } }

  .bl { margin-bottom: clamp(1.75rem, 4vw, 2.5rem); }
  .bl h2 {
    font-size: clamp(1.2rem, 2.8vw, 1.5rem); font-weight: 800;
    padding-bottom: .55rem; margin-bottom: 1.1rem;
    border-bottom: 2px solid var(--line);
  }

  .signes, .pieges { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .6rem; }
  .signes li, .pieges li {
    position: relative; padding-left: 1.6rem;
    font-size: .95rem; color: var(--ink-soft);
  }
  .signes li::before {
    content: ''; position: absolute; left: .2rem; top: .55em;
    width: 6px; height: 6px; border-radius: 50%; background: var(--azur);
  }
  .pieges li::before {
    content: '✕'; position: absolute; left: 0; top: 0;
    color: var(--secours); font-weight: 700; font-size: .9rem;
  }

  .etapes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .8rem; }
  .etape {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 1.1rem 1.3rem;
  }
  .etape__n {
    flex: none; width: 32px; height: 32px; border-radius: 50%;
    background: var(--secours); color: #fff; display: grid; place-items: center;
    font-family: 'Archivo', sans-serif; font-weight: 800; font-size: .92rem;
  }
  .etape h3 { font-size: 1rem; font-weight: 700; margin-bottom: .25rem; }
  .etape p { font-size: .93rem; color: var(--ink-soft); }

  .source {
    font-size: .84rem; color: var(--ink-mute);
    padding-top: 1.1rem; border-top: 1px solid var(--line);
    max-width: 78ch;
  }

  /* --- colonne latérale --- */
  .art__cote { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 130px; }
  @media (max-width: 960px) { .art__cote { position: static; } }
  .cote {
    background: var(--sunk); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 1.25rem 1.4rem;
  }
  .cote--fort { background: var(--azur-wash); border-color: var(--azur); }
  .cote__t {
    font-family: 'Archivo', sans-serif; font-size: .7rem; font-weight: 700;
    letter-spacing: .11em; text-transform: uppercase; color: var(--ink-mute);
    margin-bottom: .6rem;
  }
  .cote__x { font-size: .91rem; color: var(--ink-soft); }
  .cote__cta { margin-top: 1rem; width: 100%; justify-content: center; font-size: .92rem; }
  .cote__n { margin-top: .6rem; font-size: .82rem; color: var(--ink-mute); text-align: center; }

  .form__h { font-size: clamp(1.5rem, 3.5vw, 2rem); font-weight: 800; margin-bottom: .7rem; }
  .form__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }

  .autres {
    margin-top: 2rem; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  }
  .autre {
    display: flex; flex-direction: column-reverse; gap: .3rem;
    background: var(--surface); border: 1px solid var(--line);
    border-left: 4px solid var(--azur);
    border-radius: var(--r-lg); padding: 1.1rem 1.3rem;
    text-decoration: none; color: inherit;
    transition: border-color .15s, box-shadow .15s;
  }
  .autre:hover { border-color: var(--secours); box-shadow: var(--sh-md); }
  .autre strong { font-size: .97rem; font-weight: 700; }
  .autre span {
    font-family: 'Archivo', sans-serif; font-size: .68rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--ink-mute);
  }
</style>
