---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { asso } from '../../data/association';
import { parSlug } from '../../data/formations';
import { situations, referentiel } from '../../data/situations';
import { faqFormations } from '../../data/faq';
import { filAriane, questionsFrequentes } from '../../lib/schema';

/**
 * Sommaire des situations de premiers secours.
 *
 * Sert deux publics : celui qui cherche une réponse précise et arrive
 * directement sur une situation, et celui qui découvre qu'il ne saurait réagir
 * à aucune d'entre elles. Le second est celui qu'on cherche à former.
 */

const psc = parSlug('psc')!;

const balisages = [
  filAriane([
    { nom: 'Accueil', chemin: '/' },
    { nom: 'Gestes qui sauvent', chemin: '/gestes-qui-sauvent' },
  ]),
  questionsFrequentes(faqFormations),
];
---

<Base
  title="Les gestes qui sauvent : que faire face à une urgence ?"
  description="Apprendre les gestes de premiers secours à Nice : étouffement, hémorragie, arrêt cardiaque, malaise, brûlure. La conduite à tenir officielle, expliquée simplement, d’après le référentiel PSC 2026."
  chemin="/gestes-qui-sauvent"
  schemas={balisages}
>
  <header class="tete">
    <div class="wrap">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i><b>Gestes qui sauvent</b>
      </nav>
      <h1 class="tete__h1">Sauriez-vous réagir&nbsp;?</h1>
      <p class="tete__t">
        Un proche s’étouffe, s’effondre, se brûle. Vous avez quelques secondes
        pour agir, et ce que vous ferez pendant ces secondes compte plus que
        tout ce qui suivra. Voici, situation par situation, ce que dit le
        référentiel national.
      </p>
      <div class="tete__actions">
        <a class="btn btn--primaire" href="/gestes-qui-sauvent/quiz">
          Tester mes réflexes en 5 minutes
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn--fantome" href="/formations/psc">Découvrir le PSC</a>
      </div>
    </div>
  </header>

  <div class="wrap">
    <aside class="urgence" role="note">
      <span class="urgence__ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
      </span>
      <div>
        <strong>Urgence en cours&nbsp;?</strong>
        <p>
          Appelez le <a href="tel:15">15</a> (SAMU), le <a href="tel:18">18</a>
          {' '}(pompiers) ou le <a href="tel:112">112</a> depuis un portable.
          Le médecin régulateur vous guide au téléphone.
        </p>
      </div>
    </aside>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="grille">
        {situations.map((s, i) => (
          <a class="sit" href={`/gestes-qui-sauvent/${s.slug}`}>
            {/* Les trois premières vignettes sont visibles d'emblée : les
                charger en différé laisserait des cadres blancs à l'arrivée. */}
            {s.image && (
              <img class="sit__img" src={s.image.fichier} alt=""
                   width="1800" height="1013"
                   loading={i < 3 ? 'eager' : 'lazy'}
                   fetchpriority={i === 0 ? 'high' : undefined}
                   decoding="async" />
            )}
            <span class="sit__corps">
              <span class="sit__e">{s.court}</span>
              <strong>{s.titre}</strong>
              <span class="sit__x">{s.accroche}</span>
              <span class="sit__f" aria-hidden="true">
                Lire la conduite à tenir
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </span>
          </a>
        ))}

        {/* Dernière vignette de la grille, dans le même format que les autres :
            un parent qui vient de lire « brûlure » enchaîne naturellement, là
            où un bloc pleine largeur l'aurait fait sortir du fil. */}
        <a class="sit sit--parent" href="/premiers-secours-bebe-enfant">
          <span class="sit__corps">
            <span class="sit__e">Bientôt parent, ou déjà</span>
            <strong>Sur un bébé, vous feriez quoi&nbsp;?</strong>
            <span class="sit__x">
              On ne comprime jamais le ventre d’un nourrisson, et la réanimation
              d’un enfant ne suit pas le rythme de celle d’un adulte. Ce qui
              change, et ce que vous pouvez y faire.
            </span>
            <span class="sit__f" aria-hidden="true">
              Premiers secours bébé et enfant
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </span>
        </a>
      </div>

      <a class="quiz-app" href="/gestes-qui-sauvent/quiz">
        <span class="quiz-app__ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01" /><circle cx="12" cy="12" r="10" /></svg>
        </span>
        <span class="quiz-app__txt">
          <strong>Sauriez-vous vraiment réagir&nbsp;? Douze questions pour le savoir.</strong>
          <span>Cinq minutes, chaque réponse expliquée. Sans inscription, rien n’est enregistré.</span>
        </span>
        <svg class="quiz-app__f" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>

      <p class="source">
        Ces pages reprennent le {referentiel.nom}, {referentiel.edition},
        publié par la {referentiel.auteur}. Elles informent&nbsp;; elles ne
        remplacent pas une formation.
      </p>
    </div>
  </section>

  <!-- ========== SE FORMER ========== -->
  <section class="section section--navy">
    <div class="wrap wrap--etroit">
      <p class="eyebrow">Le passage à l’acte</p>
      <h2 class="form__h">Lire, c’est bien. Savoir faire, c’est autre chose.</h2>
      <p class="lede">
        Tous ceux qui ont vraiment eu à intervenir le disent&nbsp;: sur le
        moment, on ne se souvient pas d’un article. On refait ce qu’on a
        répété. Le PSC dure {psc.duree.toLowerCase()}, coûte {psc.tarif},
        s’ouvre {psc.prerequis.toLowerCase()} et sans aucun prérequis.
      </p>
      <div class="form__actions">
        <a class="btn btn--primaire" href="/formations/psc">
          Découvrir le PSC
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn--fantome" href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap">
      <Faq
        titre="Vos questions sur la formation"
        questions={faqFormations}
      />
    </div>
  </section>
</Base>

<style>
  .tete {
    background: linear-gradient(158deg, var(--navy-lift) 0%, var(--navy) 55%, var(--navy-deep) 100%);
    color: var(--on-navy);
    padding-block: clamp(1.5rem, 4vw, 2.25rem) clamp(2.25rem, 5vw, 3.25rem);
  }
  .fil {
    display: flex; gap: .5rem; align-items: center;
    font-family: 'Archivo', sans-serif; font-size: .72rem; font-weight: 600;
    letter-spacing: .11em; text-transform: uppercase; color: var(--on-navy-soft);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .fil a { color: inherit; text-decoration: none; }
  .fil a:hover { color: #fff; }
  .fil i { opacity: .45; font-style: normal; }
  .fil b { color: #fff; font-weight: 600; }
  .tete__h1 { font-size: clamp(2rem, 5.5vw, 3.1rem); font-weight: 800; margin-bottom: .8rem; }
  .tete__actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 1.75rem; }
  .tete__t { max-width: 64ch; color: var(--on-navy-text); font-size: clamp(1rem, 2.2vw, 1.12rem); }

  .urgence {
    display: flex; gap: 1rem; align-items: flex-start;
    background: var(--secours); color: #fff;
    border-radius: var(--r-lg); padding: 1.15rem 1.35rem;
    margin-top: clamp(-1.5rem, -3vw, -1rem); position: relative; z-index: 2;
    box-shadow: var(--sh-lg);
  }
  .urgence__ic {
    flex: none; width: 40px; height: 40px; border-radius: 12px;
    background: rgba(255,255,255,.18); display: grid; place-items: center;
  }
  .urgence__ic svg { width: 20px; height: 20px; }
  .urgence strong { font-family: 'Archivo', sans-serif; font-size: 1rem; display: block; margin-bottom: .2rem; }
  .urgence p { font-size: .92rem; color: rgba(255,255,255,.92); }
  .urgence a { color: #fff; font-weight: 700; text-underline-offset: 3px; }

  .grille {
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }
  /* La carte ne porte aucune marge intérieure : l'aperçu occupe toute sa
     largeur, et c'est le bloc de texte qui prend le padding. Une marge
     négative sur l'image aurait marché aussi, mais elle se casse dès qu'on
     touche au padding de la carte. */
  .sit {
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 0; overflow: hidden;
    text-decoration: none; color: inherit;
    transition: border-color .15s, box-shadow .15s;
  }
  .sit__img {
    display: block; width: 100%;
    aspect-ratio: 16 / 9; object-fit: cover; object-position: center 38%;
  }
  .sit__corps {
    display: flex; flex-direction: column; gap: .5rem; flex: 1;
    padding: clamp(1.15rem, 2.6vw, 1.45rem);
  }
  .sit:hover { border-color: var(--secours); box-shadow: var(--sh-md); }
  .sit__e {
    font-family: 'Archivo', sans-serif; font-size: .68rem; font-weight: 700;
    letter-spacing: .11em; text-transform: uppercase; color: var(--secours);
  }
  .sit strong { font-size: 1.08rem; font-weight: 700; line-height: 1.3; }
  .sit__x { font-size: .9rem; color: var(--ink-soft); }
  .sit__f {
    display: flex; align-items: center; gap: .4rem; margin-top: auto; padding-top: .5rem;
    font-family: 'Archivo', sans-serif; font-size: .82rem; font-weight: 600; color: var(--azur);
  }
  .sit__f svg { width: 15px; height: 15px; }

  .source {
    margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--line);
    font-size: .85rem; color: var(--ink-mute); max-width: 80ch;
  }

  .form__h { font-size: clamp(1.5rem, 3.5vw, 2.1rem); font-weight: 800; margin-bottom: .7rem; }
  .form__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }

  .quiz-app {
    display: flex; align-items: center; gap: 1rem;
    margin-top: 2rem;
    background: var(--secours); color: #fff;
    border-radius: var(--r-lg); padding: 1.3rem 1.5rem;
    text-decoration: none;
    transition: box-shadow .15s;
  }
  .quiz-app:hover { box-shadow: var(--sh-lg); }
  .quiz-app__ic {
    flex: none; width: 44px; height: 44px; border-radius: 13px;
    background: rgba(255,255,255,.18); display: grid; place-items: center;
  }
  .quiz-app__ic svg { width: 22px; height: 22px; }
  .quiz-app__txt { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .quiz-app__txt strong { font-family: 'Archivo', sans-serif; font-size: 1.02rem; font-weight: 700; }
  .quiz-app__txt span { font-size: .89rem; color: rgba(255,255,255,.9); }
  .quiz-app__f { flex: none; width: 19px; height: 19px; margin-left: auto; }

  /* Sans photo, la vignette doit tenir toute seule : un aplat teinté et un
     filet la distinguent des conduites à tenir sans la faire dépareiller. */
  .sit--parent {
    background: color-mix(in srgb, var(--azur) 6%, var(--surface));
    border-color: color-mix(in srgb, var(--azur) 30%, transparent);
    border-top: 4px solid var(--azur);
  }
  .sit--parent:hover { border-color: var(--azur); }
  .sit--parent .sit__e { color: var(--azur); }
  .sit--parent .sit__f { color: var(--azur); }
</style>
