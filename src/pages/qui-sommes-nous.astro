---
import Base from '../layouts/Base.astro';
import Equipe from '../components/Equipe.astro';
import Lieu from '../components/Lieu.astro';
import { asso } from '../data/association';
import {
  bureau, formateursDeFormateurs, formateursPscPse, nombreFormateurs, versionnee,
} from '../data/organigramme';
---

<Base
  title="Qui sommes-nous | Association FFSS de secourisme à Nice"
  description="Secourisme Pour Tous, association affiliée FFSS, agréée sécurité civile et certifiée Qualiopi à Nice depuis 2008 : formations, postes de secours et sauvetage sportif dans le 06."
  chemin="/qui-sommes-nous"
>
  <header class="tete">
    <div class="tete__photo" aria-hidden="true"></div>
    <div class="tete__voile" aria-hidden="true"></div>
    <div class="wrap tete__in">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i><b>Qui sommes-nous</b>
      </nav>
      <p class="eyebrow tete__eyebrow">Depuis {asso.fondation} sur la Côte d'Azur</p>
      <h1 class="tete__h1">Une association, quatre engagements</h1>
      <p class="tete__t">
        Fondée par {asso.fondateur}, Secourisme Pour Tous promeut le secourisme et le
        sauvetage sportif auprès du grand public, des enfants comme des adultes.
      </p>
    </div>
  </header>

  <!-- ========== CHIFFRES ========== -->
  <section class="wrap chiffres" aria-label="L'association en chiffres">
    <div class="chiffres__grille">
      {asso.chiffres.map((c) => (
        <div class="chiffre">
          <span class="chiffre__v">{c.valeur}<i>{c.suffixe}</i></span>
          <span class="chiffre__l">{c.label}</span>
          <span class="chiffre__d">{c.detail}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ========== HISTOIRE ========== -->
  <section class="section">
    <div class="wrap histoire">
      <div>
        <p class="eyebrow">Notre histoire</p>
        <h2 class="h-section">Le secourisme, pour tout le monde</h2>
        <p class="lede">
          Depuis {asso.fondation}, nous partons d'une conviction simple : les gestes qui
          sauvent ne doivent pas rester l'affaire des professionnels. Un enfant de dix ans
          peut apprendre à alerter les secours. Un salarié peut prendre en charge un
          collègue avant l'arrivée du SAMU. Un nageur-sauveteur peut faire la différence
          sur une plage un après-midi d'août.
        </p>
        <p class="para">
          Cette conviction nous a menés bien au-delà de la salle de formation : nos équipes
          sécurisent les manifestations sportives et culturelles de toute la Côte d'Azur,
          notre club forme des athlètes de sauvetage sportif jusqu'au plus haut niveau, et
          notre école accueille les plus jeunes.
        </p>
        <ul class="valeurs">
          {asso.valeurs.map((v) => <li>{v}</li>)}
        </ul>
      </div>

      <aside class="agrements">
        <h3 class="agrements__h">Nos agréments</h3>
        <div class="agrements__logos">
          <img src="/img/logo-ffss.png" alt="Logo de la Fédération Française de Sauvetage et de Secourisme" width="120" height="120" loading="lazy" />
          <a href="/documents/certificat-qualiopi.pdf" target="_blank" rel="noopener"
             title="Consulter notre certificat Qualiopi">
            <img src="/img/qualiopi.png" alt="Certification Qualiopi — actions de formation" width="180" height="110" loading="lazy" />
          </a>
        </div>
        <ul class="agrements__l">
          {asso.agrements.map((a) => (
            <li><strong>{a.nom}</strong><span>{a.detail}</span></li>
          ))}
        </ul>
        <p class="agrements__note">
          La certification qualité a été délivrée au titre de la catégorie
          <strong> actions de formation</strong>.
          Association déclarée sous le n° RNA {asso.identifiants.rna}.
          Certificat Qualiopi n° QUA009665, valide jusqu'au 29 novembre 2027 —
          <a href="/documents/certificat-qualiopi.pdf" target="_blank" rel="noopener">le consulter</a>.
        </p>
      </aside>
    </div>
  </section>

  <!-- ========== POLES ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Nos activités</p>
      <h2 class="h-section">Quatre pôles, une même exigence</h2>
      <div class="poles">
        {asso.poles.map((p) => (
          <a class="pole" href={p.lien}>
            <h3>{p.titre}</h3>
            <p>{p.texte}</p>
            <span class="pole__f" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== ACCESSIBILITE ========== -->
  <section class="section">
    <div class="wrap">
      <Lieu
        titre="Où nous trouver"
        intro="Nos bureaux et nos salles de formation sont au même endroit, dans l'ouest de Nice."
      />
    </div>
  </section>

  <!-- ========== ÉQUIPE ========== -->
  <section class="section section--sunk" aria-labelledby="t-equipe">
    <div class="wrap">
      <p class="eyebrow">L'équipe</p>
      <h2 class="h-section" id="t-equipe">Qui dirige et qui forme</h2>
      <p class="lede">
        L'association est gérée par un bureau et un comité directeur. Elle est
        dirigée par un président et une directrice, épaulés par un responsable
        formation et un responsable des dispositifs de secours.
      </p>

      {/* L'organigramme est du HTML, plus une image de diapositive : il se
          lit à voix haute, se traduit, s'indexe, et se corrige sans rouvrir
          une présentation. Les visages en sont extraits une fois pour toutes
          par outils/organigramme.py. */}
      <div class="orgn">
        {bureau.map((niveau) => (
          <div class="orgn__n">
            <h3 class="orgn__t">{niveau.titre}</h3>
            <ul class="orgn__l">
              {niveau.postes.map((p) => (
                <li class="orgn__i">
                  <img class="orgn__ph" src={versionnee(p.photo)} alt="" width="200" height="200" loading="lazy" decoding="async" />
                  <span class="orgn__f">{p.fonction}</span>
                  <strong class="orgn__nom">{p.nom}</strong>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="orgn__form">
        <h3 class="orgn__t">
          Nos formateurs
          <span class="orgn__cpt">{nombreFormateurs}</span>
        </h3>
        <p class="orga__intro">
          Dont {formateursDeFormateurs.length} formateurs de formateurs, qui
          assurent les PAE&nbsp;FPSC et PAE&nbsp;FPS.
        </p>

        <p class="orgn__grp">Formateurs de formateurs</p>
        <ul class="orgn__l orgn__l--tromb">
          {formateursDeFormateurs.map((f) => (
            <li class="orgn__i">
              <img class="orgn__ph orgn__ph--s" src={versionnee(f.photo)} alt="" width="200" height="200" loading="lazy" decoding="async" />
              <strong class="orgn__nom">{f.nom}</strong>
              {f.mention && <span class="orgn__m">{f.mention}</span>}
            </li>
          ))}
        </ul>

        <p class="orgn__grp">Formateurs PSC et PSE</p>
        <ul class="orgn__l orgn__l--tromb">
          {formateursPscPse.map((f) => (
            <li class="orgn__i">
              <img class="orgn__ph orgn__ph--s" src={versionnee(f.photo)} alt="" width="200" height="200" loading="lazy" decoding="async" />
              <strong class="orgn__nom">{f.nom}</strong>
              {f.mention && <span class="orgn__m">{f.mention}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* L'organigramme dit qui décide. Celui-ci dit qui vous formera, et c'est
      ce qui compte pour quelqu'un qui hésite à s'inscrire. */}
  {/* Pas de .wrap : le mur de visages prend toute la largeur de l'écran, et
      remet lui-même son titre dans la colonne de texte. */}
  <section class="section" id="equipe">
    <Equipe mur />
  </section>

  <!-- ========== PARTENAIRES ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Ils nous font confiance</p>
      <h2 class="h-section">Nos partenaires</h2>
      <ul class="partenaires">
        {asso.partenaires.map((p) => (
          <li class="partenaire">
            {p.logo
              ? <img src={p.logo} alt={p.nom} loading="lazy" />
              : <span class="partenaire__nom">{p.nom}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .tete { position: relative; background: var(--navy-deep); color: var(--on-navy); overflow: hidden; }
  .tete__photo {
    position: absolute; inset: 0;
    background: url('/img/equipe.jpg') center/cover;
  }
  .tete__voile {
    position: absolute; inset: 0;
    background: linear-gradient(97deg, rgba(7,23,38,.96) 0%, rgba(7,23,38,.9) 38%, rgba(9,32,54,.6) 72%, rgba(11,37,64,.45) 100%);
  }
  .tete__in { position: relative; z-index: 1; padding-block: clamp(1.5rem,4vw,2.25rem) clamp(3rem,7vw,5rem); }
  .tete__eyebrow { color: var(--on-navy-soft) !important; }

  /* --- équipe --- */
  /* ── L'organigramme ──────────────────────────────────────────────────
     Trois rangées plutôt qu'un arbre : le document ne décrit pas une chaîne
     de commandement mais un partage de responsabilités, et un arbre aurait
     inventé une hiérarchie que personne n'a posée. Chaque rangée se centre,
     et se replie d'elle-même sur les petits écrans. */
  .orgn { display: flex; flex-direction: column; gap: clamp(1.6rem, 3vw, 2.4rem); }
  .orgn__n { text-align: center; }
  .orgn__t {
    font-family: 'Archivo', sans-serif; font-size: .78rem; font-weight: 800;
    letter-spacing: .12em; text-transform: uppercase; color: var(--ink-mute);
    margin-bottom: 1.1rem;
  }
  .orgn__l {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: clamp(1rem, 2.4vw, 2rem);
  }
  .orgn__i {
    display: flex; flex-direction: column; align-items: center;
    width: clamp(120px, 15vw, 150px); text-align: center;
  }
  .orgn__ph {
    width: 92px; height: 92px; border-radius: 50%; object-fit: cover;
    background: var(--sunk); margin-bottom: .6rem;
    /* Un anneau clair : les visages détourés sur blanc et ceux photographiés
       sur fond bleu se lisent sinon comme deux familles de vignettes. */
    box-shadow: 0 0 0 3px var(--surface), 0 0 0 4px var(--line);
  }
  .orgn__ph--s { width: 74px; height: 74px; }
  .orgn__f {
    font-family: 'Archivo', sans-serif; font-size: .7rem; font-weight: 800;
    letter-spacing: .06em; text-transform: uppercase; color: var(--accent);
    line-height: 1.25;
  }
  .orgn__nom { font-size: .92rem; font-weight: 700; line-height: 1.3; margin-top: .15rem; }
  .orgn__m {
    margin-top: .2rem; font-size: .68rem; font-weight: 700;
    letter-spacing: .05em; text-transform: uppercase; color: var(--ink-mute);
  }

  .orgn__form { margin-top: clamp(2.4rem, 5vw, 3.5rem); }
  .orgn__form .orgn__t { text-align: center; display: flex; align-items: center; justify-content: center; gap: .5rem; }
  .orgn__cpt {
    display: inline-grid; place-items: center; min-width: 1.9em; padding: .1em .5em;
    border-radius: 999px; background: var(--accent-plein); color: var(--accent-encre);
    font-size: .92rem; letter-spacing: 0;
  }
  .orgn__form .orga__intro { text-align: center; max-width: 46ch; margin-inline: auto; }
  .orgn__grp {
    margin: 1.6rem 0 1rem; text-align: center;
    font-family: 'Archivo', sans-serif; font-size: .8rem; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft);
  }
  .orgn__l--tromb .orgn__i { width: clamp(104px, 12vw, 124px); }

  @media (max-width: 560px) {
    .orgn__ph { width: 78px; height: 78px; }
    .orgn__ph--s { width: 62px; height: 62px; }
    /* Assez étroit pour que les trois pôles tiennent sur une ligne : à deux
       lignes, le troisième semblait rattaché aux deux premiers. */
    .orgn__i { width: clamp(84px, 24vw, 120px); }
    .orgn__l { gap: 1rem .6rem; }
  }

  /* On alterne le sens de lecture pour ne pas répéter deux fois la même page. */
  @media (min-width: 861px) {
  }

  .orga__intro { font-size: .93rem; color: var(--ink-soft); margin-bottom: .9rem; }
  .tete__h1 { font-size: clamp(2.1rem,6vw,3.4rem); font-weight: 800; margin-block: .5rem .85rem; }
  .tete__t { max-width: 54ch; color: var(--on-navy-text); font-size: clamp(1rem,2.2vw,1.12rem); }

  .chiffres { position: relative; z-index: 2; margin-top: clamp(-3.5rem,-5vw,-2rem); }
  .chiffres__grille { display: grid; gap: clamp(.7rem,1.6vw,1rem); grid-template-columns: repeat(auto-fit,minmax(200px,1fr)); }
  /* Même traitement que sur l'accueil : quatre chiffres empilés font une
     colonne interminable sur téléphone. */
  @media (max-width: 700px) {
    .chiffres__grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chiffre { padding: 1rem .95rem; }
    .chiffre__v { font-size: 1.85rem; }
    .chiffre__l { font-size: .88rem; margin-top: .3rem; }
    .chiffre__d { font-size: .76rem; }
  }
  .chiffre {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: clamp(1.25rem,2.8vw,1.6rem); box-shadow: var(--sh-md);
    display: flex; flex-direction: column; gap: .15rem;
  }
  .chiffre__v {
    font-family: 'Archivo', sans-serif; font-size: clamp(2.1rem,5vw,2.75rem);
    font-weight: 800; line-height: 1; color: var(--azur); font-variant-numeric: tabular-nums;
  }
  .chiffre__v i { font-style: normal; color: var(--secours); }
  .chiffre__l { font-weight: 600; margin-top: .35rem; }
  .chiffre__d { font-size: .85rem; color: var(--ink-mute); }

  .histoire { display: grid; gap: clamp(1.75rem,4vw,3rem); grid-template-columns: minmax(0,7fr) minmax(0,5fr); align-items: start; }
  @media (max-width: 880px) { .histoire { grid-template-columns: 1fr; } }
  .para { margin-top: 1rem; color: var(--ink-soft); max-width: var(--measure); }

  .valeurs { list-style: none; margin: 1.75rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .valeurs li {
    font-family: 'Archivo', sans-serif; font-weight: 700; font-size: .82rem;
    letter-spacing: .04em; text-transform: uppercase;
    background: var(--azur-wash); color: var(--azur);
    border-radius: var(--r-pill); padding: .45rem 1rem;
  }

  .agrements { background: var(--sunk); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.35rem,3vw,1.9rem); }
  .agrements__h { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.1rem; }
  .agrements__logos {
    display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center;
    background: #fff; border-radius: var(--r-md); padding: 1.1rem; margin-bottom: 1.25rem;
  }
  .agrements__logos img { width: auto; height: 68px; object-fit: contain; }
  .agrements__l { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-direction: column; gap: .7rem; }
  .agrements__l li { display: flex; flex-direction: column; }
  .agrements__l strong { font-weight: 700; }
  .agrements__l span { font-size: .88rem; color: var(--ink-mute); }
  .agrements__note { font-size: .82rem; color: var(--ink-mute); }

  .poles { margin-top: 2.5rem; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit,minmax(250px,1fr)); }
  .pole {
    position: relative; background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(1.35rem,3vw,1.75rem);
    text-decoration: none; color: inherit;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  .pole:hover { transform: translateY(-3px); box-shadow: var(--sh-md); border-color: var(--azur); }
  .pole h3 { font-size: 1.08rem; font-weight: 700; margin-bottom: .45rem; padding-right: 2rem; }
  .pole p { font-size: .92rem; color: var(--ink-soft); }
  .pole__f { position: absolute; top: clamp(1.35rem,3vw,1.75rem); right: clamp(1.35rem,3vw,1.75rem); width: 22px; height: 22px; color: var(--secours); }
  .pole__f svg { width: 100%; height: 100%; }

  .partenaires {
    margin-top: 2rem; padding: 0; list-style: none;
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    align-items: center;
  }
  .partenaire {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: 1.1rem 1.25rem;
    display: grid; place-items: center; min-height: 96px;
  }
  .partenaire img {
    max-width: 100%; max-height: 58px; width: auto; height: auto;
    object-fit: contain;
    /* Les logos partenaires ont des fonds et des couleurs très différents.
       Une légère désaturation au repos les fait cohabiter sans les dénaturer. */
    filter: saturate(0.85);
    transition: filter 0.18s ease, transform 0.18s ease;
  }
  .partenaire:hover img { filter: saturate(1); transform: scale(1.04); }
  .partenaire__nom {
    font-family: 'Archivo', sans-serif; font-weight: 600; font-size: 0.9rem;
    color: var(--ink-soft); text-align: center;
  }
</style>
