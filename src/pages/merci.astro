---
import Base from '../layouts/Base.astro';
import { asso } from '../data/association';
---

<Base
  title="Message envoyé | Secourisme Pour Tous"
  description="Votre demande a bien été transmise à Secourisme Pour Tous. Nous vous répondons sous 48 heures ouvrées."
  chemin="/merci"
>
  <section class="merci">
    <div class="wrap wrap--etroit merci__in">
      <span class="merci__ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </span>
      <h1 class="merci__h1">Message bien reçu</h1>
      <p class="lede">
        Merci pour votre demande. Nous vous répondons sous 48 heures ouvrées.
        Pour une demande urgente, appelez-nous directement.
      </p>
      <div class="merci__actions">
        <a class="btn btn--primaire" href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
        <a class="btn btn--sobre" href="/formations">Voir nos formations</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .merci { padding-block: clamp(4rem, 12vw, 8rem); }
  .merci__in { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .merci__ic {
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--sage-wash); color: var(--sage);
    display: grid; place-items: center; margin-bottom: 1.5rem;
  }
  .merci__ic svg { width: 32px; height: 32px; }
  .merci__h1 { font-size: clamp(1.9rem, 5vw, 2.8rem); font-weight: 800; margin-bottom: .8rem; }
  .merci .lede { margin-inline: auto; }
  .merci__actions { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; margin-top: 2rem; }
</style>
