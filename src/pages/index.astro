---
import Base from '../layouts/Base.astro';
import { dimensions } from '../lib/dimensions';
import AvisGoogle from '../components/AvisGoogle.astro';
import { asso } from '../data/association';
import { formations, filieres, type Filiere } from '../data/formations';
import { sessionsAVenir, sessionsDe } from '../lib/wix';
import CartesFilieres from '../components/CartesFilieres.astro';
import AccueilCompagnon from '../components/AccueilCompagnon.astro';

const sessions = await sessionsAVenir();
const prochaines = sessions.slice(0, 3);

/*
 * Les prochaines sessions ouvertes, et la fiche qui présente chacune : c'est
 * la liste « prochaines sessions » de l'accueil mobile, trois au plus. On saute les sessions
 * complètes — les annoncer en vitrine serait promettre une place qu'on n'a plus.
 */
const aVenir = sessions
  .filter((s) => !s.complet)
  .map((s) => ({ s, f: formations.find((f) => !f.suspendue && sessionsDe([s], f.wixEvent).length > 0) }))
  .filter((x): x is { s: typeof x.s; f: NonNullable<typeof x.f> } => !!x.f)
  .slice(0, 3);

/* En heure de Paris, quel que soit le fuseau de la machine qui construit le
   site : chez Cloudflare, c'est UTC, et 9 h y devient 7 h. */
const enParis = (d: Date, o: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', ...o }).format(d);
const heure = (d: Date) => enParis(d, { hour: 'numeric', minute: '2-digit' }).replace(':', 'h').replace('h00', 'h');

const groupes = (['citoyenne', 'operationnelle', 'aquatique', 'entreprise'] as Filiere[])
  .map((f) => ({ cle: f, ...filieres[f], items: formations.filter((x) => x.filiere === f) }))
  .filter((g) => g.items.length > 0);
---

<Base
  title="Formation secourisme à Nice | Secourisme Pour Tous"
  description="Formations PSC, PSE1, PSE2, SSA et SST à Nice, postes de secours et sauvetage sportif dans le 06. Affiliée FFSS, agréée sécurité civile, depuis 2008."
  chemin="/"
>
  <!-- ============ HERO ============ -->
  <header class="hero">
    <div class="hero__photo" aria-hidden="true"></div>
    <video
      class="hero__video" aria-hidden="true" tabindex="-1"
      muted loop playsinline preload="none" poster="/img/hero-club.jpg"
    ><source src="/video/hero-club.mp4" type="video/mp4" /></video>
    <div class="hero__voile" aria-hidden="true"></div>
    <div class="wrap hero__in">
      <div class="hero__texte">
        <div class="hero__badges">
          <a class="badge badge--qualiopi" href="/documents/certificat-qualiopi.pdf"
            target="_blank" rel="noopener" title="Consulter notre certificat Qualiopi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            Certifié Qualiopi
          </a>
          <span class="badge badge--contour">Affiliée FFSS</span>
          <span class="badge badge--contour">Agréée sécurité civile</span>
          <span class="badge badge--contour">Depuis {asso.fondation}</span>
        </div>

        <h1 class="hero__h1">
          Apprendre les gestes<br />qui sauvent, à Nice
        </h1>
        <p class="hero__accroche">
          Association de secourisme et de sauvetage sportif sur la Côte d'Azur depuis
          {asso.fondation}. Nous formons plus de 800 personnes par an et sécurisons
          plus de 270 événements chaque année dans les Alpes-Maritimes.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primaire" href="/formations">
            Découvrir nos formations
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="btn btn--fantome" href="/postes-de-secours">Demander un poste de secours</a>
        </div>
      </div>
    </div>

    <svg class="hero__vague" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,90 L0,44 C240,4 480,0 720,18 C960,36 1200,66 1440,44 L1440,90 Z" />
    </svg>
  </header>

  {/* Téléphone : le Compagnon accueille le visiteur dans la page, avant les
      formations — sans fenêtre par-dessus le contenu. */}
  <AccueilCompagnon />

  <!-- ============ CHIFFRES ============ -->
  <section class="wrap chiffres" aria-label="L'association en chiffres">
    <div class="chiffres__grille">
      {asso.chiffres.map((c) => (
        <div class="chiffre">
          <span class="chiffre__v">{c.valeur}<i>{c.suffixe}</i></span>
          <span class="chiffre__l">{c.label}</span>
          <span class="chiffre__d">{c.detail}</span>
        </div>
      ))}
    </div>
  </section>

  {/*
    ============ ACCUEIL DE L'APPLICATION (téléphone) ============
    Trois blocs propres au téléphone, absents sur ordinateur, où la page
    déroule déjà tout cela en grand. Ils s'intercalent entre les sections
    communes pour que l'accueil se lise dans l'ordre des questions du
    visiteur (voir l'ordre dans les styles) :
      qui sommes-nous → l'accueil du Compagnon → se former (filières, puis
      prochaines dates) → l'urgence → la confiance (chiffres, partenaires) →
      le don. Les activités et le quiz, que la barre d'onglets donne déjà,
      n'y figurent pas.
    Pas de raccourcis vers les rubriques ni de barre de recherche : la barre
    d'onglets et le Compagnon, toujours visibles, les donnent déjà. Rien
    n'est caché à Google : ce sont des liens vers des pages qu'il connaît.
  */}
  {aVenir.length > 0 && (
    <section class="appli appli--dates" aria-labelledby="t-dates">
      <div class="rail__tete">
        <h2 class="rail__h" id="t-dates">Prochaines sessions</h2>
        <a href="/formations" class="rail__tout">Tout voir</a>
      </div>
      <ul class="rail__l">
        {aVenir.map(({ s: x, f }) => (
          <li>
            <a class="date" href={`/formations/${f.slug}`}>
              <span class="date__j">
                <strong>{enParis(x.debut, { day: '2-digit' })}</strong>
                {enParis(x.debut, { month: 'short' })}
              </span>
              <span class="date__f">{f.sigle}</span>
              <span class="date__d">
                <span class="date__jour">{enParis(x.debut, { weekday: 'long' })}</span>
                {x.fin && <> · {heure(x.debut)}–{heure(x.fin)}</>}
              </span>
              <span class="date__p">{f.tarif}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="appli appli--gestes" aria-labelledby="t-reflexes">
    <div class="rail__tete">
      <h2 class="rail__h" id="t-reflexes">Les bons réflexes</h2>
      <a href="/gestes-qui-sauvent" class="rail__tout">Les gestes</a>
    </div>
    {/* Les numéros d'urgence, un toucher pour appeler : sur un site de
        secourisme, c'est la seule action qui ne peut pas attendre. */}
    <div class="urgence">
      <span class="urgence__t"><strong>Une urgence&nbsp;?</strong> Appelez&nbsp;:</span>
      <a href="tel:15" aria-label="Appeler le 15, SAMU">15</a>
      <a href="tel:18" aria-label="Appeler le 18, pompiers">18</a>
      <a href="tel:112" aria-label="Appeler le 112, numéro d'urgence européen">112</a>
    </div>
  </section>

  <section class="appli appli--chiffres" aria-labelledby="t-confiance">
    <h2 class="rail__h" id="t-confiance">Ils nous font confiance</h2>
    <ul class="pastilles" aria-label="L'association en chiffres">
      {asso.chiffres.map((c) => (
        <li><strong>{c.valeur}{c.suffixe}</strong> {c.label}</li>
      ))}
    </ul>
  </section>

  <CartesFilieres />

  <!-- ============ POLES ============ -->
  <section class="section section--sunk" aria-labelledby="t-poles">
    <div class="wrap">
      <p class="eyebrow">Nos activités</p>
      <h2 class="h-section" id="t-poles">Bien plus qu'un organisme de formation</h2>
      <div class="poles">
        {asso.poles.map((p) => (
          <a class="pole" href={p.lien}>
            <h3>{p.titre}</h3>
            <p>{p.texte}</p>
            <span class="pole__fleche" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <AvisGoogle />

  <!-- ============ PARTENAIRES ============ -->

  <section class="section section--sunk" aria-labelledby="t-partenaires">
    <div class="wrap">
      <p class="eyebrow">Ils nous font confiance</p>
      <h2 class="h-section" id="t-partenaires">Nos partenaires</h2>
      <ul class="partenaires">
        {asso.partenaires.map((p) => (
          <li class="partenaire">
            {p.logo
              ? <img src={p.logo} alt={p.nom} loading="lazy" decoding="async" {...(dimensions(p.logo) ?? {})} />
              : <span class="partenaire__nom">{p.nom}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ DON ============ -->

  {/* Placé après les avis et les partenaires : on ne demande pas d'argent à
      quelqu'un qui n'a pas encore vu ce que fait l'association. */}
  <section class="section section--appel" aria-labelledby="t-don">
    <div class="wrap">
      <p class="eyebrow">Soutenir l'association</p>
      <h2 class="h-section" id="t-don">Chaque geste compte.<br />Chaque don sauve.</h2>
      <p class="lede">
        Nos secouristes et nos formateurs sont bénévoles. Votre don finance les
        formations gratuites, le matériel de secours et la sensibilisation dans
        les écoles. 66 % en est déductible de votre impôt sur le revenu.
      </p>
      <p class="don__a"><a class="btn btn--primaire" href="/faire-un-don">Faire un don</a></p>
    </div>
  </section>

  <script>
    /**
     * La boucle de fond n'est chargée que si les conditions s'y prêtent :
     * mouvement non restreint, connexion correcte et mode économie de données
     * inactif. Sinon la photo suffit — une vidéo de fond ne vaut jamais un
     * hero qui met trois secondes à s'afficher sur un téléphone en 4G.
     */
    const fond = document.querySelector('.hero__video');
    const sobre = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reseau = navigator.connection || {};
    const menage = reseau.saveData || /^([23]g|slow-2g)$/.test(reseau.effectiveType || '');

    if (fond && !sobre && !menage) {
      fond.preload = 'auto';
      fond.load();
      fond.play()
        .then(() => fond.setAttribute('data-actif', ''))
        .catch(() => { /* lecture refusée : la photo reste */ });
    }
  </script>
</Base>



<style>
  .don__a { margin-top: 1.75rem; }

  /* --- hero --- */
  .hero {
    position: relative;
    background: linear-gradient(158deg, var(--navy-lift) 0%, var(--navy) 46%, var(--navy-deep) 100%);
    color: var(--on-navy);
    overflow: hidden;
  }
  /* Le sauveteur se tient dans le tiers gauche de la photo. On décale le
     cadrage pour qu'il apparaisse à droite du texte, pas dessous. */
  .hero__photo {
    position: absolute; inset: 0;
    background: url('/img/secours-mer.jpg') 22% center / cover;
  }
  /*
   * La vidéo double la photo : elle n'apparaît qu'une fois lancée, et la photo
   * assure seule le rendu si la lecture n'a pas lieu. Aucune image ne manque
   * jamais derrière le texte.
   */
  .hero__video {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; object-position: center;
    opacity: 0; transition: opacity 1.1s ease;
  }
  .hero__video[data-actif] { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .hero__video { display: none; } }

  .hero__voile {
    position: absolute; inset: 0;
    background:
      linear-gradient(96deg,
        rgba(7,23,38,.97) 0%, rgba(7,23,38,.94) 38%,
        rgba(7,23,38,.78) 58%, rgba(9,32,54,.46) 78%, rgba(11,37,64,.34) 100%),
      linear-gradient(180deg, rgba(7,23,38,.5) 0%, rgba(7,23,38,0) 30%);
  }
  @media (max-width: 860px) {
    /* En étroit, le texte recouvre la photo : voile plein et cadrage recentré. */
    .hero__photo { background-position: 34% center; }
    /* Assez sombre pour lire le texte, assez clair pour voir l'image derrière :
       à .93 partout, la vidéo de fond devenait invisible sur téléphone. */
    .hero__voile {
      background:
        linear-gradient(180deg, rgba(7,23,38,.62) 0%, rgba(7,23,38,.74) 42%, rgba(7,23,38,.92) 100%);
    }
  }
  .hero__in {
    position: relative; z-index: 1;
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(5rem, 11vw, 8rem);
  }
  /* Le titre et l'accroche respirent sur une colonne plus large : à 44ch,
     « Apprendre les gestes qui sauvent, à Nice » tombait sur trois lignes. */
    /* Assez large pour que « Apprendre les gestes » tienne sur une ligne à sa
     taille maximale : en dessous, le titre cassait en trois. */
  .hero__texte { max-width: 78ch; }

  .hero__badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  /* Les quatre mentions tiennent sur une seule ligne dès qu'il y a la place :
     empilées, elles ressemblaient à une liste plutôt qu'à un bandeau. */
  @media (min-width: 1080px) {
    .hero__badges { flex-wrap: nowrap; max-width: none; }
    .hero__badges .badge { white-space: nowrap; }
  }
  .hero__h1 {
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    font-weight: 800; line-height: 1.02;
    margin-bottom: 1.25rem;
  }
  .hero__accroche {
    font-size: clamp(1.02rem, 2.3vw, 1.18rem);
    color: var(--on-navy-text);
    max-width: 58ch;
    margin-bottom: 2.25rem;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .hero__vague { position: absolute; left: 0; right: 0; bottom: -1px; z-index: 1; width: 100%; height: auto; }
  .hero__vague path { fill: var(--ground); }

  /* --- chiffres --- */
  .chiffres { position: relative; z-index: 2; margin-top: clamp(-4rem, -6vw, -2.5rem); }
  .chiffres__grille {
    display: grid; gap: clamp(0.7rem, 1.6vw, 1rem);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  /* Quatre chiffres empilés faisaient une colonne interminable : sur téléphone
     ils tiennent en deux rangées de deux, plus compactes à lire. */
  @media (max-width: 700px) {
    .chiffres__grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chiffre { padding: 1rem .95rem; }
    .chiffre__v { font-size: 1.85rem; }
    .chiffre__l { font-size: .88rem; margin-top: .3rem; }
    .chiffre__d { font-size: .76rem; }
  }
  .chiffre {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.25rem, 2.8vw, 1.6rem);
    box-shadow: var(--sh-md);
    display: flex; flex-direction: column; gap: 0.15rem;
  }
  .chiffre__v {
    font-family: 'Archivo', sans-serif;
    font-size: clamp(2.1rem, 5vw, 2.75rem);
    font-weight: 800; line-height: 1;
    color: var(--azur);
    font-variant-numeric: tabular-nums;
  }
  .chiffre__v i { font-style: normal; color: var(--secours); }
  .chiffre__l { font-weight: 600; margin-top: 0.35rem; }
  .chiffre__d { font-size: 0.85rem; color: var(--ink-mute); }

  /* --- filières --- */
  .filieres {
    margin-top: 2.5rem;
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .filiere {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.35rem, 3vw, 1.75rem);
  }
  .filiere__h { font-size: 1.15rem; font-weight: 700; margin-bottom: 0.35rem; }
  .filiere__t { font-size: 0.92rem; color: var(--ink-soft); margin-bottom: 1.1rem; }
  .filiere__l { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .filiere__l a {
    display: flex; align-items: baseline; gap: 0.6rem;
    text-decoration: none; color: var(--ink);
    padding: 0.6rem 0.75rem;
    border-radius: var(--r-sm);
    background: var(--sunk);
    transition: background-color 0.15s ease;
  }
  .filiere__l a:hover { background: var(--azur-wash); }
  .filiere__l strong { font-family: 'Archivo', sans-serif; font-weight: 800; flex: none; }
  .filiere__l span { font-size: 0.86rem; color: var(--ink-mute); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .filiere__l em {
    margin-left: auto; flex: none;
    font-style: normal; font-family: 'Archivo', sans-serif;
    font-weight: 700; font-size: 0.88rem; color: var(--secours);
  }

  /* --- pôles --- */
  .poles {
    margin-top: 2.5rem;
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }
  .pole {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.35rem, 3vw, 1.75rem);
    text-decoration: none; color: inherit;
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .pole:hover { transform: translateY(-3px); box-shadow: var(--sh-md); border-color: var(--azur); }
  .pole h3 { font-size: 1.08rem; font-weight: 700; margin-bottom: 0.45rem; padding-right: 2rem; }
  .pole p { font-size: 0.92rem; color: var(--ink-soft); }
  .pole__fleche {
    position: absolute; top: clamp(1.35rem, 3vw, 1.75rem); right: clamp(1.35rem, 3vw, 1.75rem);
    width: 22px; height: 22px; color: var(--secours);
  }
  .pole__fleche svg { width: 100%; height: 100%; }

  /* --- partenaires --- */
  .partenaires {
    margin-top: 2rem; padding: 0; list-style: none;
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    align-items: center;
  }
  .partenaire {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: 1.1rem 1.25rem;
    display: grid; place-items: center; min-height: 96px;
  }
  .partenaire img {
    max-width: 100%; max-height: 58px; width: auto; height: auto;
    object-fit: contain;
    /* Les logos partenaires ont des fonds et des couleurs très différents.
       Une légère désaturation au repos les fait cohabiter sans les dénaturer. */
    filter: saturate(0.85);
    transition: filter 0.18s ease, transform 0.18s ease;
  }
  .partenaire:hover img { filter: saturate(1); transform: scale(1.04); }
  .partenaire__nom {
    font-family: 'Archivo', sans-serif; font-weight: 600; font-size: 0.9rem;
    color: var(--ink-soft); text-align: center;
  }

  /* ============ accueil de l'application (téléphone) ============ */
  .appli { display: none; }

  @media (max-width: 720px) {
    /* Le hero devient une carte : la photo, une mention, le titre et deux
       lignes d'accroche. Le bouton cède la place à la barre d'onglets ; les
       chiffres, aux pastilles plus bas. Tout reste dans le HTML. */
    .hero {
      margin: 0.8rem var(--pad) 0;
      border-radius: 22px;
    }
    .hero .hero__in { padding: 1.1rem 1.1rem 1.2rem; }
    .hero__voile {
      background: linear-gradient(100deg, rgba(7,23,38,.95) 0%, rgba(7,23,38,.82) 55%, rgba(7,23,38,.35) 100%);
    }
    .hero .hero__badges { margin-bottom: 0.6rem; }
    .hero__badges .badge--contour { display: none; }
    .hero .hero__h1 { font-size: 1.6rem; line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 0.45rem; }
    .hero .hero__accroche {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      margin: 0;
      font-size: 0.86rem;
      line-height: 1.45;
    }
    .hero .hero__actions { display: none; }
    .chiffres { display: none; }

    /*
     * L'ordre de lecture du téléphone. Les sections communes (filières,
     * activités, partenaires, don) et les blocs propres au téléphone sont
     * frères dans <main> : « order » les range sans toucher au HTML, donc
     * sans rien changer sur ordinateur ni pour Google.
     */
    :global(main:has(.appli)) { display: flex; flex-direction: column; }
    :global(main:has(.appli) > *) { order: 20; }
    .hero { order: 1; }
    :global(main:has(.appli) > .acp) { order: 2; }
    :global(main:has(.appli) > section[aria-labelledby='t-filieres']) { order: 3; }
    .appli--dates { order: 4; }
    /* « Bien plus qu'un organisme de formation » répète ce que donne la barre
       d'onglets (Formations, DPS, S'engager) : sur téléphone, l'accueil s'en
       passe. La section reste dans le HTML, et entière sur ordinateur. */
    :global(main:has(.appli) > section[aria-labelledby='t-poles']) { display: none; }
    .appli--gestes { order: 6; }
    .appli--chiffres { order: 7; }
    :global(main:has(.appli) > section[aria-labelledby='t-partenaires']) { order: 8; }
    :global(main:has(.appli) > .avg) { order: 9; }
    :global(main:has(.appli) > section[aria-labelledby='t-don']) { order: 10; }

    /* Un même fond et un même rythme pour toutes les sections : ce sont les
       rubriques d'un seul écran, pas des bandeaux de site qui alternent. */
    :global(main:has(.appli) > .section) { padding-block: 1.1rem 0.6rem; background: transparent; }
    :global(main:has(.appli) > .section--appel) { padding-block: 1.2rem 1.6rem; }
    :global(main:has(.appli) .filieres__tete .lede) { display: none; }
    :global(main:has(.appli) .filieres__tete > p:not(.eyebrow):not(.lede)) { margin: 0.3rem 0 0; font-size: 0.85rem; line-height: 1.45; }
