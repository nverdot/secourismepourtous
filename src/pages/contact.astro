---
import Base from '../layouts/Base.astro';
import { asso } from '../data/association';
import { formations } from '../data/formations';
import Carte from '../components/Carte.astro';

/**
 * Page contact.
 *
 * Le formulaire s'appuie sur Netlify Forms (attribut `data-netlify`) : sur un
 * site statique il n'y a pas de serveur pour traiter un envoi, et Netlify le
 * fait sans code ni service tiers. Les messages arrivent dans le tableau de
 * bord Netlify et par e-mail.
 *
 * Hors Netlify, le formulaire ne part pas : l'adresse e-mail et le téléphone
 * restent donc affichés en clair juste à côté, jamais cachés derrière l'envoi.
 */

const motifs = [
  "M'inscrire à une formation",
  'Demander un poste de secours (DPS)',
  'Former les salariés de mon entreprise',
  'Organiser une session sur mesure',
  'Devenir secouriste actif (bénévole)',
  'Rejoindre l’association',
  'Autre demande',
];
---

<Base
  title="Contact | Secourisme Pour Tous à Nice"
  description="Contactez Secourisme Pour Tous à Nice : 31 bd Impératrice Eugénie, 06 65 23 12 72. Formations secourisme, postes de secours et sauvetage sportif dans le 06."
  chemin="/contact"
>
  <header class="tete">
    <div class="wrap">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i><b>Contact</b>
      </nav>
      <h1 class="tete__h1">Parlons de votre projet</h1>
      <p class="tete__t">
        Une formation, un événement à sécuriser, une question sur un financement&nbsp;?
        Nous répondons sous 48 heures ouvrées.
      </p>
    </div>
  </header>

  <div class="wrap ct">
    <!-- ============ FORMULAIRE ============ -->
    <section class="ct__form" aria-labelledby="t-form">
      <h2 class="ct__h" id="t-form">Écrivez-nous</h2>

      <form name="contact" method="POST" action="/api/contact" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <p class="miel"><label>Ne pas remplir : <input name="bot-field" /></label></p>

        <div class="duo">
          <label>Prénom *<input type="text" name="prenom" autocomplete="given-name" required /></label>
          <label>Nom *<input type="text" name="nom" autocomplete="family-name" required /></label>
        </div>

        <div class="duo">
          <label>E-mail *<input type="email" name="email" autocomplete="email" required /></label>
          <label>Téléphone<input type="tel" name="telephone" autocomplete="tel" /></label>
        </div>

        <label>Votre demande *
          <select name="motif" id="motif" required>
            <option value="">Choisissez…</option>
            {motifs.map((m) => <option value={m}>{m}</option>)}
          </select>
        </label>

        <label>Formation concernée
          <select name="formation">
            <option value="">Sans objet</option>
            {formations.filter((f) => !f.estRecyclage).map((f) => (
              <option value={f.sigle}>{f.sigle} — {f.intitule}</option>
            ))}
          </select>
        </label>

        <label>Votre message *
          <textarea name="message" rows="6" required
            placeholder="Décrivez votre besoin : nombre de participants, dates souhaitées, lieu…"></textarea>
        </label>

        <label class="case">
          <input type="checkbox" name="consentement" required />
          <span>
            J'accepte que mes informations soient utilisées pour traiter ma demande.
            Elles ne sont ni cédées ni revendues.
            <a href="/politique-de-confidentialite">En savoir plus</a>
          </span>
        </label>

        <button type="submit" class="btn btn--primaire ct__envoi">
          Envoyer ma demande
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </form>
    </section>

    <!-- ============ COORDONNÉES ============ -->
    <aside class="ct__infos">
      <div class="carte">
        <h2 class="carte__h">Nous joindre directement</h2>

        <a class="ligne" href={`tel:${asso.contact.telephoneLien}`}>
          <span class="ligne__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
          </span>
          <span class="ligne__txt"><strong>{asso.contact.telephone}</strong><span>Du lundi au vendredi</span></span>
        </a>

        <a class="ligne" href={`mailto:${asso.contact.email}`}>
          <span class="ligne__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
          </span>
          <span class="ligne__txt"><strong>{asso.contact.email}</strong><span>Réponse sous 48 h ouvrées</span></span>
        </a>

        <div class="ligne ligne--fixe">
          <span class="ligne__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
          </span>
          <span class="ligne__txt">
            <strong>{asso.contact.adresse}</strong>
            <span>{asso.contact.codePostal} {asso.contact.ville}</span>
          </span>
        </div>
      </div>

      <div class="carte">
        <Carte />
      </div>

      <div class="carte carte--sombre">
        <h2 class="carte__h carte__h--clair">Accessibilité et handicap</h2>
        <p>{asso.accessibilite}</p>
        <p class="carte__ref">
          Référente handicap joignable à <a href={`mailto:${asso.contact.email}`}>{asso.contact.email}</a>
        </p>
      </div>

      <div class="carte">
        <h2 class="carte__h">Financements</h2>
        <p class="carte__p">
          Selon votre situation, votre formation peut être prise en charge :
          <strong>OPCO</strong> de votre branche, <strong>plan de développement des
          compétences</strong> de votre employeur, <strong>France Travail</strong> ou
          autofinancement.
        </p>
        <p class="carte__p">
          Pour une prise en charge, passez par le formulaire dédié : il recueille
          d'emblée ce qu'il faut pour établir la convention.
        </p>
        <a class="btn btn--sobre carte__cta" href="/financement">Demander une prise en charge</a>
      </div>
    </aside>
  </div>

  <script>
    // Arriver depuis « Demander un devis » doit poser la question déjà remplie :
    // le visiteur a déjà dit ce qu'il voulait, le lui redemander est une friction.
    const RACCOURCIS = {
      dps: 'Demander un poste de secours (DPS)',
      formation: "M'inscrire à une formation",
      entreprise: 'Former les salariés de mon entreprise',
      benevole: 'Devenir secouriste actif (bénévole)',
    };
    const cle = new URLSearchParams(location.search).get('motif');
    const choix = RACCOURCIS[cle];
    const champ = document.getElementById('motif');
    if (choix && champ) champ.value = choix;
  </script>
</Base>

<style>
  .tete {
    background: linear-gradient(158deg, var(--navy-lift) 0%, var(--navy) 55%, var(--navy-deep) 100%);
    color: var(--on-navy);
    padding-block: clamp(1.5rem, 4vw, 2.25rem) clamp(2.5rem, 6vw, 3.75rem);
  }
  .tete__h1 { font-size: clamp(2rem, 5.5vw, 3.1rem); font-weight: 800; margin-bottom: .8rem; }
  .tete__t { max-width: 52ch; color: var(--on-navy-text); font-size: clamp(1rem, 2.2vw, 1.1rem); }

  .ct {
    display: grid; gap: clamp(1.75rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  @media (max-width: 900px) { .ct { grid-template-columns: 1fr; } }

  .ct__h { font-size: clamp(1.4rem, 3.2vw, 1.8rem); font-weight: 800; margin-bottom: 1.4rem; }

  form { display: flex; flex-direction: column; gap: 1rem; }
  .duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr)); gap: 1rem; }

  label { display: flex; flex-direction: column; gap: .35rem; font-size: .85rem; font-weight: 600; color: var(--ink-soft); }
  input[type='text'], input[type='email'], input[type='tel'], select, textarea {
    min-width: 0;  /* sinon la largeur intrinsèque du champ élargit la grille */
    font: inherit; font-size: .97rem; font-weight: 400; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-sm); padding: .7rem .85rem; width: 100%;
  }
  input:focus, select:focus, textarea:focus {
    outline: 2px solid var(--azur); outline-offset: 1px; border-color: transparent;
  }
  textarea { resize: vertical; }

  .case { flex-direction: row; align-items: flex-start; gap: .6rem; font-weight: 400; font-size: .86rem; }
  .case input { width: 17px; height: 17px; margin-top: .18rem; flex: none; accent-color: var(--secours); }
  .case a { color: var(--azur); }

  /* piège à robots : masqué à l'écran, ignoré des lecteurs d'écran */
  .miel { position: absolute; left: -9999px; }

  .ct__envoi { align-self: flex-start; margin-top: .3rem; }

  .ct__infos { display: flex; flex-direction: column; gap: 1rem; }
  .carte {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(1.35rem, 3vw, 1.75rem);
  }
  .carte__h { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.1rem; }
  .carte__h--clair { color: #fff; }
  .carte__p { font-size: .92rem; color: var(--ink-soft); margin-bottom: .7rem; }
  .carte__p:last-child { margin-bottom: 0; }
  .carte__cta { margin-top: .8rem; font-size: .92rem; padding: .7rem 1.2rem; }

  .ligne {
    display: flex; gap: .85rem; align-items: center;
    padding: .75rem 0; text-decoration: none; color: inherit;
    border-bottom: 1px solid var(--line);
  }
  .ligne:last-child { border-bottom: 0; padding-bottom: 0; }
  .ligne--fixe { cursor: default; }
  .ligne__ic {
    flex: none; width: 40px; height: 40px; border-radius: 11px;
    background: var(--azur-wash); color: var(--azur);
    display: grid; place-items: center;
  }
  .ligne__ic svg { width: 19px; height: 19px; }
  .ligne__txt { display: flex; flex-direction: column; min-width: 0; }
  .ligne__txt strong { font-family: 'Archivo', sans-serif; font-size: .97rem; }
  .ligne__txt span { font-size: .82rem; color: var(--ink-mute); }
  a.ligne:hover .ligne__txt strong { color: var(--secours); }

  .carte--sombre { background: var(--navy); color: var(--on-navy-text); border-color: transparent; }
  .carte--sombre p { font-size: .92rem; }
  .carte__ref { margin-top: .8rem; font-size: .86rem; color: var(--on-navy-soft); }
  .carte__ref a { color: #fff; }
</style>
