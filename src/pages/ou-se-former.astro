---
import Base from '../layouts/Base.astro';
import Lieu from '../components/Lieu.astro';
import Terrain from '../components/Terrain.astro';
import { asso } from '../data/association';
import { formations } from '../data/formations';
import { acces, itineraire, estimeLe } from '../data/acces-communes';
import { villes } from '../data/villes';
import { sessionsAVenir } from '../lib/wix';
import { filAriane, questionsFrequentes } from '../lib/schema';

/**
 * « Où se former aux premiers secours dans les Alpes-Maritimes ? »
 *
 * On nous cherche depuis Cannes, Antibes, Grasse, Sophia Antipolis. La
 * tentation serait de fabriquer une page par commune — « Formation PSC à
 * Cannes » — alors que toutes nos sessions ont lieu à Nice. Ce serait faux,
 * et Google déclasse ces pages-passerelles.
 *
 * Cette page répond donc à la question réellement posée : comment j'y vais
 * depuis chez moi, et combien de temps ça me prend. Et elle annonce ce qui
 * est authentiquement local : pour un groupe, c'est nous qui venons.
 *
 * Le second point n'est pas un argument de référencement, c'est une offre
 * réelle — et c'est elle qui transforme une recherche « Cannes » en demande.
 */

const sessions = await sessionsAVenir();
const certifiantes = formations.filter((f) => f.certifiante && !f.estRecyclage && !f.suspendue);

const QUESTIONS = [
  {
    question: 'Faites-vous des formations ailleurs qu’à Nice ?',
    reponse:
      'Nos sessions au calendrier ont toutes lieu dans nos locaux, à Nice. En revanche, pour un groupe constitué — entreprise, association, école, club — nous nous déplaçons partout dans les Alpes-Maritimes, dans vos locaux.',
  },
  {
    question: 'À partir de combien de personnes vous déplacez-vous ?',
    reponse:
      'À partir d’un groupe permettant de constituer une session, généralement une dizaine de participants. En dessous, il reste plus simple et moins cher de rejoindre une session au calendrier.',
  },
  {
    question: 'Combien de temps pour venir depuis Cannes ou Antibes ?',
    reponse:
      'Comptez environ 35 minutes en TER depuis Cannes et 25 depuis Antibes, sans changement : la ligne Cannes – Vintimille dessert tout le littoral et passe plusieurs fois par heure.',
  },
  {
    question: 'Y a-t-il des sessions le samedi ?',
    reponse:
      'Oui. Une partie des sessions est programmée le week-end, précisément pour les personnes qui viennent de loin ou qui travaillent en semaine. Le calendrier indique le jour de chaque session.',
  },
];

const balisages = [
  filAriane([
    { nom: 'Accueil', chemin: '/' },
    { nom: 'Où se former', chemin: '/ou-se-former' },
  ]),
  questionsFrequentes(QUESTIONS),
];

const parMoyen = {
  train: acces.filter((a) => a.moyen === 'train'),
  bus: acces.filter((a) => a.moyen !== 'train'),
};
---

<Base
  title="Où se former aux premiers secours dans les Alpes-Maritimes ?"
  description="Nos formations PSC1, PSE1 et PSE2 ont lieu à Nice, à 25 minutes d’Antibes et 35 de Cannes en TER. Et pour un groupe, nous nous déplaçons partout dans le 06. Accès, durées et calendrier."
  chemin="/ou-se-former"
  schemas={balisages}
>
  <header class="tete">
    <div class="wrap">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i><b>Où se former</b>
      </nav>
      <h1 class="tete__h1">Où se former aux premiers secours<br />dans les Alpes-Maritimes&nbsp;?</h1>
      <p class="tete__t">
        Réponse courte&nbsp;: <strong>à Nice</strong>, où se tiennent toutes nos
        sessions au calendrier — et <strong>chez vous</strong>, partout dans le
        département, dès que vous êtes un groupe.
      </p>
      <p class="tete__t tete__t--fin">
        Nous n’avons qu’un seul lieu de formation, et nous préférons le dire
        que laisser croire le contraire. La vraie question, c’est le temps que
        ça vous prend depuis chez vous. Il est plus court qu’on ne l’imagine.
      </p>
      <div class="tete__actions">
        <a class="btn btn--primaire" href="#depuis-chez-vous">Depuis chez moi</a>
        <a class="btn btn--fantome" href="#chez-vous">Une session dans mes locaux</a>
      </div>
    </div>
  </header>

  <!-- ========== VENIR À NICE ========== -->
  <section class="section" id="depuis-chez-vous">
    <div class="wrap">
      <p class="eyebrow">Depuis chez vous</p>
      <h2 class="h-section">Le littoral est à moins de 40 minutes</h2>
      <p class="lede">
        La ligne TER Cannes – Vintimille dessert tout le département d’ouest en
        est et passe plusieurs fois par heure. Depuis la plupart des communes
        du littoral, venir se former à Nice prend moins de temps qu’une
        traversée de la ville aux heures de pointe.
      </p>

      <div class="acces">
        {parMoyen.train.map((a) => (
          <article class="acc">
            <span class="acc__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="3" width="16" height="13" rx="2" /><path d="M4 11h16M8 20l-2 2M16 20l2 2M9 19h6" />
                <circle cx="8.5" cy="13.5" r=".6" fill="currentColor" /><circle cx="15.5" cy="13.5" r=".6" fill="currentColor" />
              </svg>
            </span>
            <div class="acc__txt">
              <strong>{a.commune} <span class="acc__cp">{a.codePostal}</span></strong>
              <span class="acc__duree">{a.duree}</span>
              <span class="acc__ligne">{a.ligne}</span>
              {a.note && <span class="acc__note">{a.note}</span>}
            </div>
          </article>
        ))}
      </div>

      <h3 class="acces__h3">Depuis l’arrière-pays et la technopole</h3>
      <div class="acces">
        {parMoyen.bus.map((a) => (
          <article class="acc">
            <span class="acc__ic acc__ic--bus" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="3" width="16" height="14" rx="2" /><path d="M4 10h16M7 21v-2M17 21v-2" />
                <circle cx="8" cy="14" r=".7" fill="currentColor" /><circle cx="16" cy="14" r=".7" fill="currentColor" />
              </svg>
            </span>
            <div class="acc__txt">
              <strong>{a.commune} <span class="acc__cp">{a.codePostal}</span></strong>
              <span class="acc__duree">{a.duree}</span>
              <span class="acc__ligne">{a.ligne}</span>
              {a.note && <span class="acc__note">{a.note}</span>}
            </div>
          </article>
        ))}
      </div>

      <p class="acces__src">
        Durées indicatives, estimées le {estimeLe} d’après les horaires courants
        — elles varient selon l’heure et le jour. Vérifiez les vôtres sur
        <a href={itineraire.train} target="_blank" rel="noopener">TER Sud&nbsp;Provence-Alpes-Côte d’Azur</a>
        ou sur <a href={itineraire.bus} target="_blank" rel="noopener">Lignes d’Azur</a>.
      </p>
    </div>
  </section>

  <!-- ========== NOUS VENONS À VOUS ========== -->
  <section class="section section--sunk" id="chez-vous">
    <div class="wrap">
      <p class="eyebrow">L’inverse est possible</p>
      <h2 class="h-section">Pour un groupe, c’est nous qui venons</h2>
      <p class="lede">
        Une entreprise à Sophia Antipolis, un club à Grasse, une école à
        Menton&nbsp;: dès que vous réunissez un groupe, nous organisons la
        session dans vos locaux, partout dans les Alpes-Maritimes. Vos salariés
        ou vos adhérents ne perdent pas une demi-journée en trajets, et la
        formation se cale sur vos horaires.
      </p>

      <div class="deplacement">
        <article class="dep">
          <strong>Ce qu’il vous faut</strong>
          <p>
            Une salle où l’on peut dégager le sol — on travaille beaucoup au
            sol — et un groupe permettant de constituer une session. Nous
            apportons tout le reste&nbsp;: mannequins adulte, enfant et
            nourrisson, défibrillateurs de formation, matériel de simulation.
          </p>
        </article>
        <article class="dep">
          <strong>Ce que ça change</strong>
          <p>
            Les mises en situation se déroulent dans votre environnement réel,
            avec vos contraintes&nbsp;: vos locaux, vos machines, votre public.
            Un exercice d’évacuation dans votre atelier vaut mieux que le même
            dans une salle neutre.
          </p>
        </article>
        <article class="dep">
          <strong>Ce que ça coûte</strong>
          <p>
            Le tarif dépend du nombre de participants et de la formation
            choisie. Décrivez-nous votre besoin&nbsp;: nous répondons sous
            48&nbsp;heures ouvrées avec une proposition chiffrée.
          </p>
        </article>
      </div>

      <div class="dep__actions">
        <a class="btn btn--primaire" href="/contact?motif=sur-mesure">
          Demander une session dans mes locaux
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn--sobre" href={`tel:${asso.contact.telephoneLien}`}>{asso.contact.telephone}</a>
      </div>
    </div>
  </section>

  <!-- ========== LE LIEU ========== -->
  <section class="section">
    <div class="wrap">
      <Lieu
        titre="Nos locaux, à Nice"
        intro="Toutes les sessions au calendrier s’y déroulent, sauf mention contraire sur votre convocation."
      />
    </div>
  </section>

  <!-- ========== QUELLES FORMATIONS ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Ce que vous pouvez y passer</p>
      <h2 class="h-section">Les formations au calendrier</h2>
      <p class="lede">
        {sessions.length > 0
          ? `${sessions.length} sessions sont programmées, réparties en semaine et le week-end.`
          : 'Le calendrier est mis à jour chaque semaine.'}
      </p>
      <div class="form__l">
        {certifiantes.map((f) => (
          <a class="form__c" href={`/formations/${f.slug}`}>
            <strong>{f.sigle}</strong>
            <span>{f.intitule}</span>
            <em>{f.duree} · {f.tarif}</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== QUI FORME ========== -->
  <section class="section section--navy">
    <div class="wrap">
      <Terrain titre="Qui vous formera" sombre />
    </div>
  </section>

  <!-- ========== QUESTIONS ========== -->
  <section class="section">
    <div class="wrap wrap--etroit">
      <p class="eyebrow">Questions fréquentes</p>
      <h2 class="h-section">Avant de vous déplacer</h2>
      <div class="qs">
        {QUESTIONS.map((q) => (
          <details class="qs__i">
            <summary>{q.question}</summary>
            <p>{q.reponse}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== POSTES DE SECOURS ========== -->
  <section class="section section--sunk">
    <div class="wrap">
      <p class="eyebrow">Et pour vos événements</p>
      <h2 class="h-section">Nous sécurisons aussi vos manifestations</h2>
      <p class="lede">
        Nos équipes tiennent des postes de secours dans tout le département.
        Voici les communes où nous intervenons le plus souvent.
      </p>
      <div class="villes">
        {villes.map((v) => (
          <a class="ville" href={`/postes-de-secours/${v.slug}`}>
            <strong>{v.nom}</strong>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .tete {
    background: linear-gradient(158deg, var(--navy-lift) 0%, var(--navy) 55%, var(--navy-deep) 100%);
    color: var(--on-navy);
    padding-block: clamp(1.5rem, 4vw, 2.25rem) clamp(2.5rem, 5vw, 3.5rem);
  }
  .tete__h1 { font-size: clamp(1.9rem, 5vw, 3rem); font-weight: 800; line-height: 1.06; margin-bottom: .9rem; }
  .tete__t { max-width: 60ch; color: var(--on-navy-text); font-size: clamp(1rem, 2.2vw, 1.12rem); }
  .tete__t strong { color: #fff; font-weight: 700; }
  .tete__t--fin { margin-top: .8rem; font-size: 1rem; color: var(--on-navy-soft); }
  .tete__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.6rem; }

  .acces {
    margin-top: 1.75rem; display: grid; gap: .9rem;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }
  .acc {
    display: flex; gap: .9rem; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 1.1rem 1.25rem;
  }
  .acc__ic {
    flex: none; width: 38px; height: 38px; border-radius: 11px;
    display: grid; place-items: center;
    background: var(--azur-wash); color: var(--azur);
  }
  .acc__ic--bus { background: var(--sage-wash); color: var(--sage); }
  .acc__ic svg { width: 20px; height: 20px; }
  .acc__txt { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
  .acc__txt strong { font-family: 'Archivo', sans-serif; font-size: 1rem; font-weight: 700; }
  .acc__cp { font-weight: 500; color: var(--ink-mute); font-size: .85rem; }
  .acc__duree {
    font-family: 'Archivo', sans-serif; font-size: .95rem; font-weight: 700;
    color: var(--secours); font-variant-numeric: tabular-nums;
  }
  .acc__ligne { font-size: .85rem; color: var(--ink-mute); }
  .acc__note { font-size: .84rem; color: var(--ink-soft); margin-top: .25rem; }

  .acces__h3 {
    font-family: 'Archivo', sans-serif; font-size: 1.1rem; font-weight: 800;
    margin-top: 2.25rem;
  }
  .acces__src { margin-top: 1.5rem; font-size: .85rem; color: var(--ink-mute); max-width: 70ch; }
  .acces__src a { color: var(--azur); font-weight: 600; }

  .deplacement {
    margin-top: 1.75rem; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }
  .dep {
    background: var(--surface); border: 1px solid var(--line);
    border-top: 4px solid var(--secours);
    border-radius: var(--r-lg); padding: 1.4rem;
  }
  .dep strong {
    display: block; font-family: 'Archivo', sans-serif;
    font-size: 1.05rem; font-weight: 800; margin-bottom: .5rem;
  }
  .dep p { color: var(--ink-mute); font-size: .93rem; }
  .dep__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.75rem; }

  .form__l {
    margin-top: 1.75rem; display: grid; gap: .85rem;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
  }
  .form__c {
    display: flex; flex-direction: column; gap: .2rem;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 1.15rem 1.3rem;
    text-decoration: none; color: inherit;
    transition: box-shadow .15s, border-color .15s;
  }
  .form__c:hover { box-shadow: var(--sh-md); border-color: var(--secours); }
  .form__c strong { font-family: 'Archivo', sans-serif; font-size: 1.15rem; font-weight: 800; }
  .form__c span { font-size: .88rem; color: var(--ink-mute); }
  .form__c em { font-style: normal; font-size: .85rem; color: var(--secours); font-weight: 600; margin-top: .3rem; }

  .qs { margin-top: 1.5rem; display: grid; gap: .6rem; }
  .qs__i { background: var(--sunk); border-radius: var(--r-md); padding: 1rem 1.2rem; }
  .qs__i summary {
    cursor: pointer; font-family: 'Archivo', sans-serif;
    font-weight: 700; font-size: 1rem;
  }
  .qs__i p { margin-top: .6rem; color: var(--ink-mute); font-size: .95rem; }

  .villes {
    margin-top: 1.5rem; display: grid; gap: .7rem;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
  }
  .ville {
    display: flex; align-items: center; justify-content: space-between; gap: .6rem;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: .9rem 1.1rem;
    text-decoration: none; color: inherit; font-weight: 600;
    transition: border-color .15s;
  }
  .ville:hover { border-color: var(--secours); }
  .ville svg { width: 15px; height: 15px; color: var(--secours); flex: none; }
</style>
