---
import Base from '../../layouts/Base.astro';
import Equipe from '../../components/Equipe.astro';
import { quizParFormation } from '../../data/quiz-fc';
import ProgressionPse from '../../components/ProgressionPse.astro';
import Terrain from '../../components/Terrain.astro';
import { coursFormation, filAriane } from '../../lib/schema';
import Lieu from '../../components/Lieu.astro';
import HeroFormation from '../../components/HeroFormation.astro';
import ObjectifsProgramme from '../../components/ObjectifsProgramme.astro';
import Sessions from '../../components/Sessions.astro';
import PopupDates from '../../components/PopupDates.astro';
import Pack from '../../components/Pack.astro';
import Temoignages from '../../components/Temoignages.astro';
import ModuleInscription from '../../components/ModuleInscription.astro';
import Documents from '../../components/Documents.astro';
import { formations, type Formation } from '../../data/formations';
import { asso } from '../../data/association';
import { sessionsAVenir, sessionsDe } from '../../lib/wix';

/**
 * Une page par formation, générée depuis src/data/formations.ts.
 * Les sessions viennent de Wix Events, récupérées une fois au build et
 * réparties entre les formations.
 */
export async function getStaticPaths() {
  const toutes = await sessionsAVenir();
  return formations.map((f) => ({
    params: { slug: f.slug },
    // Une formation suspendue n'affiche aucune session, même si des dates
    // subsistent dans Wix : on ne propose pas de réserver ce qu'on n'assure pas.
    props: { formation: f, sessions: f.suspendue || f.datesAVenir ? [] : sessionsDe(toutes, f.wixEvent) },
  }));
}

interface Props { formation: Formation; sessions: any[] }
const { formation: f, sessions } = Astro.props;

const balisages = [
  coursFormation(f, sessions),
  filAriane([
    { nom: 'Accueil', chemin: '/' },
    { nom: 'Formations', chemin: '/formations' },
    { nom: f.sigle, chemin: `/formations/${f.slug}` },
  ]),
];
---

<Base title={f.seo.title} description={f.seo.description} chemin={`/formations/${f.slug}`} filiere={f.filiere} schemas={balisages}>
  <HeroFormation formation={f} nbSessions={sessions.length} />

  {f.datesAVenir?.raison && (
    <div class="wrap">
      <p class="suspendue">
        <span class="suspendue__ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 7v5l3 2" /></svg>
        </span>
        <span><strong>Dates à venir.</strong> {f.datesAVenir.raison}</span>
      </p>
    </div>
  )}

  {f.testEntree && (
    <section class="section" aria-labelledby="t-test">
      <div class="wrap">
        <p class="eyebrow">Avant de vous inscrire</p>
        {/* Même en-tête que « Objectifs visés » : pastille d'accent, taille et
            graisse identiques. Deux titres de même rang doivent se ressembler. */}
        <div class="tnat__tete">
          <span class="tnat__ic" aria-hidden="true">
            {/* Le même tracé que « Modalités d'évaluation » dans le bloc des
                modalités : une case cochée. Le site a déjà son vocabulaire de
                pictogrammes, inutile d'en inventer un. */}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" />
            </svg>
          </span>
          <h2 class="tnat__h" id="t-test">{f.testEntree.titre}</h2>
        </div>

        {/* Les deux chiffres qui décident si l'on est prêt : la distance et le
            temps. Ils passent devant le détail — quelqu'un qui ne tient pas
            100 mètres n'a pas besoin de lire les trois tronçons. */}
        <p class="tnat__cle">
          <b>{f.testEntree.distance}</b> en continu
          <i>·</i>
          <b>{f.testEntree.chrono}</b>
        </p>
        <p class="tnat__i">{f.testEntree.intro}</p>

        {/* Un parcours se lit dans l'ordre : trois tronçons côte à côte, la
            distance en tête. Les numéros seraient redondants — la lecture de
            gauche à droite dit déjà l'enchaînement. */}
        <ol class="tnat__l">
          {f.testEntree.etapes.map((e) => (
            <li class="tnat__e">
              <span class="tnat__d">{e.d}</span>
              <span class="tnat__t">{e.t}</span>
            </li>
          ))}
        </ol>

        <p class="tnat__note">{f.testEntree.note}</p>
      </div>
    </section>
  )}

  {f.suspendue && (
    <div class="wrap">
      <p class="suspendue">
        <span class="suspendue__ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 8v5M12 16h.01" /></svg>
        </span>
        <span><strong>Formation momentanément suspendue.</strong> {f.suspendue.raison}</span>
      </p>
    </div>
  )}

  <ObjectifsProgramme formation={f} />

  {/* Juste après « Et après » : c'est le moment où le lecteur se projette
      dans la suite du parcours, donc celui où l'offre groupée fait sens. */}
  {f.pack && <Pack formation={f} />}

  <section class="section">
    <div class="wrap"><Documents /></div>
  </section>

  {/* Pour un recyclage, le meilleur argument n'est pas un texte : c'est de
      constater soi-même ce qu'on a oublié. */}
  {quizParFormation[f.slug] && (
    <section class="section">
      <div class="wrap">
        <a class="oblig oblig--quiz" href={`/quiz/${f.slug}`}>
          <span class="oblig__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01" /><circle cx="12" cy="12" r="10" /></svg>
          </span>
          <span class="oblig__txt">
            <strong>Vos acquis {f.sigle} sont-ils encore à jour&nbsp;?</strong>
            <span>{quizParFormation[f.slug].length} questions, cinq minutes, corrigé sourcé. Vous verrez vite ce qui s’est émoussé.</span>
          </span>
          <svg class="oblig__f" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </section>
  )}

  {/* La question de celui qui a déjà le PSE1 : qu'est-ce que le PSE2 apporte
      de plus ? Le programme seul ne le montre pas. */}
  {f.slug === 'pse-2' && (
    <section class="section section--sunk">
      <div class="wrap">
        <ProgressionPse />
      </div>
    </section>
  )}

  {/* Le BNSSA change de nom et de prérequis au 1er octobre 2026. Quelqu'un qui
      arrive sur cette fiche a le droit de l'apprendre ici, pas six mois plus
      tard. L'encart passe avant les autres : c'est l'information la plus
      périssable de la page. */}
  {/* Sur une formation continue, la question précède l'inscription : « y
      suis-je obligé, et depuis quand ? ». La réponse a sa page. */}
  {(f.slug.startsWith('fc-') || f.slug === 'mac-sst') && (
    <section class="section">
      <div class="wrap">
        <a class="oblig oblig--choix" href="/validite-recyclage">
          <span class="oblig__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          </span>
          <span class="oblig__txt">
            <strong>Votre diplôme est-il encore valable&nbsp;?</strong>
            <span>Ce qui est obligatoire, ce qui est conseillé, et ce qui se passe si vous avez laissé passer plusieurs années.</span>
          </span>
          <svg class="oblig__f" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </section>
  )}

  {['ssa', 'fc-bnssa', 'bsb', 'fc-bsb', 'pse-2'].includes(f.slug) && (
    <section class="section">
      <div class="wrap">
        <a class="oblig oblig--reforme" href="/bnssa-devient-ssa">
          <span class="oblig__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01" /><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
          </span>
          <span class="oblig__txt">
            <strong>Le BNSSA devient le SSA au 1er octobre 2026</strong>
            <span>
              {f.filiere === 'aquatique'
                ? 'Ce que dit l’arrêté du 29 juillet 2026, et pourquoi le PSE2 devient indispensable.'
                : 'Les titulaires du BNSSA ont désormais besoin du PSE2 pour obtenir l’équivalence SSA.'}
            </span>
          </span>
          <svg class="oblig__f" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </section>
  )}

  {/* Certains arrivent ici sans savoir si le diplôme leur est imposé : on le
      leur dit avant qu'ils ne s'inscrivent, pas après. */}
  {['psc', 'pse-1'].includes(f.slug) && (
    <section class="section">
      <div class="wrap oblig__duo">
        <a class="oblig" href={`/metiers/${f.slug}`}>
          <span class="oblig__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M9 15h6M9 11h6" /></svg>
          </span>
          <span class="oblig__txt">
            <strong>Le {f.sigle} est-il obligatoire dans votre métier&nbsp;?</strong>
            <span>La liste des professions et des diplômes concernés, avec les textes de référence.</span>
          </span>
          <svg class="oblig__f" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>

        <a class="oblig oblig--choix" href="/psc-ou-pse1">
          <span class="oblig__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6H6M18 12H6M18 18H6" /><path d="M3 6h.01M3 12h.01M3 18h.01" /></svg>
          </span>
          <span class="oblig__txt">
            <strong>{f.slug === 'psc' ? 'PSC ou PSE1' : 'PSE1 ou PSC'}&nbsp;: lequel choisir&nbsp;?</strong>
            <span>Durée, tarif, contenu, débouchés : le comparatif, et cinq situations qui tranchent.</span>
          </span>
          <svg class="oblig__f" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </section>
  )}

  <!-- Fond bleu : les témoignages qui suivent sont déjà sur gris, et ce bloc
       porte l'identité de l'association — il mérite d'être appuyé. -->
  <section class="section section--navy">
    <div class="wrap">
      <Terrain titre={`Qui vous formera au ${f.sigle}`} sombre />
    </div>
  </section>

  {/* Des formateurs, et seulement eux : sur cette page le visiteur cherche à
      savoir qui va l'enseigner, pas qui tient les postes de secours. */}
  <section class="section section--sunk">
    <div class="wrap">
      {/* Tous les formateurs, pas un échantillon : le visiteur qui hésite
          veut voir l'équipe entière, et un aperçu de deux laissait croire
          qu'il n'y en avait que deux. */}
      <Equipe
        role="Formateur"
        titre="Vos formateurs"
        intro="Ils enseignent, et ils sont sur le terrain le reste de l'année. Cliquez sur un visage pour lire son parcours."
      />
    </div>
  </section>

  <Temoignages slug={f.slug} sigle={f.sigle} />

  <Sessions sessions={sessions} sigle={f.sigle} />

  {sessions.length > 0 && <PopupDates sessions={sessions} sigle={f.sigle} />}
  {sessions.length > 0 && <ModuleInscription />}

  <section class="section section--sunk">
    <div class="wrap">
      <Lieu
        titre={`Où se déroule le ${f.sigle}`}
        intro="Sauf mention contraire sur votre convocation, la formation a lieu dans nos locaux."
      />
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap wrap--etroit accessibilite">
      <span class="acc__ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" />
        </svg>
      </span>
      <div>
        <h2 class="acc__h">Accessibilité et handicap</h2>
        <p class="lede">{asso.accessibilite}</p>
        <a class="btn btn--fantome acc__btn" href="/contact">Nous exposer votre situation</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tnat__tete { display: flex; align-items: center; gap: .85rem; margin-bottom: 1.1rem; }
  .tnat__ic {
    width: 42px; height: 42px; border-radius: 12px; flex: none;
    display: grid; place-items: center;
    background: var(--accent-plein); color: var(--accent-encre);
  }
  .tnat__ic svg { width: 21px; height: 21px; }
  .tnat__h { font-size: clamp(1.5rem, 3.4vw, 1.95rem); font-weight: 700; margin: 0; }

  .tnat__cle {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem;
    margin: .2rem 0 1rem; font-size: 1.05rem; color: var(--ink-soft);
  }
  .tnat__cle b { font-size: 1.6rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .tnat__cle i { font-style: normal; color: var(--line); }
  .tnat__i { margin: 0 0 1.5rem; color: var(--ink-soft); max-width: 53ch; }

  .tnat__l {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: .8rem;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    counter-reset: none;
  }
  /* Même habillage que les cartes d'objectifs, quelques centimètres plus haut
     sur la page : fond gris, filet clair, mêmes rayons et rembourrage. */
  .tnat__e {
    display: grid; gap: .3rem; align-content: start;
    padding: 1.05rem 1.2rem;
    background: var(--sunk);
    border: 1px solid var(--line); border-radius: var(--r-md);
  }
  .tnat__d {
    font-family: 'Archivo', sans-serif; font-size: 1.5rem; font-weight: 800;
    line-height: 1.05; color: var(--ink); font-variant-numeric: tabular-nums;
  }
  .tnat__t { font-size: .93rem; color: var(--ink-soft); }
  .tnat__note { margin: 1.4rem 0 0; font-size: .93rem; color: var(--ink-mute); max-width: 70ch; }

  .suspendue {
    margin-top: 2.25rem;
    display: flex; gap: .9rem; align-items: flex-start;
    background: var(--gold-wash);
    border: 1px solid color-mix(in srgb, var(--gold) 38%, transparent);
    border-radius: var(--r-md);
    padding: 1.1rem 1.25rem;
    font-size: .93rem; color: var(--ink-soft);
    max-width: 78ch;
  }
  .suspendue strong { color: var(--ink); }
  .suspendue__ic { flex: none; width: 22px; height: 22px; color: var(--gold); }
  .suspendue__ic svg { width: 100%; height: 100%; }


  .accessibilite { display: flex; gap: 1.25rem; align-items: flex-start; }
  .acc__ic {
    flex: none; width: 44px; height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    display: grid; place-items: center;
  }
  .acc__ic svg { width: 22px; height: 22px; }
  .acc__h { font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem; }
  .acc__btn { margin-top: 1.25rem; }
  @media (max-width: 620px) { .accessibilite { flex-direction: column; } }

  .oblig__duo {
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
  }
  /*
   * Les variantes portent « .oblig » en plus : écrites avant la règle de base,
   * elles perdaient contre elle à spécificité égale, et le fond bleu pâle de
   * base revenait. L'encart du quiz affichait alors du texte blanc et une
   * icône blanchie sur ce bleu pâle — illisibles (signalé sur la FC PSC).
   */
  .oblig.oblig--choix {
    background: var(--sunk); border-color: var(--line);
  }
  /* L'encart de réforme se distingue : ce n'est pas une suggestion de lecture,
     c'est une échéance. */
  .oblig.oblig--reforme {
    background: var(--secours-wash);
    border-color: color-mix(in srgb, var(--secours) 30%, transparent);
  }
  .oblig--reforme .oblig__ic { background: var(--secours); color: #fff; }
  .oblig--reforme .oblig__f { color: var(--secours); }
  .oblig.oblig--quiz {
    background: var(--secours); border-color: var(--secours); color: #fff;
  }
  .oblig--quiz .oblig__ic { background: rgba(255,255,255,.2); }
  .oblig--quiz .oblig__txt span { color: rgba(255,255,255,.92); }
  .oblig--quiz .oblig__f { color: #fff; }
  .oblig--choix .oblig__ic { background: var(--accent-plein); color: var(--accent-encre); }
  .oblig--choix .oblig__f { color: var(--accent); }

  .oblig {
    display: flex; align-items: center; gap: 1rem;
    background: var(--azur-wash); border: 1px solid var(--azur);
    border-radius: var(--r-lg); padding: 1.2rem 1.4rem;
    text-decoration: none; color: inherit;
    transition: box-shadow .15s;
  }
  .oblig:hover { box-shadow: var(--sh-md); }
  .oblig__ic {
    flex: none; width: 44px; height: 44px; border-radius: 13px;
    background: var(--azur); color: #fff; display: grid; place-items: center;
  }
  .oblig__ic svg { width: 22px; height: 22px; }
  .oblig__txt { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .oblig__txt strong { font-family: 'Archivo', sans-serif; font-size: 1rem; font-weight: 700; }
  .oblig__txt span { font-size: .89rem; color: var(--ink-soft); }
  .oblig__f { flex: none; width: 19px; height: 19px; margin-left: auto; color: var(--azur); }
</style>
