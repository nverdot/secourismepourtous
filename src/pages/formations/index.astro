---
import Base from '../../layouts/Base.astro';
import { quizParFormation } from '../../data/quiz-fc';
import { parSlug } from '../../data/formations';
import Terrain from '../../components/Terrain.astro';
import Faq from '../../components/Faq.astro';
import { faqFormations } from '../../data/faq';
import { questionsFrequentes } from '../../lib/schema';
import { asso } from '../../data/association';
import { filAriane } from '../../lib/schema';
import { formations, filieres, type Filiere } from '../../data/formations';
import { sessionsAVenir, sessionsDe } from '../../lib/wix';
import Indicateurs from '../../components/Indicateurs.astro';
import CartesFilieres from '../../components/CartesFilieres.astro';
import Documents from '../../components/Documents.astro';

const toutes = await sessionsAVenir();

const ordre: Filiere[] = ['citoyenne', 'operationnelle', 'aquatique', 'entreprise', 'pedagogique'];
const groupes = ordre
  .map((cle) => ({
    cle,
    ...filieres[cle],
    items: formations
      .filter((f) => f.filiere === cle)
      .map((f) => ({ f, nb: sessionsDe(toutes, f.wixEvent).length })),
  }))
  .filter((g) => g.items.length > 0);

/*
 * Le catalogue de l'application (téléphone), rangé par filière : chaque
 * filière se déplie sur place et montre ses formations — initiales d'abord,
 * recyclages ensuite — avec durée, prix et dates ouvertes.
 */
const aDates = (f: (typeof formations)[number]) =>
  f.suspendue || f.datesAVenir ? 0 : sessionsDe(toutes, f.wixEvent).length;
const catalogue = ordre
  .map((cle) => ({
    cle,
    ...filieres[cle],
    items: [
      ...formations.filter((f) => f.filiere === cle && !f.estRecyclage),
      ...formations.filter((f) => f.filiere === cle && f.estRecyclage),
    ].map((f) => ({ f, nb: aDates(f) })),
  }))
  .filter((g) => g.items.length > 0);
const total = catalogue.reduce((n, g) => n + g.items.length, 0);

/* Les pictogrammes des filières, les mêmes que dans le menu. */
const PICTO: Record<string, string> = {
  coeur: 'M3 12h4l2-6 4 12 2-6h6',
  ambulance: 'M2 7.5A1.5 1.5 0 0 1 3.5 6h9A1.5 1.5 0 0 1 14 7.5V17H2zM14 10h3.6a2 2 0 0 1 1.6.8l2.2 2.9a2 2 0 0 1 .4 1.2V17h-8zM6 9.5v4M4 11.5h4',
  nage: 'M3 6c2-1.6 3.2-1.6 5.2 0s3.2 1.6 5.2 0 3.2-1.6 5.2 0M3 12c2-1.6 3.2-1.6 5.2 0s3.2 1.6 5.2 0 3.2-1.6 5.2 0M3 18c2-1.6 3.2-1.6 5.2 0s3.2 1.6 5.2 0 3.2-1.6 5.2 0',
  pedagogie: 'M22 10v6M2 10l10-5 10 5-10 5zM6 12v5c3 3 9 3 12 0v-5',
  mallette: 'M2 7h20v14H2zM16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16',
};
---

<Base
  title="Formations secourisme à Nice | PSC, PSE, BNSSA, SST"
  description="Toutes nos formations de secourisme à Nice et dans le 06 : PSC, PSE1, PSE2, SSA, SST et formations de formateur. Prix, dates et inscription en ligne."
  chemin="/formations"
  schemas={[
    filAriane([
      { nom: 'Accueil', chemin: '/' },
      { nom: 'Formations', chemin: '/formations' },
    ]),
    questionsFrequentes(faqFormations),
  ]}
>
  <header class="tete">
    <div class="wrap">
      <nav class="fil" aria-label="Fil d'ariane">
        <a href="/">Accueil</a><i aria-hidden="true">›</i><b>Formations</b>
      </nav>
      <div class="tete__grille">
        <div>
          <h1 class="tete__h1">Nos formations</h1>
          <p class="tete__t">
            Cinq filières, du grand public au professionnel. Toutes nos formations sont
            dispensées par des formateurs diplômés, dans le cadre de notre certification
            Qualiopi et de notre agrément FFSS.
          </p>
        </div>

        <div class="tete__cartes">
        <!-- Le catalogue complet, à portée de clic pour qui veut tout comparer
             hors ligne ou le transmettre à un employeur. -->
        <a class="cata" href="/documents/catalogue-formations.pdf" target="_blank" rel="noopener">
          <span class="cata__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <path d="M14 2v6h6M12 18v-6M9 15l3 3 3-3" />
            </svg>
          </span>
          <span class="cata__txt">
            <strong>Télécharger notre catalogue</strong>
            <em>Toutes les formations, durées et tarifs — PDF</em>
          </span>
        </a>

        <!-- Beaucoup de visiteurs sont déjà diplômés et viennent vérifier une
             date de recyclage. Le quiz leur montre pourquoi elle compte. -->
        <a class="cata cata--test" href="#acquis">
          <span class="cata__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11l3 3 7-7" />
              <path d="M21 12v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10" />
            </svg>
          </span>
          <span class="cata__txt">
            <strong>Vos acquis sont-ils à jour&nbsp;?</strong>
            <em>Quiz FC PSC, PSE1, PSE2 — 5 minutes</em>
          </span>
        </a>
        </div>
      </div>
  </header>


  <CartesFilieres />

  {/*
    ============ CATALOGUE DE L'APPLICATION (téléphone) ============
    Les filières en couleur, les mêmes que sur l'accueil ; chacune se déplie
    sur place et liste ses formations — sigle, durée, âge ou prérequis, prix,
    dates ouvertes — avec la fiche au toucher. Une seule entrée, là où il y
    avait les cartes de filières puis une liste complète qui les répétait.
    Absent sur ordinateur, où les grandes cartes de filières suffisent.
  */}
  <section class="cat" aria-labelledby="t-cat">
    <h2 class="cat__h" id="t-cat">Quelle formation est faite pour vous&nbsp;?</h2>
    <p class="cat__sous">{total} formations en {catalogue.length} filières. Touchez une filière pour voir ses formations.</p>

    {/* <details> natifs : ils s'ouvrent sans script, se lisent au clavier et
        au lecteur d'écran, et leur contenu reste dans la page pour Google.
        « name » commun : ouvrir une filière referme la précédente. */}
    <div class="catg-l">
      {catalogue.map((g) => (
        <details class={`catg catg--${g.couleur}`} name="filiere">
          <summary>
            <span class="catg__ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={PICTO[g.icone]} /></svg>
            </span>
            <span class="catg__txt">
              <strong>{g.titre}</strong>
              <span>{g.jeSuis}</span>
            </span>
            <span class="catg__nb">{g.items.length}</span>
            <svg class="catg__chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </summary>
          <ul class="cat__l">
            {g.items.map(({ f, nb }) => (
              <li>
                <a class={`cat__i cat__i--${g.couleur}`} href={`/formations/${f.slug}`}>
                  <span class="cat__txt">
                    <strong>{f.sigle}</strong>
                    <span class="cat__nom">{f.intitule.split(' — ')[0]}</span>
                    <span class="cat__meta">{f.duree} · {f.prerequis} · {f.tarif}</span>
                  </span>
                  {nb > 0
                    ? <span class="cat__dates">{nb} date{nb > 1 ? 's' : ''}</span>
                    : (f.suspendue || f.datesAVenir) && <span class="cat__dates cat__dates--attente">À venir</span>}
                  <svg class="cat__chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>

    <div class="cat__aide">
      <strong>Vous hésitez entre le PSC et le PSE1&nbsp;?</strong>
      <p>Quelques questions suffisent pour trouver le bon niveau.</p>
      <div class="cat__aide-b">
        <button type="button" class="cat__aide-btn" data-compagnon>Être orienté</button>
        <a class="cat__aide-lien" href="/psc-ou-pse1">Comparer PSC et PSE1</a>
      </div>
    </div>

    <a class="cat__pdf" href="/documents/catalogue-formations.pdf" target="_blank" rel="noopener">
      Télécharger le catalogue complet (PDF)
    </a>
  </section>


  {/* Un titulaire dont le recyclage approche n'a pas besoin qu'on lui vante
      la formation : il a besoin de constater lui-même ce qu'il a oublié. */}
  <section class="section section--sunk" id="acquis">
    <div class="wrap">
      <p class="eyebrow">Déjà diplômé</p>
      <h2 class="h-section">Vos acquis sont-ils encore à jour&nbsp;?</h2>
      <p class="lede">
        Les gestes se perdent sans pratique, et les recommandations évoluent.
        Cinq minutes suffisent pour le vérifier, avec un corrigé sourcé sur les
        référentiels en vigueur.
      </p>
      <div class="tests">
        {Object.keys(quizParFormation).map((slug) => {
          const fc = parSlug(slug)!;
          return (
            <a class={`test test--${filieres[fc.filiere].couleur}`} href={`/quiz/${slug}`}>
              {/* Pastille propre au téléphone, où la carte devient une ligne. */}
              <span class="test__ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01" /><circle cx="12" cy="12" r="10" /></svg>
              </span>
              <span class="test__e">{quizParFormation[slug].length} questions</span>
              <strong>Quiz {fc.sigle}</strong>
              <span class="test__x">{fc.intitule}</span>
              <span class="test__f" aria-hidden="true">
                Tester mes acquis
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          );
        })}
      </div>
      <p class="tests__n">
        Jamais formé&nbsp;? Le
        <a href="/gestes-qui-sauvent/quiz">questionnaire grand public</a>
        vous dira où vous en êtes. Vous venez de loin&nbsp;?
        <a href="/ou-se-former">Voir les accès depuis votre commune</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Par métier</p>
      <h2 class="h-section">Votre profession l’exige-t-elle&nbsp;?</h2>
      <p class="lede">
        Enseignement, petite enfance, sport, sauvetage aquatique, plongée&nbsp;:
        de nombreux diplômes imposent une formation aux premiers secours.
        Vérifiez si le vôtre en fait partie.
      </p>
      <div class="voies">
        <a class="voie voie--azur" href="/metiers/psc">
          <span class="voie__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg></span>
          <strong>Les métiers qui exigent le PSC</strong>
          <span>Professeur des écoles, assistant maternel, éducateur sportif, agent de sécurité…</span>
        </a>
        <a class="voie" href="/metiers/pse-1">
          <span class="voie__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg></span>
          <strong>Les métiers qui exigent le PSE1</strong>
          <span>BNSSA, maître-nageur, moniteur de plongée, équipier secouriste…</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap"><Terrain /></div>
  </section>

  <Indicateurs />

  <section class="section">
    <div class="wrap">
      <Faq
        titre="Vos questions avant de vous inscrire"
        intro="Le choix de la formation, le financement, la validité du diplôme : ce qu'on nous demande le plus souvent."
        questions={faqFormations}
      />
    </div>
  </section>

  <!-- ========== ACCESSIBILITÉ ========== -->
  <section class="section section--navy">
    <div class="wrap wrap--etroit acc">
      <span class="acc__ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" /></svg>
      </span>
      <div>
        <h2 class="acc__h">Accessibilité et inclusion</h2>
        <p class="lede">{asso.accessibilite}</p>
        <a class="btn btn--fantome acc__btn" href="/contact">Nous exposer votre situation</a>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap"><Documents /></div>
  </section>

</Base>


<script>
  const cat = document.querySelector<HTMLElement>('.cat');
  if (cat) {
    cat.querySelector('[data-compagnon]')?.addEventListener('click', () => (window as any).Compagnon?.ouvrir());
  }
</script>

<style>
  .tete {
    background: linear-gradient(158deg, var(--navy-lift) 0%, var(--navy) 55%, var(--navy-deep) 100%);
    color: var(--on-navy);
    padding-block: clamp(1.5rem, 4vw, 2.25rem) clamp(2.5rem, 6vw, 4rem);
  }

  .tete__h1 { font-size: clamp(2.2rem, 6vw, 3.4rem); font-weight: 800; margin-bottom: 0.85rem; }
  .tete__t { max-width: 60ch; color: var(--on-navy-text); }

  .tete__grille {
    display: grid; gap: clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: minmax(0, 1fr) minmax(min(300px, 100%), 22rem);
    align-items: center;
  }
  @media (max-width: 900px) { .tete__grille { grid-template-columns: 1fr; } }

  .tete__cartes { display: grid; gap: .75rem; }
  #acquis { scroll-margin-top: 5rem; }

  .cata {
    display: flex; align-items: center; gap: .9rem;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.2);
    border-radius: var(--r-lg); padding: 1.05rem 1.2rem;
    color: #fff; text-decoration: none;
    transition: background-color .15s, border-color .15s;
  }
  .cata:hover { background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.4); }
  .cata__ic {
    flex: none; width: 42px; height: 42px; border-radius: 12px;
    background: var(--secours); color: #fff; display: grid; place-items: center;
  }
  .cata--test .cata__ic { background: var(--azur); }
  .cata__ic svg { width: 21px; height: 21px; }
  .cata__txt { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
  .cata__txt strong { font-family: 'Archivo', sans-serif; font-size: .98rem; font-weight: 700; }
  .cata__txt em { font-style: normal; font-size: .82rem; color: var(--on-navy-soft); }

  .groupe { margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .groupe:last-child { margin-bottom: 0; }
  .groupe__tete { margin-bottom: 1.5rem; }
  .groupe__h {
    font-size: clamp(1.4rem, 3.2vw, 1.8rem);
    font-weight: 700;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--line);
    margin-bottom: 0.6rem;
  }
  .groupe__t { color: var(--ink-soft); font-size: 0.95rem; }

  .cartes {
    display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
  .carte {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .carte:hover { transform: translateY(-3px); box-shadow: var(--sh-md); border-color: var(--azur); }
  .carte__lien {
    display: flex; flex-direction: column; height: 100%;
    padding: clamp(1.35rem, 3vw, 1.65rem);
    text-decoration: none; color: inherit;
  }

  .carte__haut { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.6rem; }
  .carte__sigle {
    font-family: 'Archivo', sans-serif;
    font-size: 1.75rem; font-weight: 800;
    letter-spacing: -0.03em; color: var(--navy);
  }
  .carte__dispo {
    margin-left: auto;
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--sage-wash); color: var(--sage);
    border-radius: var(--r-pill);
    padding: 0.25rem 0.7rem;
  }

  .carte__h { font-size: 1rem; font-weight: 700; margin-bottom: 0.4rem; }
  .carte__r { font-size: 0.92rem; color: var(--ink-soft); margin-bottom: 1.1rem; }

  .carte__meta {
    margin: 0 0 1.15rem;
    display: grid; gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .carte__meta > div { display: flex; justify-content: space-between; gap: 1rem; }
  .carte__meta dt { font-size: 0.82rem; color: var(--ink-mute); }
  .carte__meta dd { margin: 0; font-size: 0.86rem; font-weight: 600; text-align: right; }
  .carte__tarif { color: var(--secours); }

  .carte__cta {
    margin-top: auto;
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: 'Archivo', sans-serif;
    font-weight: 700; font-size: 0.9rem;
    color: var(--secours);
  }
  .carte__cta svg { width: 16px; height: 16px; }
  .carte:hover .carte__cta { text-decoration: underline; text-underline-offset: 3px; }

  /* Accessibilité : bloc repris de la page association, il a davantage sa
     place ici — c'est au moment de choisir sa formation qu'on se demande si
     elle nous est accessible. */
  .acc { display: flex; gap: 1.25rem; align-items: flex-start; }
  .acc__ic {
    flex: none; width: 44px; height: 44px; border-radius: 12px;
    background: rgba(255,255,255,.1); color: #fff; display: grid; place-items: center;
  }
  .acc__ic svg { width: 22px; height: 22px; }
  .acc__h { font-size: 1.4rem; font-weight: 700; margin-bottom: .5rem; }
  .acc__btn { margin-top: 1.25rem; }
  @media (max-width: 620px) { .acc { flex-direction: column; } }

  .voies {
    margin-top: 2rem; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }
  .voie {
    display: flex; flex-direction: column; gap: .35rem;
    background: var(--surface); border: 1px solid var(--line);
    border-left: 4px solid var(--secours);
    border-radius: var(--r-lg); padding: 1.25rem 1.4rem;
    text-decoration: none; color: inherit;
    transition: box-shadow .15s, border-color .15s;
  }
  .voie:hover { box-shadow: var(--sh-md); border-color: var(--secours); }
  .voie strong { font-family: 'Archivo', sans-serif; font-size: 1.02rem; font-weight: 700; }
  .voie span { font-size: .89rem; color: var(--ink-mute); }
  .voie__ic { display: none; }

  /* Téléphone : les deux listes de métiers en lignes d'application —
     pastille à la couleur de la formation, titre, métiers en une ligne. */
  @media (max-width: 720px) {
    .voies { gap: 0.55rem; margin-top: 0.9rem; }
    .voie {
      --c: var(--secours);
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr) auto;
      grid-template-areas: 'ic t f' 'ic x f';
      align-items: center;
      column-gap: 0.75rem;
      row-gap: 0.1rem;
      padding: 0.75rem 0.85rem;
      border: 1px solid var(--line);
      border-radius: 16px;
    }
    .voie--azur { --c: var(--azur); }
    /* « .voie » en tête : la règle « .voie span » grisait sinon la pastille. */
    .voie .voie__ic {
      grid-area: ic;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--c);
      color: #fff;
    }
    .voie__ic svg { width: 21px; height: 21px; }
    .voie strong { grid-area: t; font-size: 0.95rem; line-height: 1.25; }
    .voie > span:not(.voie__ic) {
      grid-area: x;
      overflow: hidden;
      font-size: 0.8rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* La flèche des lignes d'application. */
    .voie::after { grid-area: f; color: var(--ink-mute); font-size: 1.5rem; line-height: 1; content: '›'; }
  }

  .tests {
    margin-top: 2rem; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  }
  .test {
    display: flex; flex-direction: column; gap: .35rem;
    background: var(--surface); border: 1px solid var(--line);
    border-top: 4px solid var(--secours);
    border-radius: var(--r-lg); padding: 1.25rem 1.4rem;
    text-decoration: none; color: inherit;
    transition: box-shadow .15s, border-color .15s;
  }
  .test:hover { box-shadow: var(--sh-md); border-color: var(--secours); }
  .test__e {
    font-family: 'Archivo', sans-serif; font-size: .68rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--secours);
  }
  .test strong { font-family: 'Archivo', sans-serif; font-size: 1.1rem; font-weight: 800; }
  .test__x { font-size: .88rem; color: var(--ink-mute); }
  .test__f {
